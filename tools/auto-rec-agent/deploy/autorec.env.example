# /etc/autorec/autorec.env -- root:root 0600, read only by systemd for
# autorec-gateway@.service. Never copy it into the autorec account.
#
# The app origin, https only, no path (for example https://tomverse.app).
AUTOREC_APP_URL=
# The shared secret the app's recommendation routes check (bearer token).
AUTOREC_APP_SECRET=
# Fine-grained GitHub token: repository mposition/Tomverse only,
# Contents read and write, Pull requests read and write. Nothing else.
AUTOREC_GITHUB_TOKEN=
