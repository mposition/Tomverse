[Unit]
Description=CI auto-fix: propose a patch for a failed agent pull request (one pass)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
# The account whose Claude CLI is signed in to the subscription, as for the
# review daemon. It holds a read-only GitHub token and no dispatch token.
User=review
Environment=REVIEW_ORCH_CONFIG=/etc/review-orchestrator/config.json
Environment=PATH=/home/review/.local/bin:/usr/local/bin:/usr/bin:/bin
# Read by systemd as root (root-owned, mode 600): PR_CI_AUTO_FIX_READ_TOKEN,
# a token with Actions read and Pull requests read only.
EnvironmentFile=/etc/pr-ci-auto-fix/read.env
Environment=PR_CI_AUTO_FIX_REPO=mposition/Tomverse
Environment=PR_CI_AUTO_FIX_OUTBOX=/var/lib/pr-ci-auto-fix/outbox
# Outbox files must be readable by the sender's own account.
UMask=0022
ExecStart=/usr/bin/node /opt/review-orchestrator/tools/review-orchestrator/bin/pr-ci-auto-fix.mjs
# The model's own timeout is the provider's timeoutSeconds (default 40 minutes).
TimeoutStartSec=50min
KillMode=control-group
