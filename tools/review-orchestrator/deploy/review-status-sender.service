[Unit]
Description=Independent review server status sender (Tomverse Agent office)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Its own transient account, never the review account: every reviewer CLI runs
# as review and could be asked by the change under review to print a file or
# a process environment that account can read. This one holds the secret.
DynamicUser=yes
# Read by systemd as root (keep the file root-owned, mode 600), so the value
# reaches only this service's environment.
EnvironmentFile=/etc/review-status/secret.env
Environment=REVIEW_STATUS_URL=https://tomverse.app/api/internal/review-orchestrator/status
# The daemon's `statusSnapshot.dir` plus /snapshot.json.
Environment=REVIEW_STATUS_SNAPSHOT=/var/lib/review-status/snapshot.json
# The checkout sits under the review account's home, which this account cannot
# traverse; the code is mapped in read-only instead.
BindReadOnlyPaths=/home/review/review-orchestrator/tools/review-orchestrator:/opt/review-status-sender
ExecStart=/usr/bin/node /opt/review-status-sender/bin/review-status-sender.mjs
Restart=on-failure
RestartSec=30
# 64 = the settings cannot run; restarting would not change them.
RestartPreventExitStatus=64
NoNewPrivileges=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
LockPersonality=yes

[Install]
WantedBy=multi-user.target
