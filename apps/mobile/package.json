{
  "name": "@tomverse/mobile",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Locally bundled Capacitor shell with default-off native text chat and foreground location.",
  "scripts": {
    "build": "vite build",
    "dev": "vite",
    "preview": "vite preview",
    "typecheck": "tsc --project tsconfig.json",
    "cap:sync": "cap sync",
    "capacitor:sync:after": "node scripts/configure-location-permissions.mjs && node scripts/configure-auth-app-links.mjs"
  },
  "dependencies": {
    "@capacitor/app": "^8.1.2",
    "@capacitor/browser": "^8.0.5",
    "@capacitor/core": "^8.5.2",
    "@capacitor/geolocation": "^8.2.4",
    "@tomverse/mobile-auth": "file:native-auth",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/cli": "^8.5.2",
    "@capacitor/ios": "^8.5.2"
  }
}
