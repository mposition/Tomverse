{
  "name": "@tomverse/desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/host/main.cjs",
  "scripts": {
    "build": "vite build && node scripts/build-host.mjs",
    "typecheck": "tsc --noEmit",
    "start": "electron .",
    "package": "vite build && node scripts/build-host.mjs --packaged && node scripts/package.mjs",
    "package:msix": "node scripts/package-msix.mjs",
    "package:native": "node scripts/package-native.mjs",
    "pack:verify": "node scripts/run-on-test-desktop.mjs scripts/verify-package.mjs",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:packaged-tasks": "vite build && node scripts/build-host.mjs --packaged-task-qa && node scripts/test-packaged-tasks.mjs",
    "test:e2e": "node scripts/run-on-test-desktop.mjs --import tsx --test --test-concurrency=1 tests/*.e2e.ts"
  },
  "dependencies": {
    "@tomverse/chat-ui": "*",
    "@tomverse/ui-tokens": "*",
    "lucide-react": "^1.75.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@electron/asar": "4.3.2",
    "@electron/fuses": "2.1.3",
    "@electron/packager": "20.3.0",
    "electron": "45.4.1",
    "resedit": "2.0.3"
  }
}
