+    (error) => {
+      assert.ok(error instanceof ChatAttemptIdentityConflictError, String(error));
+      assert.equal(error.code, "CHAT_ATTEMPT_ID_REUSED");
+      return true;
+    }
+  );
+  assert.equal(await prisma.chatResponseAttempt.count({ where: { assistantMessageId } }), 1);
+});
