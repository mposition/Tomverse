+  const final = runPromptRefinerShadowHarness({
+    corpus,
+    journalPath: path,
+    resume: true,
+  });
+  assert.equal(final.status, "completed");
+  assert.equal(final.processedCases, 16);
+  assert.equal(final.providerCalls, 0);
