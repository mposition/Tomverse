+    maximum: number,
+    io: PromptRefinerShadowIO
+): string {
+    if (io.lstatSync(path).isSymbolicLink()) fail("symlink");
+    const descriptor = io.openSync(path, "r");
+    try {
+        const stat = io.fstatSync(descriptor);
+        if (!stat.isFile() || stat.size > maximum) fail("file_size_or_type");
