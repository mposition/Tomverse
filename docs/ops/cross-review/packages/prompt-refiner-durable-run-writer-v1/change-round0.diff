+export type PromptRefinerShadowRunSourceManifest = Readonly<{
+    schemaVersion: typeof PROMPT_REFINER_SHADOW_RUN_SOURCE_MANIFEST_VERSION;
+    commitSha: string;
+    totalSizeBytes: number;
+    files: readonly Readonly<{
