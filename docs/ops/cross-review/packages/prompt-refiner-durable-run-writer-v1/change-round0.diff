+CREATE TRIGGER "prompt_refiner_shadow_run_insert_guard_trigger"
+BEFORE INSERT ON "PromptRefinerShadowRun"
+FOR EACH ROW EXECUTE FUNCTION "prompt_refiner_shadow_run_insert_guard"();
