+    if (options.has(match[1])) throw new Error("collector_duplicate_argument");
+    if (valueFlags.includes(match[1]) ? !match[2] : match[2] !== undefined) throw new Error("collector_argument_value");
+    options.set(match[1], match[2] ?? true);
+  }
