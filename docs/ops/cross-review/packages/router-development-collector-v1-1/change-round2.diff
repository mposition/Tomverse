+  const overrun = [...attempts.values()].some((attempt) => attempt.terminal?.tokenUsageAtFrozenRatesMicroUsd !== null && (attempt.terminal?.tokenUsageAtFrozenRatesMicroUsd ?? 0) > attempt.intent.reservedMicroUsd);
