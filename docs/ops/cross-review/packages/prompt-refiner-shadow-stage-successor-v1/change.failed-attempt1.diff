+-- Admit a successor Prompt Refiner stage/run after the first v2 stage was
+-- durably bound before its required feature flags were enabled. The v2 row is
+-- preserved unchanged as audit evidence. This migration seeds no approval,
+-- performs no provider call and cannot expose the Refiner to product traffic.
+
+ALTER FUNCTION "prompt_refiner_runtime_manifest_valid"(JSONB, TEXT, TEXT, TEXT)
+    RENAME TO "prompt_refiner_runtime_manifest_v3_valid";
+
+-- Runtime manifest v4 is the reviewed v3 closure plus this migration at the
+-- exact ordered position. Legacy v2/v3 manifests continue through the prior
+-- validator; the successor row must use the 189-file v4 closure.
+CREATE FUNCTION "prompt_refiner_runtime_manifest_valid"(
+    manifest JSONB,
+    commit_sha TEXT,
+    source_identity_digest TEXT,
+    manifest_digest TEXT
+)
+RETURNS BOOLEAN
+LANGUAGE plpgsql
+IMMUTABLE
+STRICT
+PARALLEL SAFE
+AS $$
+DECLARE
+    files JSONB;
+    added JSONB;
+    legacy_files JSONB;
+    legacy_manifest JSONB;
+BEGIN
+    IF manifest->>'schemaVersion' IN (
+        'prompt-refiner-runtime-source-manifest-v2',
+        'prompt-refiner-runtime-source-manifest-v3'
+    ) THEN
+        RETURN "prompt_refiner_runtime_manifest_v3_valid"(
+            manifest, commit_sha, source_identity_digest, manifest_digest
+        );
+    END IF;
+    IF manifest->>'schemaVersion' <> 'prompt-refiner-runtime-source-manifest-v4'
+       OR jsonb_typeof(manifest) <> 'object'
+       OR manifest <> jsonb_build_object(
+            'schemaVersion', manifest->'schemaVersion',
+            'commitSha', manifest->'commitSha',
+            'totalSizeBytes', manifest->'totalSizeBytes',
+            'files', manifest->'files'
+       )
+       OR manifest->>'commitSha' <> commit_sha
+       OR commit_sha !~ '^[a-f0-9]{40}$'
+       OR jsonb_typeof(manifest->'files') <> 'array'
+       OR jsonb_array_length(manifest->'files') <> 189
+       OR jsonb_typeof(manifest->'totalSizeBytes') <> 'number'
+       OR manifest->>'totalSizeBytes' !~ '^[1-9][0-9]*$'
+       OR (manifest->>'totalSizeBytes')::NUMERIC > 16777216
+       OR source_identity_digest <> "prompt_refiner_sha256_json"(
+            jsonb_build_object('files', manifest->'files')
+       )
+       OR manifest_digest <> "prompt_refiner_sha256_json"(manifest) THEN
+        RETURN FALSE;
+    END IF;
+    files := manifest->'files';
+    added := files->7;
+    IF added <> jsonb_build_object(
+            'path', 'prisma/migrations/20260927130000_prompt_refiner_shadow_stage_successor_v3/migration.sql',
+            'sizeBytes', added->'sizeBytes',
+            'sha256', added->'sha256'
+       )
+       OR jsonb_typeof(added->'sizeBytes') <> 'number'
+       OR added->>'sizeBytes' !~ '^[1-9][0-9]*$'
+       OR (added->>'sizeBytes')::NUMERIC > 8388608
+       OR jsonb_typeof(added->'sha256') <> 'string'
+       OR added->>'sha256' !~ '^[a-f0-9]{64}$' THEN
+        RETURN FALSE;
+    END IF;
+    SELECT jsonb_agg(value ORDER BY ordinal)
+    INTO legacy_files
+    FROM jsonb_array_elements(files) WITH ORDINALITY AS entry(value, ordinal)
+    WHERE ordinal <> 8;
+    legacy_manifest := jsonb_build_object(
+        'schemaVersion', 'prompt-refiner-runtime-source-manifest-v3',
+        'commitSha', commit_sha,
+        'totalSizeBytes',
+            (manifest->>'totalSizeBytes')::NUMERIC - (added->>'sizeBytes')::NUMERIC,
+        'files', legacy_files
+    );
+    RETURN "prompt_refiner_runtime_manifest_v3_valid"(
+        legacy_manifest,
+        commit_sha,
+        "prompt_refiner_sha256_json"(jsonb_build_object('files', legacy_files)),
+        "prompt_refiner_sha256_json"(legacy_manifest)
+    );
+EXCEPTION WHEN OTHERS THEN
+    RETURN FALSE;
+END;
+$$;
