# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/playwright-report/
/playwright-report-admin/
/test-results/
/test-results-admin/
/blob-report/
# Sandbox-only Playwright browser-executable override; never a real fix.
playwright.local-sandbox.config.ts

# Default-model eval output (scripts/evalDefaultModel.mjs --json).
# Real, billed provider responses -- large, and evidence of one run rather than
# source. Retain the files with the decision record and summarise the manifest
# in .github/audits/, per docs/policy/default-model-luna-migration.md 4.5.1.
/artifacts/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/app/generated/prisma
/lib/generated
.vs
.local-backups/aihub-clone.dump
# Local scratch docs stay out of the repo, but the UI contracts under
# docs/ui-contracts/ are product invariants and must be versioned,
# docs/qa/ holds approved QA policy (the canonical visual baseline) that CI
# and the Playwright config both point at, and docs/policy/ holds approved
# product policy that code and CI enforce (credit entitlement vs operational
# cost guardrail). docs/ops/ holds runbooks the deployment path itself depends
# on -- the migration baseline procedure is not reconstructable from the code.
# docs/release-gates/ holds the canonical Tomverse Chat release-gate registry
# that verify:tomverse-chat-release-gates enforces in the PR fast gate.
docs/*
!docs/ui-contracts/
!docs/qa/
!docs/policy/
!docs/ops/
!docs/release-gates/
.playwright-mcp

# Scratch build directory for scripts/verify-package-build-matrix.mjs.
.package-build-matrix-*

# Pre-change snapshots from scripts/stamp-promotion-metadata.mjs. Its default
# path is the working tree, and the file records live Stripe object metadata.
promotion-metadata-snapshot-*.json

# Staging verification fixtures, generated on demand.
#
# `npm run make:assistant-package-staging-fixtures` writes packages and their
# answer key here. They are not committed: the command reproduces the same
# bytes, the manifest carries their digests, and a fixture in the tree is one
# that drifts from the code it was built to exercise.
.tmp/

# Agent worktrees. `EnterWorktree` puts a full checkout under here -- with its
# own node_modules and .next once anything has been built or run in it, so the
# directory is gigabytes of build output that git would otherwise offer to
# commit. The worktree has its own working tree and its own branch; nothing in
# it belongs to this one.
#
# Scoped to the subdirectory, not to `.claude/`: settings and skills checked in
# under .claude/ are repository content and must stay versioned.
/.claude/worktrees/
