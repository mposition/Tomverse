{
  "name": "tomverse-railway-iac",
  "private": true,
  "type": "module",
  "description": "Railway Infrastructure as Code for the scheduled-job cron services. Not part of the app build or the npm workspaces.",
  "scripts": {
    "status": "node run.mjs status",
    "use:staging": "node run.mjs link --project Tomverse --environment staging",
    "use:production": "node run.mjs link --project Tomverse --environment production",
    "use:dev": "node run.mjs link --project Tomverse --environment dev",
    "plan": "node run.mjs config plan --verbose",
    "apply": "node run.mjs config apply",
    "agents:use:staging": "node run.mjs link --project \"Tomverse Agents\" --environment staging",
    "agents:use:production": "node run.mjs link --project \"Tomverse Agents\" --environment production",
    "agents:use:dev": "node run.mjs link --project \"Tomverse Agents\" --environment dev",
    "agents:plan": "node run.mjs config plan --file agents-railway.ts --verbose",
    "agents:apply": "node run.mjs config apply --file agents-railway.ts"
  },
  "devDependencies": {
    "railway": "3.11.0"
  }
}
