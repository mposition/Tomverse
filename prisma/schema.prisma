// One row per provider, updated atomically on every recordProviderSuccess/
// recordProviderFailure call. Unlike ChatUsageBucket's day/5-minute counters
// (which reset on their own schedule and can't tell "no traffic since
// midnight" apart from "no traffic in months"), this is the durable source
// of truth for "when did we last actually hear from this provider" -- it's
// what the public status page's freshness check is computed from.
model ProviderHealthState {
  provider                  String    @id
  lastSuccessAt             DateTime?
  lastFailureAt             DateTime?
  consecutiveFailures       Int       @default(0)
  // AUD-R001: synthetic-probe evidence, kept in separate fields from the
  // real-user-traffic ones above so the two evidence streams never
  // overwrite each other -- recordProviderProbeSuccess/Failure only ever
  // touch these three, recordProviderSuccess/Failure only ever touch the
  // three above. lib/providerPublicStatusCore.ts merges both explicitly.
  lastProbeSuccessAt        DateTime?
  lastProbeFailureAt        DateTime?
  consecutiveProbeFailures  Int       @default(0)
  // STG-R002: administrator-triggered live verification evidence. A third
  // stream again, for the same reason: an operator proving the API answers is
  // not the same claim as "real user traffic is being served", so it must
  // never be written into lastSuccessAt. lib/providerPublicStatusCore.ts
  // merges it explicitly under its own reason codes.
  lastVerificationSuccessAt DateTime?
  lastVerificationFailureAt DateTime?
  // When the blocking consecutiveFailures counter was last cleared by a
  // verified recovery, and the ProviderHealthCheck row that authorised it.
  // Recovery is only ever performed against a successful verification, so this
  // id is the audit trail linking "the block was lifted" to "here is the call
  // that proved it was safe to lift".
  lastRecoveryAt            DateTime?
  lastRecoveryCheckId       String?
  updatedAt                 DateTime  @updatedAt

  @@index([lastSuccessAt])
  @@index([lastProbeSuccessAt])
}

// One row per (provider, model) synthetic probe attempt (AUD-R001). Distinct
// from ProviderHealthCheck, which is an admin-triggered manual "is the API
// key configured" check that never calls a provider live -- this table is
// the automated scheduled prober's own attempt log. Deliberately excludes
// anything sensitive: no API keys, no raw provider response body, no stack
// traces, no user content -- enforced by the row-builder never receiving
// those values in the first place (see lib/providerProbe.ts), and checked
// by a static-scan unit test.
model ProviderProbeResult {
  id                  String   @id @default(cuid())
  /// The owning ScheduledJobRun.id for this probe cycle.
  runId               String
  provider            String
  modelId             String
  environment         String
  startedAt           DateTime
  completedAt         DateTime
  success             Boolean
  timedOut            Boolean  @default(false)
  latencyMs           Int?
  /// Public-safe classification only, e.g. "TIMEOUT" | "AUTH" | "RATE_LIMIT" |
  /// "SERVER_ERROR" | "NETWORK" | "UNKNOWN" -- never a raw provider message.
  errorClassification String?
  /// Sanitized diagnostic code in the same shape providerDiagnosticCode()
  /// produces (e.g. "PROVIDER_PROBE_FAILED.ECONNRESET.HTTP_503.RETRYABLE").
  diagnosticCode      String?
  createdAt           DateTime @default(now())

  providerEndpointId String?
  modelDeploymentId  String?

  probedEndpoint   ProviderEndpoint? @relation(fields: [providerEndpointId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  probedDeployment ModelDeployment?  @relation(fields: [modelDeploymentId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([provider, createdAt])
  @@index([provider, modelId, createdAt])
  @@index([runId])
}

// One in-flight chat response. Counted to enforce concurrency, never to bill.
//
// `subjectKey` is the individual caller (an account, or a *signed guest
// cookie* -- not an IP). `ipKey` is carried alongside so the same row can also
// be counted for the anonymous aggregate abuse ceiling without a second row
// and without a second thing to release. See lib/chatConcurrencyCore.ts.
//
// A row with `claimedAt = NULL` is a slot reserved by the aggregate comparison
// preflight and not yet consumed by its model request; it expires quickly on
// its own if the browser never sends the request.
model ChatRequestLease {
  id              String    @id
  subjectKey      String
  ipKey           String?
  admissionId     String?
  modelId         String?
  claimedAt       DateTime?
  heartbeatAt     DateTime  @default(now())
  expiresAt       DateTime
  createdAt       DateTime  @default(now())
  // Per-minute request capacity the aggregate preflight paid for this slot, so
  // an admission that is rolled back can hand it straight back instead of
  // holding it for the rest of the minute. Separate from `ipKey`, which is the
  // IP *concurrency* scope and exists for guests only: the per-minute IP rate
  // ceiling applies to signed-in callers too, and merging the two would make
  // an account consume the anonymous concurrency ceiling.
  rateIpKey       String?
  rateMinuteStart DateTime?

  @@index([subjectKey, expiresAt])
  @@index([ipKey, expiresAt])
  @@index([admissionId])
  @@index([expiresAt])
}

// Why one chat request was allowed or refused by a credit/cost limit, keyed by
// the Trace ID the user is shown. Carries no prompt text and no message
// content: the subject is the same hashed usage key the rate limiter uses, and
// the rest is the pricing and allowance arithmetic behind the decision.
