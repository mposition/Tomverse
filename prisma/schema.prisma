generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ==========================================
// ==========================================

model User {
  id                            String        @id @default(cuid())
  name                          String?
  email                         String?       @unique
  emailVerified                 DateTime?
  image                         String?
  plan                          String        @default("Free") // "Free", "Pro", "Max"
  stripeCustomerId              String?       @unique
  stripeSubscriptionId          String?       @unique
  stripePriceId                 String?
  subscriptionStatus            String?
  subscriptionCurrentPeriodEnd  DateTime?
  subscriptionBillingInterval   String?
  subscriptionCancelAtPeriodEnd Boolean       @default(false)
  /// When the stored subscription state was read from Stripe. Webhooks arrive
  /// out of order, so a snapshot read before this is refused rather than
  /// reverting the account to an older plan. See lib/stripeWebhookSyncCore.ts.
  subscriptionSyncedAt          DateTime?
  creditDebtCredits             Int           @default(0)
  creditDebtCostMicroUsd        BigInt        @default(0)
  billingRiskStatus             String        @default("normal")
  billingRiskReason             String?
  billingRiskAt                 DateTime?
  accountStatus                 String        @default("active")
  accountSuspendedAt            DateTime?
  accountSuspendedUntil         DateTime?
  accountSuspensionReason       String?
  accountSuspendedById          String?
  accountSuspendedByEmail       String?
  aiUsageRestricted             Boolean       @default(false)
  aiUsageRestrictedAt           DateTime?
  aiUsageRestrictedUntil        DateTime?
  aiUsageRestrictionReason      String?
  aiUsageRestrictedById         String?
  aiUsageRestrictedByEmail      String?
  securityIncidentNote          String?
  // Session-invalidation epoch. Sessions use the JWT strategy, so there is no
  // server-side session row to delete; any token issued at or before this
  // instant is rejected. Bumped by revokeAllUserSessions().
  sessionsRevokedAt             DateTime?
  accountDeletionRequestedAt    DateTime?
  accountDeletionScheduledFor   DateTime?
  lastLoginAt                   DateTime?
  createdAt                     DateTime?     @default(now())
  emailLoginEnabled             Boolean       @default(true)
  sessionsInvalidatedAt         DateTime?
  settings                      UserSettings?

  accounts                             Account[]
  sessions                             Session[]
  projects                             ConversationProject[]
  refundRequests                       RefundRequest[]
  promotionRedemptions                 BillingPromotionRedemption[]
  billingTransactions                  BillingTransaction[]
  creditPurchases                      CreditPurchase[]
  creditLots                           CreditLot[]
  creditLedgerEntries                  CreditLedgerEntry[]
  creditDebtEntries                    CreditDebtEntry[]
  chatCreditReservations               ChatCreditReservation[]
  imageGenerations                     ImageGeneration[]
  messageArtifacts                     MessageArtifact[]
  messageAttachments                   MessageAttachment[]
  messageAttachmentUploads             MessageAttachmentUpload[]
  imageGenerationGroups                ImageGenerationGroup[]
  imageCreditReservations              ImageCreditReservation[]
  memoryExtractionCreditReservations   MemoryExtractionCreditReservation[]
  adminNotes                           AdminNote[]
  modelOverrides                       ModelOverride[]
  conversations                        Conversation[]
  comparisonReviews                    ComparisonReview[]
  productAnalyticsEvents               ProductAnalyticsEvent[]
  privacyRequests                      PrivacyRequest[]
  planChangeRequests                   PlanChangeRequest[]
  externalImports                      ExternalImport[]
  continuationBridges                  ConversationContinuationBridge[]
  memoryItems                          MemoryItem[]
  memoryExtractionRuns                 MemoryExtractionRun[]
  routingRuns                          RoutingRun[]
  memorySettings                       UserMemorySettings?
  accountDataExportRequests            AccountDataExportRequest[]
  assistantProfiles                    AssistantProfile[]
  assistantProfileVersions             AssistantProfileVersion[]
  assistantKnowledgeFiles              AssistantKnowledgeFile[]
  assistantKnowledgeChunks             AssistantKnowledgeChunk[]
  assistantProfileImports              AssistantProfileImport[]
  assistantKnowledgeUploadReservations AssistantKnowledgeUploadReservation[]
  emailPreferences                     EmailPreference[]
  emailPreferenceTransitions           EmailPreferenceTransition[]
  consentRecords                       ConsentRecord[]
  emailDeliveries                      EmailDelivery[]
  campaignRecipients                   EmailCampaignRecipient[]
  modelMigrationRecords                ModelMigrationRecord[]
  quotaScopes                          QuotaScope[]
  credentialBindings                   CredentialBinding[]
  deploymentCacheAffinities            DeploymentCacheAffinity[]
  routingCandidateVerdicts             RoutingCandidateVerdict[]

  @@index([plan, id])
  @@index([createdAt])
  @@index([subscriptionStatus, subscriptionCurrentPeriodEnd])
  @@index([subscriptionCancelAtPeriodEnd, subscriptionStatus])
  @@index([billingRiskStatus])
  @@index([accountStatus, accountSuspendedUntil])
  @@index([accountStatus, accountDeletionScheduledFor])
  @@index([aiUsageRestricted, aiUsageRestrictedUntil])
  @@index([creditDebtCredits])
  @@index([creditDebtCostMicroUsd])
}

model UserSettings {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  theme                   String    @default("dark") // "dark", "light", "system"
  language                String    @default("en") // "ko", "en"
  defaultModel            String    @default("gpt-5-6-luna")
  // 1-3 model IDs a signed-in account starts a new conversation with.
  // NULL (never a schema default, never backfilled) means [defaultModel];
  // lib/newConversationModels.ts is the only interpreter. See
  // docs/policy/default-model-luna-migration.md §1.2.
  newConversationModelIds Json?
  preferredTasks          Json?
  preferredPriority       String?
  usesFilesFrequently     String?
  modelFinderCompletedAt  DateTime?
  modelFinderDismissedAt  DateTime?
  timeZone                String    @default("UTC")
  timeZoneInitializedAt   DateTime?

  /// Whether pressing the chat image handoff should generate straight away
  /// instead of landing in the workspace with the prompt filled and the price
  /// shown.
  ///
  /// An account setting rather than a browser one, deliberately: this decides
  /// whether one click spends credits, and a preference stored per device
  /// would let a shared computer spend somebody else's. It is also why the
  /// only place it can be turned on is beside the price
  /// (docs/ui-contracts/image-generation-workspace.md) -- the contract's
  /// "quoted before submission" survives as "quoted at least once, by the
  /// person who chose to stop being asked".
  ///
  /// Default false, and false is the whole behaviour for an account that never
  /// opts in.
  imageHandoffAutoGenerate Boolean   @default(false)
  timeZoneChangedAt        DateTime?

  /// The account's own statement of where it is, used to decide which
  /// jurisdiction's email rules apply. Deliberately separate from the IP
  /// country that analytics consent and billing currency read: a Korean
  /// resident travelling through Chicago does not leave the reach of the
  /// Network Act, and an address is not a location signal
  /// (docs/policy/email-notifications.md §6.1).
  ///
  /// NULL means unresolved, which holds marketing back rather than guessing
  /// (§6.3). It never blocks transactional or legal mail.
  country          String?
  /// self_declared | billing | inferred. Which signal produced `country`,
  /// so a weaker one cannot silently overwrite a stronger one.
  countrySource    String?
  countryUpdatedAt DateTime?

  /// What the payment method's country said, kept beside the declaration
  /// rather than folded into it.
  ///
  /// Both are needed at once or a disagreement cannot be seen: with one column
  /// the second signal would simply overwrite the first, and the contract's
  /// conflict case (docs/policy/email-notifications.md §6.2 step 3) would be
  /// undetectable rather than handled.
  /// Written by the Stripe webhook; never by anything a visitor controls.
  billingCountry          String?
  billingCountryUpdatedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  createdAt    DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expires])
  @@index([userId, createdAt])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// Passwordless email login: one row per outstanding "we sent you a code and
// a link" request. Not related to VerificationToken above (that table's
// token column is globally unique, a poor fit for a human-typed 6-digit
// code, and it has no consumed/invalidated columns for single-use +
// explicit-invalidation semantics). No relation to User: at request time the
// email may not correspond to any existing account yet.
model EmailLoginAttempt {
  id            String    @id @default(cuid())
  email         String
  codeHash      String
  linkTokenHash String    @unique
  expiresAt     DateTime
  consumedAt    DateTime?
  invalidatedAt DateTime?
  createdAt     DateTime  @default(now())

  @@index([email, consumedAt, invalidatedAt, expiresAt])
  @@index([expiresAt])
}

// ==========================================
// ==========================================

model Conversation {
  id        String  @id @default(cuid())
  userId    String
  title     String
  projectId String?

  // "chat" | "image". Server-decided: the conversation create endpoint's
  // strict schema never accepts it, and an "image" row is only ever created
  // inside the image generation reservation transaction, so an image
  // conversation cannot exist without at least one ImageGeneration (audited
  // by lib/imageAssetLifecycle.ts). See docs/policy/image-generation.md.
  kind String @default("chat")

  /// "chat" | "review" | "studio" -- which Tomverse product this conversation
  /// belongs to (product boundary decision record v1.2, decision 2). Allowlist
  /// and cross-constraints live in the migration; the application copy is
  /// lib/conversationProduct.ts.
  ///
  /// Orthogonal to `kind`, and deliberately not derived from it: `kind` is the
  /// execution and permission modality that lib/conversationKindGuard.ts
  /// enforces, `productKey` is the product task the user is performing. The
  /// delivery plan §5 forbids reusing one as the other.
  ///
  /// Nullable and **without a default** during the expand phase. A `review`
  /// default would answer "unknown" with "Review" for every writer that
  /// omitted the column, which is the substitution the nullability exists to
  /// prevent (20260814170000_attempt_cost_accrual). NULL means "not decided
  /// yet", and that is the backfill's work list. NOT NULL is a later,
  /// separate migration with its own evidence.
  productKey String?

  /// Per-conversation memory mode (import/memory policy §8.1 invariant 1):
  /// "inherit" | "on" | "off" — allowlist CHECK lives in the migration.
  /// Server-stored and server-decided; "inherit" resolves to the account
  /// default, and no mode can override the account master toggle, the
  /// feature flag, revocation, or ownership checks.
  memoryMode String @default("inherit")

  // For kind = "image" this is stored as "[]" and never read: the image
  // model comes from the image generation server layer's fixed allowlist,
  // not from conversation state.
  selectedModels String @default("[\"gpt-5-6-luna\"]")
  disabledPanels String @default("[]")
  webSearchMode  String @default("off") // off | auto | always

  /// "manual" | "auto" (routing policy §5; allowlist CHECK lives in the
  /// migration). Server-stored and server-decided: a request may ask for a
  /// mode, but cohort eligibility (lib/autoCohort.ts) decides whether Auto
  /// actually routes. A conversation left on "auto" while the account leaves
  /// the cohort falls back to its own model choice rather than failing.
  selectionMode String @default("manual")

  /// Auto's sticky state, from lib/routerSelection.ts. `routerModelId` is the
  /// model this conversation is currently on and `routerChallengerTurns` the
  /// consecutive turns a challenger has cleared the switch margin. Both are
  /// cleared when the conversation returns to manual: a streak accumulated
  /// under Auto would otherwise decide the first switch after it is turned
  /// back on, using evidence from a period the user did not route.
  routerModelId         String?
  routerChallengerTurns Int     @default(0)

  /// §8 recovery, carried to the next turn. Set only by a successful hard
  /// fallback, and cleared with the rest of the sticky state whenever the
  /// conversation returns to manual -- §8 is explicit that manual intent wins
  /// over fallback recovery.
  routerSwitchReason    String?
  routerRecoveryModelId String?

  /// Policy: docs/policy/external-conversation-import-and-memory.md.
  /// The assistant profile version this conversation is pinned to (release C,
  /// policy §14). Set once when the conversation starts and never rewritten by
  /// a later edit to the profile: a published revision is what this
  /// conversation ran under, and moving it is an explicit user action.
  ///
  /// NULL for every conversation that started without a profile, which is all
  /// of them before release C. `SetNull` on delete because deleting a profile
  /// is a deletion request -- the conversation stays readable and simply
  /// stops naming a profile.
  assistantProfileVersionId String?
  assistantProfileVersion   AssistantProfileVersion? @relation(fields: [assistantProfileVersionId], references: [id], onDelete: SetNull)

  /// When the profile this conversation was using was deleted.
  ///
  /// `SetNull` above is what makes this column necessary. Once the profile is
  /// gone its versions go with it and `assistantProfileVersionId` becomes
  /// NULL, so the conversation reads exactly like one that never had an
  /// assistant -- and that is what the composer showed: `어시스턴트 없음`,
  /// with nothing to say the assistant had been removed. A staging round on
  /// 2026-08-25 recorded that as §G-2; the owner only found out by opening the
  /// menu.
  ///
  /// Only the time is kept, not the profile's name. The owner asked for that
  /// profile to be deleted, and copying its name onto every conversation it
  /// touched would be keeping the thing they removed. The time is enough for
  /// the sentence the screen owes them: this conversation's assistant was
  /// deleted.
  ///
  /// Cleared whenever the conversation's profile binding changes by either
  /// route -- attaching a new assistant or detaching on purpose. After that
  /// the deletion is no longer what the current state is explained by.
  assistantProfileRemovedAt DateTime?

  shareToken     String?   @unique
  shareEnabled   Boolean   @default(false)
  sharedAt       DateTime?
  shareSnapshot  Json?
  shareExpiresAt DateTime?
  shareRevokedAt DateTime?

  messages              Message[]
  routingRuns           RoutingRun[]
  messageArtifacts      MessageArtifact[]
  messageAttachments    MessageAttachment[]
  comparisonReviews     ComparisonReview[]
  imageGenerations      ImageGeneration[]
  imageGenerationGroups ImageGenerationGroup[]
  cacheAffinities       DeploymentCacheAffinity[]
  continuationBridge    ConversationContinuationBridge?
  user                  User?                           @relation(fields: [userId], references: [id], onDelete: Cascade)
  project               ConversationProject?            @relation(fields: [projectId], references: [id], onDelete: SetNull)
  createdAt             DateTime                        @default(now())
  updatedAt             DateTime                        @updatedAt
  password              String?
  importedGuestKey      String?

  @@unique([userId, importedGuestKey])
  @@index([userId, projectId])
  @@index([userId, kind])
}

model ConversationProject {
  id            String         @id @default(cuid())
  userId        String
  name          String
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversations Conversation[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@unique([userId, name])
  @@index([userId, updatedAt])
}

model Message {
  id              String                  @id @default(cuid())
  role            String
  content         String
  status          String                  @default("normal")
  modelId         String?
  pendingJobId    String?
  searchMetadata  Json?
  providerContext MessageProviderContext?

  /// How much account memory this answer's prompt carried. §8.1 invariant 4
  /// forbids storing the injected context as a Message row and explicitly
  /// permits the used count and non-sensitive aggregate metadata, which is
  /// all this is — the memory text is never written here. NULL means no §10
  /// context bundle accompanied the request, so memory was not possible;
  /// 0 means a bundle was verified and retrieval selected nothing.
  ///
  /// The day counters in lib/memoryMetricsCore.ts already report the
  /// injection ratio. This is the thing a counter cannot give: attribution
  /// per answer, which §22's follow-up proxy needs to compare the answers
  /// memory shaped against the ones it did not.
  memoryUsedCount Int?
  memoryTokens    Int?

  /// How many assistant-profile knowledge excerpts this answer's prompt
  /// carried (docs/policy/external-conversation-import-and-memory.md §14.3). The same
  /// shape and the same permission as the two
  /// columns above: a count and nothing else, never the excerpt text and
  /// never which files it came from. NULL means no
  /// docs/policy/external-conversation-import-and-memory.md §10 context bundle
  /// accompanied the request, so no profile knowledge was possible; 0 means
  /// a bundle was verified and knowledge retrieval selected nothing.
  ///
  /// Named for chunks rather than for use, because that is what the server
  /// actually knows. It counts the excerpts placed in the prompt, not
  /// whether the model drew on them -- nothing here can observe the latter,
  /// and a name that implied it would make the disclosure claim more than
  /// the number supports.
  knowledgeChunkCount Int?

  /// Files this answer produced (docs/policy/generated-artifacts.md). Empty
  /// for every message written before the feature and for every message that
  /// asked for no file, which is almost all of them -- an artifact is an
  /// addition to an answer, never a replacement for one, so a message with
  /// none is a complete message.
  artifacts MessageArtifact[]

  /// Files the *user* attached to this message
  /// (docs/policy/user-attachment-persistence.md). Empty for every message
  /// sent without a file, which is most of them. Distinct from `artifacts` in
  /// both direction and lifecycle: an artifact is produced by the answer and
  /// downloadable, an attachment is supplied by the person and is only ever
  /// re-read server-side to build a later prompt.
  attachments MessageAttachment[]

  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())

  @@index([conversationId])
  /// §22's follow-up proxy reads answers by time window across every
  /// conversation; without this it scans the whole table.
  @@index([createdAt])
}

// Provider-private assistant state needed to replay reasoning models exactly
// (for example Kimi's reasoning_content and Anthropic thinking signatures).
// Kept in a separate table so ordinary conversation queries and exports can
// never expose it through a broad Message selection.
model MessageProviderContext {
  messageId        String   @id
  message          Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  modelId          String
  provider         String
  responseMessages Json
  createdAt        DateTime @default(now())

  @@index([modelId])
}

/// One file an assistant answer produced, and the record that authorises its
/// download. Policy: docs/policy/generated-artifacts.md.
///
/// `userId` and `conversationId` are stored rather than reached through
/// `message`, and that redundancy is the point: the download route checks
/// ownership before it has any reason to trust the message row, and a join it
/// has to perform first is a join whose absence is a 500 rather than a 404.
/// Both carry their own cascade, so deleting either the account or the
/// conversation removes the row.
///
/// The bytes are not here. They are in object storage under `objectKey`, which
/// never leaves the server: the client is given the row id and asks
/// `/api/artifacts/{id}` for the file (policy section 5).
model MessageArtifact {
  id String @id @default(cuid())

  messageId String
  message   Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Position within the turn. Together with `messageId` this is the
  /// idempotency key: a provider retry that replays the same tool call writes
  /// the same (messageId, ordinal) and is refused by the unique index rather
  /// than producing a second copy of the same file.
  ordinal Int @default(0)

  /// xlsx | csv -- SUPPORTED_ARTIFACT_FORMATS in lib/generatedArtifactCore.ts,
  /// with the allowlist CHECK in the migration.
  format    String
  filename  String
  mediaType String
  byteSize  Int    @default(0)

  /// ready | failed. NULL objectKey exactly when the row is not `ready`; the
  /// migration's CHECK enforces the pairing, so a "ready" artifact that points
  /// at nothing cannot be written at all.
  status      String  @default("ready")
  objectKey   String? @unique
  /// ArtifactFailureCode, when status is `failed`.
  failureCode String?

  /// Which model's answer produced it. Denormalised from the message on
  /// purpose: a comparison turn writes several messages and several artifacts,
  /// and the card has to name the right model for each without a second read.
  modelId String?

  createdAt DateTime @default(now())

  @@unique([messageId, ordinal])
  @@index([conversationId, createdAt])
  @@index([userId, createdAt])
}

/// DB-first deletion tombstone for generated artifacts, mirroring
/// `ImageAssetCleanup` and for the same reason: the row and the object cannot
/// be removed in one transaction, so the row's removal enqueues the object's
/// and the maintenance sweep drains the queue. Object storage is never deleted
/// ahead of the database.
model MessageArtifactCleanup {
  id          String    @id @default(cuid())
  objectKey   String    @unique
  /// conversation_deleted | account_deleted | message_deleted | storage_rollback
  reason      String
  attempts    Int       @default(0)
  lastError   String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  completedAt DateTime?

  @@index([completedAt, createdAt])
}

/// One file the *user* attached to one of their own messages.
///
/// Policy: docs/policy/user-attachment-persistence.md.
///
/// Before this table an attachment existed only in browser memory: it was
/// uploaded, sent, read once by the request that carried it, and then lost on
/// the next reload. The message it belonged to was stored with the file names
/// pasted into its text, so a file-only turn came back as a comma-separated
/// list of names and no later turn could read the file again.
///
/// `userId` and `conversationId` are denormalised for the same reason
/// `MessageArtifact` denormalises them: every resolution is an ownership
/// check, and an ownership check that needs a join first is a 500 waiting to
/// be a 403.
///
/// The bytes are not here. `objectKey` names an object in private storage and
/// never leaves the server -- no route returns it, the conversation read
/// selects around it, and nothing accepts one from a client.
model MessageAttachment {
  id String @id @default(cuid())

  messageId String
  message   Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Position within the message. With `messageId` this is the idempotency
  /// key: the composer re-posting the same pre-save (a retried fetch, a
  /// double submit) writes the same pair and the unique index refuses the
  /// second copy instead of duplicating the card.
  ordinal Int @default(0)

  /// The name the user's own file had. Displayed, never used as a path.
  name      String
  mediaType String
  /// Bytes, as measured in storage at upload finalisation -- not as declared.
  size      Int    @default(0)
  /// "file" | "text", decided by the server from `mediaType`.
  kind      String

  /// Private storage key. Server-only, and unique so two messages can never
  /// claim the same object.
  objectKey String @unique

  /// The upload this was bound from, kept so a rebind of the same upload is
  /// recognisable and so an operator can trace a stored file back to the
  /// request that accepted it.
  uploadId String?

  /// When storage confirmed, with a 404, that this object is gone.
  ///
  /// Nullable, and set only from a confirmed 404 -- never from a read that
  /// merely failed. A 403 from a rotated key and a 500 from the bucket both
  /// mean "we do not know", and writing those here would turn a five-minute
  /// credentials outage into a permanent record that an account's files were
  /// lost (docs/policy/user-attachment-persistence.md section 11).
  ///
  /// The row itself is never deleted because of this. The card stays, the
  /// message stays, the name and size stay: what the user sent is part of the
  /// conversation whether or not the bytes survived, and hiding the card would
  /// leave them asking a model about a file neither side can name.
  unavailableAt DateTime?

  /// Why, from MESSAGE_ATTACHMENT_UNAVAILABLE_REASONS in
  /// lib/messageAttachmentCore.ts. Free text is not accepted: this column is
  /// read to decide what the user is told, and a reason nobody enumerated has
  /// no copy for it.
  unavailableReason String?

  /// The last time availability was *checked*, whatever the answer.
  ///
  /// Separate from `unavailableAt` because "we looked and it was there" and
  /// "we have not looked since Tuesday" are different facts, and the audit
  /// tool needs the second one to know what it has covered.
  availabilityCheckedAt DateTime?

  createdAt DateTime @default(now())

  @@unique([messageId, ordinal])
  @@index([conversationId, createdAt])
  @@index([userId, createdAt])
  @@index([unavailableAt])
}

/// A finalised upload that has not been bound to a message yet.
///
/// This row is the reason no route has to trust a storage key from a browser.
/// The upload endpoint validates the object it just accepted and hands back
/// this row's opaque id; every later reference -- the send, a retry, a
/// template lookup -- names that id, and the server resolves the key itself.
///
/// It outlives binding rather than being consumed, because a draft can be sent
/// twice and a failed send is retried with the same composer state. Binding is
/// therefore idempotent on (messageId, ordinal), not on this row.
model MessageAttachmentUpload {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  name      String
  mediaType String
  size      Int
  kind      String

  objectKey String @unique

  /// When this upload was first bound to a message. Informational: a second
  /// send of the same draft is legitimate and is not refused here.
  boundAt   DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, createdAt])
}

/// DB-first deletion tombstone for user-supplied attachments, mirroring
/// `MessageArtifactCleanup` exactly and for the same reason: the row and the
/// object cannot be removed in one transaction, so the row's removal enqueues
/// the object's and the maintenance sweep drains the queue.
model MessageAttachmentCleanup {
  id String @id @default(cuid())

  objectKey   String    @unique
  /// conversation_deleted | account_deleted | message_deleted | upload_abandoned
  reason      String
  attempts    Int       @default(0)
  lastError   String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  completedAt DateTime?

  @@index([completedAt, createdAt])
}

model ComparisonReview {
  id                  String       @id @default(cuid())
  userId              String
