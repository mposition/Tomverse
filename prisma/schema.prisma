/// Where a provider actually serves a request from.
///
/// Dark. Nothing writes this, nothing routes from it, and no request consults
/// it. It exists so that the identity the routing work needs can be added
/// before the facts that fill it arrive, which is the order the independent
/// review asked for: additive schema first, activation separately.
///
/// Separate from `ModelDeployment` because a region is infrastructure and a
/// model is not. One Azure resource serves several model deployments under one
/// credential, and the question "which jurisdiction processed this" is answered
/// here rather than once per model.
///
/// Design: .github/audits/multi-provider-routing-deployment-identity-design-2026-09-22.md
model ProviderEndpoint {
  id                  String   @id @default(cuid())
  /// The provider the request is sent to.
  gatewayProvider     String
  /// The provider that actually serves the model.
  ///
  /// Null when an aggregator will not say, or can change it. Equal to
  /// `gatewayProvider` on a direct route. There is deliberately no single
  /// `provider` column: a reader could not tell which of the two it meant.
  servingProvider     String?
  /// The region this endpoint serves from, when it is known.
  region              String?
  endpointUrl         String?
  /// The cloud account or resource this endpoint belongs to.
  resourceId          String?
  /// The cloud account or project this resource belongs to.
  cloudAccountId      String?
  /// proven | unproven
  ///
  /// `unproven` is the honest default and not a gap: it says nobody has read a
  /// contract that names where the data goes. An unproven endpoint carries no
  /// residency-constrained traffic. There is no third value for "probably" --
  /// whoever needed one would read it as a yes.
  residencyClass      String   @default("unproven")
  /// The regions this endpoint can reach, as fixed identifiers.
  destinationRegions  Json?
  /// A digest of the routing configuration we send an aggregator.
  ///
  /// Our intent, never their fact: it proves what was asked for and says
  /// nothing about where the broker ran it. Eligibility is decided from the
  /// approval below, not from this.
  routingPolicyDigest String?
  enabled             Boolean  @default(false)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  deployments                    ModelDeployment[]
  approvals                      EndpointResidencyApproval[]
  credentialBindings             CredentialBinding[]
  quotaScopes                    QuotaScope[]
  providerProbeResults           ProviderProbeResult[]
  routingAttempts                RoutingAttempt[]
  availabilityObservations       AvailabilityObservation[]
  routingIdentityManifestEntries RoutingIdentityManifestEntry[]

  @@index([gatewayProvider, enabled])
  @@index([residencyClass])
}

/// What was approved, and on what basis, at a point in time.
///
/// Append-only. An approval is never edited: a change is a new row, so that
/// "what was allowed when this request ran" has an answer that cannot be
/// rewritten afterwards. An operator who could edit a destination could make a
/// past disclosure look compliant.
///
/// The routing gate reads this, not `ProviderEndpoint.region`, so that a legal
/// question has one source rather than two that can disagree.
model EndpointResidencyApproval {
  id                   String    @id @default(cuid())
  providerEndpointId   String
  /// Fixed identifier of what permits this -- a contract, a DPA, a published
  /// sub-processor page. Never prose: a later reader checks the reference
  /// rather than trusting the row.
  evidenceRef          String
  /// The legal entities that receive the data.
  allowedRecipients    Json
  /// The regions the data may be processed in.
  allowedRegions       Json
  /// What makes the pin hold -- an endpoint URL, a request option, an account
  /// setting. A region nothing enforces is a hope.
  enforcementMechanism String
  effectiveFrom        DateTime
  effectiveTo          DateTime?
  /// The person who approved it.
  approvedBy           String
  createdAt            DateTime  @default(now())

  endpoint                       ProviderEndpoint               @relation(fields: [providerEndpointId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  routingIdentityManifestEntries RoutingIdentityManifestEntry[]

  @@index([providerEndpointId, effectiveFrom])
}

/// One routable placement of a logical model.
///
/// Dark, as above. The same logical model on two endpoints is two rows here
/// and one model to the person using it: `logicalModelId` stays the product's
/// own model id, because a user's saved model must not become an
/// infrastructure identifier.
model ModelDeployment {
  id                     String    @id @default(cuid())
  /// The catalogue model a person selects. Not a foreign key: the catalogue is
  /// partly static, and a deployment must not be deleted by a registry edit.
  logicalModelId         String
  providerEndpointId     String
  /// What the provider calls it, which is not what we call it. Azure's own
  /// word for this is "deployment", which is why the column says whose.
  upstreamDeploymentName String
  modelVersion           String?
  modelRevision          String?
  quantization           String?
  tokenizerRevision      String?
  /// The quality tier this placement claims. Curation, never a measurement.
  qualityTier            String?
  /// Quality evidence is per-deployment until an attestation survey shows that
  /// two placements can honestly share it. Reusing evidence across regions
  /// without that would hide drift.
  qualityGateStatus      String    @default("pending")
  /// The digest reads this as an ISO instant, so a row can reproduce the
  /// digest computed from it. As a free string the same instant spelled two
  /// ways digested differently and this column kept only one of them.
  qualityGateExpiresAt   DateTime?
  /// How tightly this placement is pinned to modelVersion / modelRevision.
  /// `strong` never drifts. `weak` and `alias_only` may move only when
  /// allowVersionDrift is also true. The default is `strong`, so a row that
  /// predates the column cannot drift.
  versionPinStrength      String    @default("strong")
  allowVersionDrift       Boolean   @default(false)
  /// The benchmark a pass was measured against. Null until a gate is run.
  /// Changing it changes what the pass means, so an enabled row cannot.
  qualityBenchmarkVersion String?
  /// When that benchmark was last run. A re-check of the same benchmark may
  /// update this while the deployment stays enabled.
  qualityLastVerifiedAt   DateTime?
  /// Capability declarations, as the candidate filter would read them.
  capabilities           Json?
  enabled                Boolean   @default(false)
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  /// What this placement is known to do with a repeated prefix.
  ///
  /// `unproven` is the default and a third answer, not a synonym for either
  /// of the others: a deployment nobody has checked is not no-cache, and it
  /// is not a cache. The figures beside it stay null until a verification
  /// produces them, which the database holds.
  ///
  /// These columns do not decide whether a request carries a cache marker.
  /// That is lib/anthropicPromptCaching.ts, gating on provider identity
  /// because createAnthropic() also builds the MiniMax client. A dispatcher
  /// reading this instead would be a second answer to the same question.
  ///
  /// The word `automatic` means something else in that module: it says
  /// "automatic prompt caching" about a path that sends a top-level
  /// cache_control marker, which in this column is `verified_explicit`. An
  /// Anthropic deployment written as `verified_automatic` because of that
  /// sentence reads as one needing no marker and paying no write premium.
  ///
  /// The evidence reference is a path or an identifier, capped at 512
  /// characters by the database. The cap is what stops it becoming somewhere
  /// to paste the prefix that was tested.
  promptCacheSupport         String    @default("unproven")
  promptCacheMinPrefixTokens Int?
  promptCacheTtlSeconds      Int?
  promptCacheVerifiedAt      DateTime?
  promptCacheEvidenceRef     String?

  endpoint                       ProviderEndpoint               @relation(fields: [providerEndpointId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  quotaScopes                    QuotaScope[]
  cacheAffinities                DeploymentCacheAffinity[]
  providerProbeResults           ProviderProbeResult[]
  routingAttempts                RoutingAttempt[]
  availabilityObservations       AvailabilityObservation[]
  routingIdentityManifestEntries RoutingIdentityManifestEntry[]
  priceSnapshots                 DeploymentPriceSnapshot[]

  @@unique([providerEndpointId, upstreamDeploymentName])
  @@index([logicalModelId, enabled])
}

/// A ceiling on the published routing snapshot, approved by a named person.
///
/// Dark. Section 8.5 controls size when the configuration is approved rather
/// than by discarding evidence when a turn runs, and T4 scopes it to the
/// published snapshot only -- the staging registry may grow.
///
/// A row of its own, cited by a manifest, so the ceiling exists before and
/// independently of what is being published. Append-only by trigger: an
/// approval edited afterwards could not answer what the limit was when a
/// manifest was published under it.
///
/// No User relation. Deleting the approver's account must not rewrite what
/// they approved -- the reasoning EndpointResidencyApproval records.
model RoutingSnapshotCeilingApproval {
  id          String   @id @default(cuid())
  ceiling     Int
  approvedBy  String
  approvedAt  DateTime
  evidenceRef String?
  createdAt   DateTime @default(now())

  manifests RoutingIdentityManifest[]

  @@index([approvedAt])
}

/// One published snapshot of the routing identity configuration.
///
/// Dark. Nothing publishes a manifest and nothing reads one.
///
/// The identity design forbids four things until this exists: enabling the
/// config writer, recording a canary, judging eligibility, and making a
/// deployment-level decision. All four share one failure -- a decision made
/// against configuration that has since moved, with nothing able to say
/// afterwards what it was made against. Mutable rows cannot answer what was
/// allowed at the time, and the residency question puts a legal judgement on
/// top of that answer.
///
/// Published once and never edited, held by a trigger. `version` is unique;
/// `digest` is not, because two versions may publish identical configuration
/// -- a republish after a stopped rollout -- and that is a different
/// publication rather than a duplicate.
///
/// The entries are `RoutingIdentityManifestEntry`, and the digest is a check
/// on them rather than a substitute for them. A digest proves a set of values
/// was not altered if you still have the values, and ModelDeployment and
/// ProviderEndpoint are mutable rows that will have moved by the time anybody
/// asks -- so section 4.4's question needs a reconstruction, not a hash.
///
/// What the digest covers is the fixed field list in
/// lib/routingIdentityManifest.ts, so changing what a manifest commits to is
/// a change to that file rather than a silent effect of adding a column.
model RoutingIdentityManifest {
  id                String @id @default(cuid())
  version           Int
  /// sha256, lowercase hex. The database checks the shape; that it describes
  /// the deployments it was computed over is checked where they are visible.
  digest            String
  entryCount        Int
  /// The approved ceiling this manifest is published under, by id, and a
  /// copy of its value.
  ///
  /// A separate approval rather than a number supplied with the entries: a
  /// limit the publisher picks to fit is not the ceiling section 8.5 means.
  /// The copy is kept because a later reader asks what the limit was then,
  /// and a trigger refuses a copy that does not match the approval, or an
  /// approval dated after the publication.
  ///
  /// No default. A ceiling is an approval, and an absent approval is not an
  /// unlimited one.
  ceilingApprovalId String
  approvedCeiling   Int

  ceilingApproval RoutingSnapshotCeilingApproval @relation(fields: [ceilingApprovalId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  approvedBy      String
  approvedAt      DateTime
  createdAt       DateTime                       @default(now())

  attempts RoutingAttempt[]
  entries  RoutingIdentityManifestEntry[]

  @@unique([version])
  @@index([approvedAt])
  @@index([ceilingApprovalId])
}

/// What one published manifest held about one deployment.
///
/// Dark. Copied at publication, because the rows it describes are mutable:
/// the first version of the manifest stored only a digest, and a digest
/// proves values were not altered only while you still have the values.
///
/// The field list is wider than that first draft because the repository
/// already says what identity means and the draft was smaller than that.
/// `model_deployment_gate_follows_identity()` names nine columns and five
/// were missing, which let capabilities change under a stable digest:
/// disable (the digest moves), edit capabilities, re-enable and restore the
/// gate status. ProviderEndpoint has no such trigger at all, so its gateway,
/// serving provider, URL and enabled flag move under a stable id.
///
/// The residency approval is a key rather than a copy. That table is
/// append-only, so its recipients, regions, enforcement mechanism, evidence
/// and dates are already immutable where they are.
model RoutingIdentityManifestEntry {
  id         String @id @default(cuid())
  manifestId String
  /// This entry's place in its manifest: unique within the manifest and below
  /// its `entryCount`, so the entries cannot outnumber the count the
  /// approved ceiling bounds. A trigger in
  /// 20260923340000_routing_manifest_ceiling_dark enforces the upper bound.
  slot       Int

  /// The placement, as it stood.
  modelDeploymentId      String
  logicalModelId         String
  upstreamDeploymentName String
  modelVersion           String?
  modelRevision          String?
  quantization           String?
  tokenizerRevision      String?
  qualityTier            String?
  /// Canonical JSON from `canonicalCapabilities()`. Text rather than Json
  /// because the digest covers these exact bytes, and jsonb does not promise
  /// to return the bytes it was given.
  capabilities           String
  qualityGateStatus      String
  qualityGateExpiresAt   DateTime?
  versionPinStrength      String
  allowVersionDrift       Boolean
  qualityBenchmarkVersion String?
  qualityLastVerifiedAt   DateTime?
  deploymentEnabled      Boolean

  /// The endpoint it was served from, as it stood.
  providerEndpointId     String
  gatewayProvider        String
  servingProvider        String?
  endpointUrl            String?
  endpointResidencyClass String
  endpointEnabled        Boolean

  /// What it was allowed by. Null while an endpoint has no approval, which
  /// is every endpoint today.
  residencyApprovalId String?

  createdAt DateTime @default(now())

  /// Cascade to the publication it belongs to; RESTRICT to everything it
  /// describes. The cascade never fires -- the manifest's trigger refuses
  /// DELETE -- and says the entries belong to the publication rather than
  /// sitting beside it.
  manifest            RoutingIdentityManifest    @relation(fields: [manifestId], references: [id], onDelete: Cascade, onUpdate: Restrict)
  publishedDeployment ModelDeployment            @relation(fields: [modelDeploymentId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  publishedEndpoint   ProviderEndpoint           @relation(fields: [providerEndpointId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  publishedApproval   EndpointResidencyApproval? @relation(fields: [residencyApprovalId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  // The approval index is partial on IS NOT NULL in the migration, which
  // Prisma cannot express.

  @@unique([manifestId, modelDeploymentId])
  @@unique([manifestId, slot])
  @@index([modelDeploymentId])
}

/// Which deployment the turns of a conversation have been landing on.
///
/// Dark. Two facts rather than one probability: the ADR asks for
/// `P(cache_hit | session, deployment)` folded into an effective cost, and
/// that is both a change to the lexicographic objective and a number nothing
/// here can compute -- a cache hit needs a byte-identical prefix, and no
/// table records a prefix or a digest of one.
///
/// So this says where turns went and when, and `ModelDeployment` says what
/// the window is. Together they answer whether the last serve is inside the
/// window, which is a comparison of clocks and not a prediction.
///
/// The logical model is part of the key because a person can switch models
/// inside one conversation; a single row per conversation would have the
/// second model overwrite the first and then report it as the place to
/// return to.
///
/// There is no prefix digest and there will not be one. It is derived from
/// what the person wrote, and it confirms a guess.
model DeploymentCacheAffinity {
  id                String   @id @default(cuid())
  conversationId    String
  /// The catalogue model the person chose, not the placement that served it.
  logicalModelId    String
  modelDeploymentId String
  lastServedAt      DateTime
  servedTurns       Int      @default(1)
  /// How many times capacity displaced this placement. Null means no
  /// displacement has been recorded, which is not epoch zero. Appendix R1.
  /// Dark with the rest of this table.
  affinityEpoch     Int?
  /// The instant a displacement is allowed again. Null means no window was
  /// supplied. It is not a duration this schema chose.
  holdDownUntil     DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  /// Cascade on both sides, for the same reason and not by default. Without
  /// the conversation the row is an affinity for a thread that is gone and
  /// still names its id, which is a half-anonymisation after a person
  /// deletes; without the deployment it points at a placement that is gone.
  /// Denormalised from the parent so this is a data domain in its own right.
  ///
  /// The registry sweep decides a table holds user data from a User relation
  /// or a `*userId` column, and it is symmetric -- it refuses a registry row
  /// for a model the schema does not show holding any. Reaching a person
  /// through the parent was not enough, and the same note sits beside
  /// RoutingAttempt and ContextManifest for the same reason.
  ///
  /// Nullable because a guest has no account row. Cascade rather than
  /// SetNull: what is left after a null userId still names the person.
  userId String?

  conversation Conversation    @relation(fields: [conversationId], references: [id], onDelete: Cascade, onUpdate: Restrict)
  user         User?           @relation(fields: [userId], references: [id], onDelete: Cascade)
  deployment   ModelDeployment @relation(fields: [modelDeploymentId], references: [id], onDelete: Cascade, onUpdate: Restrict)

  @@unique([conversationId, logicalModelId])
  @@index([modelDeploymentId, lastServedAt])
}

/// A provider Tomverse can reach, as a row.
///
/// Dark. The catalogue's `AiProvider` union stays the product's list; this
/// exists so that a quota scope can name a provider with a foreign key rather
/// than a string nothing checks. A scope pointing at a provider that was
/// renamed or removed is a limit applying to nothing, which reads as no limit.
model ProviderRegistryEntry {
  id        String   @id
  /// Display name for operators. Never used to match anything.
  name      String
  enabled   Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  quotaScopes QuotaScope[]
}

/// What a capacity limit is counted against.
///
/// Dark. Five kinds, and each names exactly the columns its kind needs -- the
/// database holds that, so a row cannot be a `workspace` scope carrying a
/// credential or a `provider` scope carrying nothing. A single opaque string
/// would have allowed a scope id that matched no row, and a limit on nothing
/// is indistinguishable from no limit until somebody spends against it.
///
/// `account` rather than `workspace`: BYOK ownership is the account, so there
/// is no workspace entity for a scope to point at.
model QuotaScope {
  id        String @id @default(cuid())
  /// credential | endpoint_credential | deployment_credential | account | provider
  scopeKind String

  /// Set on `credential`, `endpoint_credential` and `deployment_credential`.
  credentialBindingId String?
  /// Set on `endpoint_credential`.
  providerEndpointId  String?
  /// Set on `deployment_credential`.
  modelDeploymentId   String?
  /// Set on `account`.
  accountId           String?
  /// Set on `provider`.
  providerId          String?

  createdAt DateTime @default(now())

  credentialBinding  CredentialBinding?     @relation(fields: [credentialBindingId], references: [id], onDelete: Cascade, onUpdate: Restrict)
  endpoint           ProviderEndpoint?      @relation(fields: [providerEndpointId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  deployment         ModelDeployment?       @relation(fields: [modelDeploymentId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  account            User?                  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  provider           ProviderRegistryEntry? @relation(fields: [providerId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  quotaCapacityState QuotaCapacityState?

  @@index([scopeKind])
}

/// A credential's access to an endpoint, and who pays for it.
///
/// Dark. Deliberately not part of deployment identity: one deployment is
/// reachable by several credentials -- Tomverse's own and an account's -- and
/// folding the credential in would split quality, version and health samples
/// by key count, which is a measurement problem rather than a modelling one.
///
/// The secret itself is never here. `secretRef` names where it lives.
model CredentialBinding {
  id                      String   @id @default(cuid())
  providerEndpointId      String
  /// Where the secret actually lives. Never the secret.
  secretRef               String
  /// tomverse | account
  billingOwner            String
  /// Set when `billingOwner` is `account`. The account whose key this is.
  accountId               String?
  /// Which Tomverse provider-budget account this spends against.
  ///
  /// Stable across key rotation, which a credential id is not: rotating a key
  /// must not reset a spend total.
  ///
  /// **No foreign key, because the table it should point at does not exist.**
  /// Not `User` -- that is `accountId`, and a Tomverse-funded row leaves it
  /// null. Not `ProviderRegistryEntry` -- that is the provider, not a budget
  /// account, and the whole reason for this column is to survive a key
  /// rotation the provider does not know about. So it carries the same hole
  /// this schema refused for quota scopes: a name that may point at nothing.
  ///
  /// It is harmless while the column is unread. The first writer that passes
  /// this string to `incrementUsage` creates a spend bucket under whatever it
  /// happens to contain, so a `ProviderBudgetAccount` table and a foreign key
  /// come before that, not after.
  providerBudgetAccountId String?
  status                  String   @default("disabled")
  /// When the referenced secret was last rotated. Null means not recorded.
  lastRotatedAt           DateTime?
  /// When the referenced secret expires. Null is not an invented lifetime.
  expiresAt               DateTime?
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  endpoint ProviderEndpoint @relation(fields: [providerEndpointId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  account  User?            @relation(fields: [accountId], references: [id], onDelete: Cascade)

  quotaScopes QuotaScope[]

  @@index([providerEndpointId, status])
  @@index([accountId])
}

/// Why each candidate was or was not chosen, frozen at decision time.
///
/// Dark. `RoutingRun.rejectedByReason` records counts per reason, on the
/// stated ground that which models were refused is stable catalogue
/// information a reader can reconstruct. It is not: candidates come from the
/// runtime registry, where `enabled`, `catalogDeleted`, `minimumPlan`, the
/// context window and backend readiness all move, and the health and credit
/// verdicts are that moment's state. Nothing about a past decision can be
/// rebuilt from a count.
///
/// One row per candidate, and it records the eligible ones too -- a table that
/// held only rejections could not answer why a model that passed every filter
/// still lost, which is the question it exists for.
///
/// Content-free: identifiers, a fixed reason, a rank. No prompt, no balance,
/// no provider text.
model RoutingCandidateVerdict {
  id                      String   @id @default(cuid())
  routingRunId            String
  /// The product model, which is what a person selects.
  logicalModelId          String
  /// The placement, once deployments route. Null while nothing has one.
  modelDeploymentId       String?
  /// eligible | rejected
  verdict                 String
  /// A fixed `CandidateRejection`. Null exactly when the verdict is eligible.
  reason                  String?
  /// Where this candidate came in the ranking. Null when it was rejected.
  rank                    Int?
  /// The bucket the ranking put it in, so a tie is legible as a tie.
  rankBucket              Int?
  /// The decision inputs as they stood, so health and cost do not have to be
  /// reconstructed from tables that have since moved.
  decisionInputSnapshotId String?
  createdAt               DateTime @default(now())

  /// Denormalised from the parent so this is a data domain in its own right.
  ///
  /// The registry sweep decides a table holds user data from a User relation
  /// or a `*userId` column, and it is symmetric -- it refuses a registry row
  /// for a model the schema does not show holding any. Reaching a person
  /// through the parent was not enough, and the same note sits beside
  /// RoutingAttempt and ContextManifest for the same reason.
  ///
  /// Nullable because a guest has no account row. Cascade rather than
  /// SetNull: what is left after a null userId still names the person.
  userId String?

  run  RoutingRun @relation(fields: [routingRunId], references: [id], onDelete: Cascade)
  user User?      @relation(fields: [userId], references: [id], onDelete: Cascade)

  // The uniqueness is two partial indexes in the migration, which Prisma
  // cannot express: PostgreSQL treats NULLs as distinct, so one index over the
  // three columns would accept two rows for the same model with no deployment.
  @@index([routingRunId, verdict])
  @@index([reason])
}

/// How much room a quota scope has left, right now.
///
/// Dark. Capacity, not health, and the separation is the point of the table:
/// a 429 says this key is spending too fast, and a 5xx says the provider could
/// not serve the request. Today both increment one counter
/// (`ProviderHealthState.consecutiveFailures`), so a peak-hour rate limit
/// marches a healthy provider toward a breaker and pushes its traffic onto a
/// fallback that is about to hit the same wall.
///
/// Nothing here reaches provider health, and nothing in provider health
/// reaches here.
///
/// One row per scope: the scope already says what is being counted, and a
/// second row would be a second answer to how much is left.
model QuotaCapacityState {
  id           String @id @default(cuid())
  quotaScopeId String @unique

  /// How many rate-limit answers this scope has had in the current window.
  rateLimitedCount Int       @default(0)
  /// When the window those counts belong to started.
  windowStartedAt  DateTime?

  /// What the provider asked us to wait until, when it said so.
  ///
  /// Read from `Retry-After` when a provider sends one. The chat path does not
  /// read that header today, which is why this can only be filled by the work
  /// that starts reading it.
  retryAfterUntil DateTime?

  /// How long this scope stays at the back of the queue.
  ///
  /// An expiry, not a counter -- which is the difference from health. A
  /// demotion that ends by itself cannot leave a scope permanently behind
  /// because of one busy afternoon, and there is no recovery probe to write.
  deprioritizeUntil DateTime?

  /// Requests this scope may have in flight, and has.
  ///
  /// Null and zero are different answers. Null is no declared limit -- the
  /// provider never told us one and nothing here may invent it. Zero is a
  /// declared limit of none, which is how a scope is held closed without
  /// deleting it. A reader that treats null as zero stops every scope whose
  /// provider is simply quiet about concurrency.
  concurrencyLimit Int?
  concurrencyInUse Int  @default(0)

  /// Tokens left in a local bucket, when one is being kept.
  tokenBucketRemaining  Int?
  tokenBucketRefilledAt DateTime?

  updatedAt DateTime @updatedAt

  scope QuotaScope @relation(fields: [quotaScopeId], references: [id], onDelete: Cascade, onUpdate: Restrict)

  @@index([deprioritizeUntil])
  @@index([retryAfterUntil])
}

/// One availability observation, written once and never rewritten.
///
/// Dark. The canonical record the deployment, endpoint and provider rollups
/// are derived from. `eventId` stops the same observation being inserted
/// twice. Which grain has already applied it is
/// `AvailabilityRollupApplication`, not this row. Nothing writes either
/// table yet.
///
/// Today the same fact is written twice in two shapes: real traffic increments
/// `ProviderHealthState` and a probe inserts a `ProviderProbeResult`, with no
/// identifier in common. Neither is deleted or changed by this table; it is
/// the grain the routing work needs and they are the grain the public status
/// page and the operator recovery path already read.
model AvailabilityObservation {
  id      String @id @default(cuid())
  /// The idempotency key. A projection applies an event at most once.
  eventId String @unique

  /// real_traffic | synthetic_probe | operator_verification
  ///
  /// Three streams, kept apart for the reason `ProviderHealthState` already
  /// keeps them apart in columns: an operator proving the API answers is not
  /// the same claim as "real user traffic is being served".
  source String

  /// Null until deployments route. Nothing is backfilled: a past observation
  /// genuinely had no deployment, and inventing one would be a claim nobody
  /// made.
  modelDeploymentId  String?
  providerEndpointId String?
  /// The gateway provider, which is knowable for every observation.
  provider           String

  /// succeeded | failed
  outcome    String
  /// A fixed `RoutingAttemptErrorClass`, or null on success.
  errorClass String?
  latencyMs  Int?

  observedAt DateTime
  createdAt  DateTime @default(now())

  /// The foreign keys this table should have had when it was added. Without
  /// them the two columns accept an id matching no row, and an observation
  /// attributed to nothing is indistinguishable from one attributed to
  /// something until somebody joins.
  observedEndpoint   ProviderEndpoint? @relation(fields: [providerEndpointId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  observedDeployment ModelDeployment?  @relation(fields: [modelDeploymentId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([provider, observedAt])
  @@index([providerEndpointId, observedAt])
  @@index([modelDeploymentId, observedAt])
  @@index([source, observedAt])

  rollupApplications AvailabilityRollupApplication[]
}

/// One grain of one observation, applied at most once.
///
/// Dark. The observation row stops a second insert of the same event. It does
/// not say whether the deployment rollup, the endpoint rollup, and the
/// provider rollup have each been updated. This row is that record. Re-running
/// a projection is safe only when it refuses a triple already stored here.
/// Nothing writes it yet.
model AvailabilityRollupApplication {
  id        String   @id @default(cuid())
  /// The observation's event id, not its row id.
  eventId   String
  /// deployment | endpoint | provider. The same list as the observation grains.
  grain     String
  /// The deployment id, endpoint id, or provider name this grain names.
  targetId  String
  appliedAt DateTime @default(now())

  observation AvailabilityObservation @relation(fields: [eventId], references: [eventId], onDelete: Restrict, onUpdate: Restrict)

  @@unique([eventId, grain, targetId])
}

/// A deployment-grain price observation.
///
/// Dark. This is not `ChatCreditReservation.pricingSnapshot`, and nothing
/// inserts a row. `amount` is one named rate of `currency` per million
/// tokens. Unknown knowledge has no amount. A stated estimate or a
/// verified price names its amount, currency, source and effective time,
/// and the amount must fit DECIMAL(20,8) without rounding. The two applied
/// flags cannot be true: using the row for routing or for a credit charge
/// is a separate approval.
model DeploymentPriceSnapshot {
  id                 String    @id @default(cuid())
  modelDeploymentId  String
  /// Copied at record time. The deployment row can be renamed later.
  logicalModelId     String
  /// unknown | estimate | verified
  knowledge          String
  /// input | output | cache_read | cache_write
  rateKind           String
  /// per_million_tokens
  unit               String
  amount             Decimal?  @db.Decimal(20, 8)
  currency           String?
  source             String?
  effectiveAt        DateTime?
  appliedToRouting   Boolean   @default(false)
  appliedToBilling   Boolean   @default(false)
  createdAt          DateTime  @default(now())

  deployment ModelDeployment @relation(fields: [modelDeploymentId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([modelDeploymentId, effectiveAt])
}

/// One internal experiment's cost ceiling, in micro-USD.
///
/// Not a credit balance and not a provider-wide budget. There is no default
/// amount: a missing row is not permission to call a provider. `spentMicroUsd`
/// is cost already kept. `reservedMicroUsd` is the sum of holds whose cost is
/// not final. Settlement may record more than the limit, because that cost
/// has already been incurred; the next reservation then fails.
model PinnedDeploymentExperiment {
  id               String   @id
  limitMicroUsd    BigInt
  spentMicroUsd    BigInt   @default(0)
  reservedMicroUsd BigInt   @default(0)
  createdAt        DateTime @default(now())

  holds PinnedDeploymentExperimentHold[]
}

/// One call's claim on an experiment ceiling.
///
/// `deploymentId` is the identifier returned when the placement row was
/// stored. It is not a relation. A relation here would make ordinary nested
/// reads look like reads of the still-dark deployment table.
///
/// `released` means the provider call was confirmed not to have started.
/// `occupied` keeps the reservation after dispatch when the cost is unknown.
/// `settled` is a measured cost. Unknown is not stored as zero.
model PinnedDeploymentExperimentHold {
  id               String    @id
  experimentId     String
  deploymentId     String
  logicalModelId   String
  reservedMicroUsd BigInt
  settledMicroUsd  BigInt?
  /// held | settled | released | occupied
  status           String
  createdAt        DateTime  @default(now())
  closedAt         DateTime?

  experiment PinnedDeploymentExperiment @relation(fields: [experimentId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([experimentId, status])
}
