generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ==========================================
// ==========================================

model User {
  id                            String        @id @default(cuid())
  name                          String?
  email                         String?       @unique
  emailVerified                 DateTime?
  image                         String?
  plan                          String        @default("Free") // "Free", "Pro", "Max"
  stripeCustomerId              String?       @unique
  stripeSubscriptionId          String?       @unique
  stripePriceId                 String?
  subscriptionStatus            String?
  subscriptionCurrentPeriodEnd  DateTime?
  subscriptionBillingInterval   String?
  subscriptionCancelAtPeriodEnd Boolean       @default(false)
  /// When the stored subscription state was read from Stripe. Webhooks arrive
  /// out of order, so a snapshot read before this is refused rather than
  /// reverting the account to an older plan. See lib/stripeWebhookSyncCore.ts.
  subscriptionSyncedAt          DateTime?
  creditDebtCredits             Int           @default(0)
  creditDebtCostMicroUsd        BigInt        @default(0)
  billingRiskStatus             String        @default("normal")
  billingRiskReason             String?
  billingRiskAt                 DateTime?
  accountStatus                 String        @default("active")
  accountSuspendedAt            DateTime?
  accountSuspendedUntil         DateTime?
  accountSuspensionReason       String?
  accountSuspendedById          String?
  accountSuspendedByEmail       String?
  aiUsageRestricted             Boolean       @default(false)
  aiUsageRestrictedAt           DateTime?
  aiUsageRestrictedUntil        DateTime?
  aiUsageRestrictionReason      String?
  aiUsageRestrictedById         String?
  aiUsageRestrictedByEmail      String?
  securityIncidentNote          String?
  // Session-invalidation epoch. Sessions use the JWT strategy, so there is no
  // server-side session row to delete; any token issued at or before this
  // instant is rejected. Bumped by revokeAllUserSessions().
  sessionsRevokedAt             DateTime?
  accountDeletionRequestedAt    DateTime?
  accountDeletionScheduledFor   DateTime?
  lastLoginAt                   DateTime?
  createdAt                     DateTime?     @default(now())
  emailLoginEnabled             Boolean       @default(true)
  sessionsInvalidatedAt         DateTime?
  settings                      UserSettings?

  accounts                           Account[]
  sessions                           Session[]
  projects                           ConversationProject[]
  refundRequests                     RefundRequest[]
  promotionRedemptions               BillingPromotionRedemption[]
  billingTransactions                BillingTransaction[]
  creditPurchases                    CreditPurchase[]
  creditLots                         CreditLot[]
  creditLedgerEntries                CreditLedgerEntry[]
  creditDebtEntries                  CreditDebtEntry[]
  chatCreditReservations             ChatCreditReservation[]
  imageGenerations                   ImageGeneration[]
  imageGenerationGroups              ImageGenerationGroup[]
  imageCreditReservations            ImageCreditReservation[]
  memoryExtractionCreditReservations MemoryExtractionCreditReservation[]
  adminAuditLogs                     AdminAuditLog[]
  adminNotes                         AdminNote[]
  modelOverrides                     ModelOverride[]
  conversations                      Conversation[]
  comparisonReviews                  ComparisonReview[]
  productAnalyticsEvents             ProductAnalyticsEvent[]
  privacyRequests                    PrivacyRequest[]
  planChangeRequests                 PlanChangeRequest[]
  externalImports                    ExternalImport[]
  memoryItems                        MemoryItem[]
  memoryExtractionRuns               MemoryExtractionRun[]
  routingRuns                        RoutingRun[]
  memorySettings                     UserMemorySettings?
  accountDataExportRequests          AccountDataExportRequest[]

  @@index([plan, id])
  @@index([createdAt])
  @@index([subscriptionStatus, subscriptionCurrentPeriodEnd])
  @@index([subscriptionCancelAtPeriodEnd, subscriptionStatus])
  @@index([billingRiskStatus])
  @@index([accountStatus, accountSuspendedUntil])
  @@index([accountStatus, accountDeletionScheduledFor])
  @@index([aiUsageRestricted, aiUsageRestrictedUntil])
  @@index([creditDebtCredits])
  @@index([creditDebtCostMicroUsd])
}

model UserSettings {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  theme                   String    @default("dark") // "dark", "light", "system"
  language                String    @default("en") // "ko", "en"
  defaultModel            String    @default("gpt-5-6-luna")
  // 1-3 model IDs a signed-in account starts a new conversation with.
  // NULL (never a schema default, never backfilled) means [defaultModel];
  // lib/newConversationModels.ts is the only interpreter. See
  // docs/policy/default-model-luna-migration.md §1.2.
  newConversationModelIds Json?
  preferredTasks          Json?
  preferredPriority       String?
  usesFilesFrequently     String?
  modelFinderCompletedAt  DateTime?
  modelFinderDismissedAt  DateTime?
  timeZone                String    @default("UTC")
  timeZoneInitializedAt   DateTime?
  timeZoneChangedAt       DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  createdAt    DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expires])
  @@index([userId, createdAt])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// Passwordless email login: one row per outstanding "we sent you a code and
// a link" request. Not related to VerificationToken above (that table's
// token column is globally unique, a poor fit for a human-typed 6-digit
// code, and it has no consumed/invalidated columns for single-use +
// explicit-invalidation semantics). No relation to User: at request time the
// email may not correspond to any existing account yet.
model EmailLoginAttempt {
  id            String    @id @default(cuid())
  email         String
  codeHash      String
  linkTokenHash String    @unique
  expiresAt     DateTime
  consumedAt    DateTime?
  invalidatedAt DateTime?
  createdAt     DateTime  @default(now())

  @@index([email, consumedAt, invalidatedAt, expiresAt])
  @@index([expiresAt])
}

// ==========================================
// ==========================================

model Conversation {
  id        String  @id @default(cuid())
  userId    String
  title     String
  projectId String?

  // "chat" | "image". Server-decided: the conversation create endpoint's
  // strict schema never accepts it, and an "image" row is only ever created
  // inside the image generation reservation transaction, so an image
  // conversation cannot exist without at least one ImageGeneration (audited
  // by lib/imageAssetLifecycle.ts). See docs/policy/image-generation.md.
  kind String @default("chat")

  /// Per-conversation memory mode (import/memory policy §8.1 invariant 1):
  /// "inherit" | "on" | "off" — allowlist CHECK lives in the migration.
  /// Server-stored and server-decided; "inherit" resolves to the account
  /// default, and no mode can override the account master toggle, the
  /// feature flag, revocation, or ownership checks.
  memoryMode String @default("inherit")

  // For kind = "image" this is stored as "[]" and never read: the image
  // model comes from the image generation server layer's fixed allowlist,
  // not from conversation state.
  selectedModels String @default("[\"gpt-5-6-luna\"]")
  disabledPanels String @default("[]")
  webSearchMode  String @default("off") // off | auto | always

  shareToken     String?   @unique
  shareEnabled   Boolean   @default(false)
  sharedAt       DateTime?
  shareSnapshot  Json?
  shareExpiresAt DateTime?
  shareRevokedAt DateTime?

  messages              Message[]
  comparisonReviews     ComparisonReview[]
  imageGenerations      ImageGeneration[]
  imageGenerationGroups ImageGenerationGroup[]
  user                  User?                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  project               ConversationProject?   @relation(fields: [projectId], references: [id], onDelete: SetNull)
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  password              String?
  importedGuestKey      String?

  @@unique([userId, importedGuestKey])
  @@index([userId, projectId])
  @@index([userId, kind])
}

model ConversationProject {
  id            String         @id @default(cuid())
  userId        String
  name          String
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversations Conversation[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@unique([userId, name])
  @@index([userId, updatedAt])
}

model Message {
  id              String                  @id @default(cuid())
  role            String
  content         String
  status          String                  @default("normal")
  modelId         String?
  pendingJobId    String?
  searchMetadata  Json?
  providerContext MessageProviderContext?

  /// How much account memory this answer's prompt carried. §8.1 invariant 4
  /// forbids storing the injected context as a Message row and explicitly
  /// permits the used count and non-sensitive aggregate metadata, which is
  /// all this is — the memory text is never written here. NULL means no §10
  /// context bundle accompanied the request, so memory was not possible;
  /// 0 means a bundle was verified and retrieval selected nothing.
  ///
  /// The day counters in lib/memoryMetricsCore.ts already report the
  /// injection ratio. This is the thing a counter cannot give: attribution
  /// per answer, which §22's follow-up proxy needs to compare the answers
  /// memory shaped against the ones it did not.
  memoryUsedCount Int?
  memoryTokens    Int?

  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())

  @@index([conversationId])
  /// §22's follow-up proxy reads answers by time window across every
  /// conversation; without this it scans the whole table.
  @@index([createdAt])
}

// Provider-private assistant state needed to replay reasoning models exactly
// (for example Kimi's reasoning_content and Anthropic thinking signatures).
// Kept in a separate table so ordinary conversation queries and exports can
// never expose it through a broad Message selection.
model MessageProviderContext {
  messageId        String   @id
  message          Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  modelId          String
  provider         String
  responseMessages Json
  createdAt        DateTime @default(now())

  @@index([modelId])
}

model ComparisonReview {
  id                  String       @id @default(cuid())
  userId              String
  user                User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversationId      String
  conversation        Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  promptMessageId     String
  assistantMessageIds Json
  reviewerModelId     String
  reviewMode          String
  promptVersion       String
  result              Json
  usageCredits        Int
  inputHash           String
  isStale             Boolean      @default(false)
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  @@unique([userId, inputHash])
  @@index([conversationId, createdAt])
  @@index([conversationId, isStale])
}

model ProductAnalyticsEvent {
  id              String   @id @default(cuid())
  dedupeKey       String   @unique
  eventName       String
  source          String
  userId          String?
  user            User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  anonymousIdHash String
  sessionIdHash   String
  utmSource       String
  utmMedium       String
  utmCampaign     String
  language        String
  country         String
  modelCount      Int
  plan            String
  properties      Json?
  occurredAt      DateTime @default(now())
  createdAt       DateTime @default(now())

  @@index([eventName, occurredAt])
  @@index([userId, occurredAt])
  @@index([anonymousIdHash, occurredAt])
  @@index([utmSource, utmCampaign, occurredAt])
}

model ChatUsageBucket {
  key         String
  period      String
  periodStart DateTime
  // BigInt, not Int: this counter also carries the micro-USD operational cost
  // guardrails, whose limits are derived from the plan's credit grant and pass
  // int4 for any plan above ~8,590 monthly credits (the Max default is
  // 10,000). See 20260801130000_widen_chat_usage_bucket_count.
  count       BigInt   @default(0)
  updatedAt   DateTime @updatedAt

  @@id([key, period, periodStart])
  @@index([updatedAt])
}

model ProviderErrorEvent {
  id             String   @id @default(cuid())
  provider       String
  modelId        String?
  phase          String
  diagnosticCode String
  traceId        String
  errorName      String?
  errorCode      String?
  httpStatus     Int?
  retryable      Boolean?
  message        String?
  createdAt      DateTime @default(now())

  @@index([provider, createdAt])
  @@index([provider, diagnosticCode, createdAt])
  @@index([modelId, createdAt])
  @@index([traceId])
}

// One row per provider, updated atomically on every recordProviderSuccess/
// recordProviderFailure call. Unlike ChatUsageBucket's day/5-minute counters
// (which reset on their own schedule and can't tell "no traffic since
// midnight" apart from "no traffic in months"), this is the durable source
// of truth for "when did we last actually hear from this provider" -- it's
// what the public status page's freshness check is computed from.
model ProviderHealthState {
  provider                  String    @id
  lastSuccessAt             DateTime?
  lastFailureAt             DateTime?
  consecutiveFailures       Int       @default(0)
  // AUD-R001: synthetic-probe evidence, kept in separate fields from the
  // real-user-traffic ones above so the two evidence streams never
  // overwrite each other -- recordProviderProbeSuccess/Failure only ever
  // touch these three, recordProviderSuccess/Failure only ever touch the
  // three above. lib/providerPublicStatusCore.ts merges both explicitly.
  lastProbeSuccessAt        DateTime?
  lastProbeFailureAt        DateTime?
  consecutiveProbeFailures  Int       @default(0)
  // STG-R002: administrator-triggered live verification evidence. A third
  // stream again, for the same reason: an operator proving the API answers is
  // not the same claim as "real user traffic is being served", so it must
  // never be written into lastSuccessAt. lib/providerPublicStatusCore.ts
  // merges it explicitly under its own reason codes.
  lastVerificationSuccessAt DateTime?
  lastVerificationFailureAt DateTime?
  // When the blocking consecutiveFailures counter was last cleared by a
  // verified recovery, and the ProviderHealthCheck row that authorised it.
  // Recovery is only ever performed against a successful verification, so this
  // id is the audit trail linking "the block was lifted" to "here is the call
  // that proved it was safe to lift".
  lastRecoveryAt            DateTime?
  lastRecoveryCheckId       String?
  updatedAt                 DateTime  @updatedAt

  @@index([lastSuccessAt])
  @@index([lastProbeSuccessAt])
}

// One row per (provider, model) synthetic probe attempt (AUD-R001). Distinct
// from ProviderHealthCheck, which is an admin-triggered manual "is the API
// key configured" check that never calls a provider live -- this table is
// the automated scheduled prober's own attempt log. Deliberately excludes
// anything sensitive: no API keys, no raw provider response body, no stack
// traces, no user content -- enforced by the row-builder never receiving
// those values in the first place (see lib/providerProbe.ts), and checked
// by a static-scan unit test.
model ProviderProbeResult {
  id                  String   @id @default(cuid())
  /// The owning ScheduledJobRun.id for this probe cycle.
  runId               String
  provider            String
  modelId             String
  environment         String
  startedAt           DateTime
  completedAt         DateTime
  success             Boolean
  timedOut            Boolean  @default(false)
  latencyMs           Int?
  /// Public-safe classification only, e.g. "TIMEOUT" | "AUTH" | "RATE_LIMIT" |
  /// "SERVER_ERROR" | "NETWORK" | "UNKNOWN" -- never a raw provider message.
  errorClassification String?
  /// Sanitized diagnostic code in the same shape providerDiagnosticCode()
  /// produces (e.g. "PROVIDER_PROBE_FAILED.ECONNRESET.HTTP_503.RETRYABLE").
  diagnosticCode      String?
  createdAt           DateTime @default(now())

  @@index([provider, createdAt])
  @@index([provider, modelId, createdAt])
  @@index([runId])
}

// One in-flight chat response. Counted to enforce concurrency, never to bill.
//
// `subjectKey` is the individual caller (an account, or a *signed guest
// cookie* -- not an IP). `ipKey` is carried alongside so the same row can also
// be counted for the anonymous aggregate abuse ceiling without a second row
// and without a second thing to release. See lib/chatConcurrencyCore.ts.
//
// A row with `claimedAt = NULL` is a slot reserved by the aggregate comparison
// preflight and not yet consumed by its model request; it expires quickly on
// its own if the browser never sends the request.
model ChatRequestLease {
  id              String    @id
  subjectKey      String
  ipKey           String?
  admissionId     String?
  modelId         String?
  claimedAt       DateTime?
  heartbeatAt     DateTime  @default(now())
  expiresAt       DateTime
  createdAt       DateTime  @default(now())
  // Per-minute request capacity the aggregate preflight paid for this slot, so
  // an admission that is rolled back can hand it straight back instead of
  // holding it for the rest of the minute. Separate from `ipKey`, which is the
  // IP *concurrency* scope and exists for guests only: the per-minute IP rate
  // ceiling applies to signed-in callers too, and merging the two would make
  // an account consume the anonymous concurrency ceiling.
  rateIpKey       String?
  rateMinuteStart DateTime?

  @@index([subjectKey, expiresAt])
  @@index([ipKey, expiresAt])
  @@index([admissionId])
  @@index([expiresAt])
}

// Why one chat request was allowed or refused by a credit/cost limit, keyed by
// the Trace ID the user is shown. Carries no prompt text and no message
// content: the subject is the same hashed usage key the rate limiter uses, and
// the rest is the pricing and allowance arithmetic behind the decision.
model ChatLimitDecisionEvent {
  id                        String    @id @default(cuid())
  traceId                   String
  subjectKey                String
  userId                    String?
  plan                      String
  phase                     String
  decision                  String
  errorCode                 String?
  limitLayer                String?
  limitScope                String?
  modelIds                  String[]
  enabledTools              String[]
  estimatedInputTokens      Int       @default(0)
  estimatedOutputTokens     Int       @default(0)
  estimatedCostMicroUsd     BigInt    @default(0)
  pricingVersions           String[]
  models                    Json
  requiredCredits           Int?
  availableCredits          Int?
  usedAllowanceMicroUsd     BigInt?
  requiredAllowanceMicroUsd BigInt?
  limitMicroUsd             BigInt?
  timeZone                  String    @default("UTC")
  resetAt                   DateTime?
  createdAt                 DateTime  @default(now())

  @@index([traceId])
  @@index([createdAt])
  @@index([userId, createdAt])
  @@index([subjectKey, createdAt])
}

model BillingPlan {
  id                  String   @id
  name                String
  tier                String
  monthlyPriceCents   Int
  currency            String   @default("USD")
  stripeProductId     String?
  stripePriceId       String?
  annualPriceCents    Int?
  stripeAnnualPriceId String?
  dailyMessageLimit   Int      @default(0)
  monthlyMessageLimit Int      @default(0)
  maxModels           Int      @default(3)
  allowAttachments    Boolean  @default(true)
  allowSharing        Boolean  @default(true)
  allowDownloads      Boolean  @default(true)
  isActive            Boolean  @default(true)
  sortOrder           Int      @default(0)
  metadata            Json?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([tier])
  @@index([isActive, sortOrder])
}

model BillingPromotion {
  id                    String                       @id @default(cuid())
  code                  String                       @unique
  discountPercent       Int                          @default(0)
  discountAmountCents   Int?
  maxRedemptions        Int?
  redeemedCount         Int                          @default(0)
  durationMonths        Int
  fulfillmentType       String                       @default("stripe_subscription")
  accessDurationDays    Int?
  appliesToPlanIds      String                       @default("[]")
  stripeCouponId        String?
  stripePromotionCodeId String?
  startsAt              DateTime?
  endsAt                DateTime?
  allowAnnualStacking   Boolean                      @default(false)
  isActive              Boolean                      @default(true)
  createdAt             DateTime                     @default(now())
  updatedAt             DateTime                     @updatedAt
  redemptions           BillingPromotionRedemption[]

  @@index([isActive])
  @@index([startsAt, endsAt])
}

model BillingPromotionRedemption {
  id                           String           @id @default(cuid())
  promotionId                  String
  promotion                    BillingPromotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  userId                       String
  user                         User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  planId                       String
  billingInterval              String
  stripeCheckoutSessionId      String?          @unique
  stripeSubscriptionId         String?
  clientIpHash                 String?
  paymentMethodFingerprintHash String?
  riskFlags                    String           @default("[]")
  accessStartsAt               DateTime?
  accessEndsAt                 DateTime?
  reminderSentAt               DateTime?
  expiredAt                    DateTime?
  expiryNoticeSentAt           DateTime?
  redeemedAt                   DateTime         @default(now())
  createdAt                    DateTime         @default(now())
  updatedAt                    DateTime         @updatedAt

  @@unique([promotionId, userId])
  @@index([promotionId, redeemedAt])
  @@index([promotionId, clientIpHash, redeemedAt])
  @@index([promotionId, paymentMethodFingerprintHash, redeemedAt])
  @@index([userId, redeemedAt])
  @@index([accessEndsAt, reminderSentAt])
  @@index([accessEndsAt, expiredAt])
}

model BillingTransaction {
  id                      String   @id @default(cuid())
  userId                  String?
  user                    User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  productType             String
  productId               String
  billingInterval         String?
  stripeCheckoutSessionId String   @unique
  stripePaymentIntentId   String?
  stripeSubscriptionId    String?
  amountPaidMinor         Int
  currency                String
  amountPaidUsdMicroUsd   BigInt
  usdConversionRate       String?
  usdConversionSource     String
  pricingVersion          Int      @default(1)
  status                  String   @default("paid")
  paidAt                  DateTime
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  @@index([userId, paidAt])
  @@index([productType, paidAt])
  @@index([currency, paidAt])
  @@index([stripePaymentIntentId])
  @@index([stripeSubscriptionId])
}

model CreditPurchase {
  id                         String              @id @default(cuid())
  userId                     String
  user                       User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  packId                     String
  stripeCheckoutSessionId    String              @unique
  stripePaymentIntentId      String?             @unique
  stripeChargeId             String?             @unique
  creditsPurchased           Int
  fundedCostMicroUsd         BigInt
  amountPaidCents            Int
  amountPaidUsdMicroUsd      BigInt              @default(0)
  refundedAmountCents        Int                 @default(0)
  revokedCredits             Int                 @default(0)
  revokedCostMicroUsd        BigInt              @default(0)
  unrecoveredCredits         Int                 @default(0)
  unrecoveredCostMicroUsd    BigInt              @default(0)
  stripeDisputeId            String?             @unique
  disputeStatus              String?
  disputeAmountCents         Int                 @default(0)
  disputeRevokedCredits      Int                 @default(0)
  disputeRevokedCostMicroUsd BigInt              @default(0)
  disputeDebtCredits         Int                 @default(0)
  disputeDebtCostMicroUsd    BigInt              @default(0)
  disputeOffsetCredits       Int                 @default(0)
  disputeOffsetCostMicroUsd  BigInt              @default(0)
  currency                   String              @default("USD")
  status                     String              @default("paid")
  purchasedAt                DateTime            @default(now())
  expiresAt                  DateTime
  createdAt                  DateTime            @default(now())
  updatedAt                  DateTime            @updatedAt
  lots                       CreditLot[]
  ledgerEntries              CreditLedgerEntry[]
  debtEntries                CreditDebtEntry[]

  @@index([userId, purchasedAt])
  @@index([status, purchasedAt])
  @@index([stripePaymentIntentId])
}

model CreditLot {
  id                          String              @id @default(cuid())
  userId                      String
  user                        User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  purchaseId                  String?
  purchase                    CreditPurchase?     @relation(fields: [purchaseId], references: [id], onDelete: SetNull)
  source                      String
  originalCredits             Int
  remainingCredits            Int
  originalFundedCostMicroUsd  BigInt              @default(0)
  remainingFundedCostMicroUsd BigInt              @default(0)
  expiresAt                   DateTime
  status                      String              @default("active")
  createdAt                   DateTime            @default(now())
  updatedAt                   DateTime            @updatedAt
  ledgerEntries               CreditLedgerEntry[]

  @@index([userId, status, expiresAt])
  @@index([purchaseId])
}

model CreditLedgerEntry {
  id                             String          @id @default(cuid())
  userId                         String
  user                           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  creditLotId                    String
  creditLot                      CreditLot       @relation(fields: [creditLotId], references: [id], onDelete: Cascade)
  purchaseId                     String?
  purchase                       CreditPurchase? @relation(fields: [purchaseId], references: [id], onDelete: SetNull)
  type                           String
  creditsDelta                   Int
  fundedCostMicroUsdDelta        BigInt          @default(0)
  balanceAfterCredits            Int
  balanceAfterFundedCostMicroUsd BigInt          @default(0)
  reservationId                  String?
  metadata                       Json?
  createdAt                      DateTime        @default(now())

  @@index([userId, createdAt])
  @@index([creditLotId, createdAt])
  @@index([purchaseId, createdAt])
  @@index([reservationId])
}

model CreditDebtEntry {
  id                       String          @id @default(cuid())
  userId                   String
  user                     User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  purchaseId               String?
  purchase                 CreditPurchase? @relation(fields: [purchaseId], references: [id], onDelete: SetNull)
  type                     String
  creditsDelta             Int
  fundedCostMicroUsdDelta  BigInt          @default(0)
  balanceAfterCredits      Int
  balanceAfterCostMicroUsd BigInt          @default(0)
  metadata                 Json?
  createdAt                DateTime        @default(now())

  @@index([userId, createdAt])
  @@index([purchaseId, createdAt])
  @@index([type, createdAt])
}

model ChatCreditReservation {
  id                       String    @id
  userId                   String?
  user                     User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  subjectKey               String
  traceId                  String
  source                   String
  provider                 String
  modelId                  String
  status                   String    @default("reserved")
  outcome                  String?
  idempotencyKey           String    @unique
  providerRequestId        String?
  providerResponseId       String?
  providerRequestLinkedAt  DateTime?
  reservationPayload       Json
  reservedCredits          Int
  reservedCostMicroUsd     BigInt
  planReservedCredits      Int
  addOnReservedCredits     Int
  settledCredits           Int       @default(0)
  settledCostMicroUsd      BigInt    @default(0)
  settledInputTokens       Int       @default(0)
  settledCachedInputTokens Int       @default(0)
  settledOutputTokens      Int       @default(0)
  pricingSnapshot          Json?
  providerUsageSnapshot    Json?
  expiresAt                DateTime
  settledAt                DateTime?
  reconciledAt             DateTime?
  lastError                String?
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt

  @@index([status, expiresAt])
  @@index([userId, createdAt])
  @@index([traceId])
  @@index([providerRequestId])
  @@index([providerResponseId])
}

// One image generation request in the image work mode: the operational
// record (prompt, pinned provider parameters, lifecycle status). Financial
// numbers live in ImageCreditReservation, which deliberately does NOT
// cascade with this row or its conversation -- deleting a chat must not
// delete the audit trail of what was charged.
// Policy: docs/policy/image-generation.md.
model ImageGeneration {
  id             String @id @default(cuid())
  userId         String
  conversationId String
  idempotencyKey String
  prompt         String
  preset         String // draft | standard | final
  provider       String @default("openai")
  modelId        String @default("gpt-image-2")
  size           String // 1024x1024 | 1536x1024 | 1024x1536
  quality        String // low | medium | high

  // What the returned bytes actually are, read from the file's own header
  // (policy §12.1). Not deducible from `size`: each provider translates a
  // resolution tier its own way, and Google's 1K landscape is not 1536x1024.
  // Nullable and never backfilled -- rows written before this existed are
  // history, and a dimension nobody measured is absent rather than inferred.
  outputWidth  Int?
  outputHeight Int?

  // The parameters this attempt actually sent to the provider (policy §12.1).
  // Reconstructing them from `size`/`quality` stopped being possible once each
  // provider started translating a resolution tier its own way, and a price
  // dispute turns on what was sent, not on what the row implies.
  //
  // The prompt is deliberately NOT in here: it is already on this row, and
  // duplicating user content into an audit blob would create a second place
  // every deletion path has to find.
  providerRequestParams Json?
  backgroundMode        String @default("opaque")
  outputFormat          String @default("png")
  moderationMode        String @default("auto")

  // pending -> processing -> settling -> succeeded | failed. `settling` is
  // the exactly-once claim: the worker or the reconciliation sweep moves a
  // row here with a conditional update before touching the credit ledger,
  // so the two can never settle or refund the same generation twice.
  // Transitions are defined in lib/imageGenerationStateCore.ts.
  status              String  @default("pending")
  failurePhase        String? // provider_moderation_rejected | provider_user_error | provider_rate_limited | provider_failed | original_storage_failed | stale_job_reconciled
  publicErrorCode     String?
  internalErrorDetail String?
  providerRequestId   String?
  leaseId             String?

  // v2 (policy §11): every generation is one execution attempt of a target
  // inside a comparison group. groupId is a denormalized copy of the
  // target's group for query paths; the FK chain runs through targetId.
  groupId             String
  targetId            String
  attemptNumber       Int     @default(1)
  retryOfGenerationId String?
  retryIdempotencyKey String?

  createdAt   DateTime  @default(now())
  startedAt   DateTime?
  completedAt DateTime?
  failedAt    DateTime?
  updatedAt   DateTime  @updatedAt

  user            User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversation    Conversation           @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  target          ImageGenerationTarget  @relation("TargetAttempts", fields: [targetId], references: [id], onDelete: Cascade)
  currentOfTarget ImageGenerationTarget? @relation("TargetCurrentAttempt")
  assets          ImageAsset[]

  @@unique([userId, idempotencyKey])
  @@unique([targetId, retryIdempotencyKey])
  @@index([status, updatedAt])
  @@index([conversationId, createdAt])
  @@index([groupId])
}

// One user action: a prompt fanned out to one or more image models
// (policy §11). Group state is never stored -- it derives from each
// target's current attempt (lib/imageGenerationStateCore.ts).
model ImageGenerationGroup {
  id                  String   @id @default(cuid())
  userId              String
  conversationId      String
  groupIdempotencyKey String
  createdAt           DateTime @default(now())

  user         User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversation Conversation            @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  targets      ImageGenerationTarget[]

  @@unique([userId, groupIdempotencyKey])
  @@index([conversationId, createdAt])
}

// A logical model slot inside a group. Retries append attempts under the
// same target; currentGenerationId moves to the newest attempt in the same
// transaction that creates it (policy §11 two-layer idempotency).
model ImageGenerationTarget {
  id                  String   @id @default(cuid())
  groupId             String
  provider            String
  modelId             String
  currentGenerationId String?  @unique
  createdAt           DateTime @default(now())

  group             ImageGenerationGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  generations       ImageGeneration[]    @relation("TargetAttempts")
  currentGeneration ImageGeneration?     @relation("TargetCurrentAttempt", fields: [currentGenerationId], references: [id], onDelete: SetNull)

  @@unique([groupId, modelId])
}

// A stored object derived from one generation: the untouched provider
// original (provenance metadata preserved -- never re-encoded) and the
// thumbnail derived from it. Thumbnail failure never demotes the original:
// the generation stays succeeded and the thumbnail retries in the
// background.
model ImageAsset {
  id                  String  @id @default(cuid())
  generationId        String
  role                String // original | thumbnail
  // ready | pending | failed. Originals are written as ready; thumbnails
  // start pending and repair in the background.
  status              String  @default("pending")
  r2Key               String  @unique
  mimeType            String
  width               Int
  height              Int
  byteSize            Int
  sha256              String
  provenancePreserved Boolean @default(true)
  thumbnailRetryCount Int     @default(0)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  generation ImageGeneration @relation(fields: [generationId], references: [id], onDelete: Cascade)

  @@unique([generationId, role])
  @@index([status, updatedAt])
}

// DB-first deletion tombstone for R2 objects. Deleting a conversation
// enqueues every attached asset key here in the SAME transaction that
// removes the rows, then the fifteen-minute maintenance sweep deletes the
// R2 objects idempotently and marks the row completed. R2 is never deleted
// before the database knows about it, so a partial failure retries from
// this row instead of leaving the database pointing at missing objects.
model ImageAssetCleanup {
  id          String    @id @default(cuid())
  r2Key       String    @unique
  reason      String // conversation_deleted | account_deleted | storage_rollback
  attempts    Int       @default(0)
  lastError   String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  completedAt DateTime?

  @@index([completedAt, createdAt])
}

// The financial record of one image generation, split from ImageGeneration
// on purpose (mirroring ChatCreditReservation): no conversation or
// generation foreign key, so user-initiated deletion never erases the
// pricing snapshot, the lot-level reservation payload needed for crash
// recovery (settleAddOnCredits requires per-lot entries), or the provider
// request id an audit needs. `generationId` is a plain unique string.
// Status: reserved -> settling -> settled, claimed with a conditional
// update for exactly-once settlement.
model ImageCreditReservation {
  id             String  @id // caller-supplied: image-credit-reservation:{generationId}:v1
  userId         String?
  generationId   String  @unique
  conversationId String?

  status  String  @default("reserved") // reserved | settling | settled
  outcome String? // completed | failed | cancelled

  preset  String
  quality String
  size    String

  // v2 identity snapshot (policy §12/§14): plain strings, never FKs -- this
  // financial record must survive deletion of everything it describes.
  // provider/modelId have no schema default on purpose: v2 code writes them
  // explicitly. identitySource distinguishes rows whose identity was
  // inferred by the v1 backfill from rows recorded at reservation time.
  provider       String
  modelId        String
  groupId        String?
  targetId       String?
  identitySource String  @default("recorded")

  reservedCredits            Int
  planReservedCredits        Int
  addOnReservedCredits       Int
  reservedCostMicroUsd       BigInt
  reservedFundedCostMicroUsd BigInt @default(0)
  settledCredits             Int    @default(0)
  settledCostMicroUsd        BigInt @default(0)
  settledFundedCostMicroUsd  BigInt @default(0)

  pricingVersion     String
  costSource         String
  pricingSnapshot    Json
  // AddOnCreditReservationEntry[] -- the per-lot credits and funded cost
  // reserved by reserveAddOnCredits, preserved so a reconciliation sweep
  // after a crash can refund lot by lot without the in-memory entries.
  reservationPayload Json

  providerRequestId String?
  refundedAt        DateTime?
  settledAt         DateTime?
  reconciledAt      DateTime?
  lastError         String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([userId, createdAt])
}

// Tracks a single Perplexity "sonar-deep-research" async job durably, since
// the request can run well past 30 minutes -- long enough to outlive both
// the request that submitted it and a page refresh. See lib/perplexityDeepResearch.ts
// (submit/poll HTTP calls) and app/api/chat/deep-research/status/route.ts
// (the client-polled endpoint that reads and advances this row).
model PerplexityAsyncJob {
  id                 String    @id @default(cuid())
  perplexityJobId    String    @unique
  conversationId     String
  assistantMessageId String    @unique
  modelId            String
  reservationId      String
  traceId            String
  status             String    @default("submitted") // submitted | in_progress | completed | failed
  resultText         String?
  errorMessage       String?
  submittedAt        DateTime  @default(now())
  lastPolledAt       DateTime?
  completedAt        DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([status, lastPolledAt])
}

model AppSetting {
  key       String   @id
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Feedback {
  id                        String              @id @default(cuid())
  userId                    String?
  email                     String?
  type                      String
  status                    String              @default("open")
  message                   String
  traceId                   String?
  modelId                   String?
  plan                      String?
  hasAttachments            Boolean             @default(false)
  attachmentCount           Int                 @default(0)
  path                      String?
  userAgent                 String?
  /// The submitter's language, captured once at submission and never mutated,
  /// so every lifecycle email for this report renders in the same language.
  /// One of lib/language.ts SUPPORTED_LANGUAGES; "en" when unknown.
  language                  String              @default("en")
  /// Per-report transactional consent to lifecycle status emails. NOT a
  /// marketing preference: it covers only this report's received/reviewing/
  /// completed notifications. Defaults to no consent.
  emailUpdatesConsent       Boolean             @default(false)
  /// How the report was resolved -- one of FEEDBACK_CLOSURE_OUTCOMES in
  /// lib/feedbackLifecycleCore.ts. Current state for the admin console; the
  /// email renders from the immutable completed lifecycle event instead.
  closureOutcome            String?
  /// The short reply written FOR THE SUBMITTER. Never the internal admin note,
  /// and never merged with one.
  userReply                 String?
  /// Outcome of verifying the server-issued errorReportToken -- one of
  /// TOKEN_VERIFICATION_STATUS in lib/errorReportContract.ts. Never the raw
  /// token, which is verified and discarded in the same request.
  errorReportVerification   String?
  /// Where the submitted trace ID came from, as far as it can be proven:
  /// server_generated only when the token verified; otherwise the client's
  /// unauthenticated claim (or null for reports without a trace).
  traceProvenance           String?
  /// Who classified the error code the reporter attached: "server" when it
  /// came from a verified token, "client" for client-side classifications
  /// like EMPTY_RESPONSE. A client classification is never presented as a
  /// server-authenticated fact.
  errorClassificationSource String?
  /// The client-classified error code, kept separate from any server code
  /// inside the verified token payload.
  clientErrorCode           String?
  /// Whether an evidence row exists for a verified report, and if not, why
  /// not -- one of EVIDENCE_AVAILABILITY in lib/errorReportContract.ts.
  evidenceAvailability      String?
  traceEvidenceId           String?
  traceEvidence             TraceErrorEvidence? @relation(fields: [traceEvidenceId], references: [id], onDelete: SetNull)
  createdAt                 DateTime            @default(now())
  updatedAt                 DateTime            @updatedAt

  lifecycleEvents FeedbackLifecycleEvent[]
  autoFixCase     FeedbackAutoFixCase?

  @@index([status, createdAt])
  @@index([type, createdAt])
  @@index([userId, createdAt])
  @@index([traceId])
}

/// One diagnosis-only shadow-mode case per verified bug report (Phase 2 of
/// docs/policy/trace-feedback-automation.md). The case collects evidence,
/// classifies eligibility with the deterministic rules in
/// lib/feedbackAutoFixCore.ts and leaves a bounded diagnostic summary for a
/// human -- it never modifies code, never pushes a branch, never opens a PR.
/// llmConfidence is observational only and stays null in Phase 2.
model FeedbackAutoFixCase {
  id                  String    @id @default(cuid())
  feedbackId          String    @unique
  feedback            Feedback  @relation(fields: [feedbackId], references: [id], onDelete: Cascade)
  traceId             String
  /// Trusted occurrence identity from the verified token, when one existed.
  occurrenceId        String?
  /// errorCode|routeClass|release -- duplicate-spotting only, never identity.
  fingerprint         String?
  sourceRelease       String?
  /// One of AUTOFIX_CASE_STATE; transitions enforced by the core module and
  /// written with compare-and-swap conditional updates.
  state               String    @default("received")
  /// One of AUTOFIX_CLASSIFICATION once classified.
  classification      String?
  ineligibilityReason String?
  /// Reserved for a future LLM diagnosis pass; observational, never a gate.
  llmConfidence       Float?
  /// Bounded technical facts only -- no user text, no prompts, no tokens.
  diagnosticSummary   Json?
  attemptCount        Int       @default(0)
  claimedAt           DateTime?
  heartbeatAt         DateTime?
  /// Doubles as the not-before instant while state = evidence_delayed.
  leaseExpiresAt      DateTime?
  terminalReason      String?
  closedAt            DateTime?
  /// --- Phase 3 (null until a fix attempt runs; docs/policy §9) -----------
  /// feedback-autofix/<case-id> -- the case id, never a raw trace ID.
  fixBranch           String?
  fixPrNumber         Int?
  fixPrUrl            String?
  /// Read back from GitHub after the human-approved merge; never inferred
  /// from enabling auto-merge.
  mergeSha            String?
  stagingSha          String?
  /// The validated Red→Green proof payload (lib/feedbackAutoFixPolicy.ts).
  redGreenProof       Json?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@index([state, leaseExpiresAt])
  @@index([createdAt])
  @@index([fingerprint, sourceRelease])
}

/// Server-side evidence for one error *occurrence* on a server-generated
/// trace. The primary key and the occurrenceId are both server-minted:
/// trace IDs can be client-influenced elsewhere (proxy.ts adopts a client
/// x-request-id; preflight adopts X-Client-Request-ID), so the trace ID is
/// deliberately a non-unique index -- never an identity, never an upsert key.
/// The same trace string may own several rows; feedback links to exactly one
/// via the occurrenceId carried inside the signed errorReportToken.
///
/// Stored fields are the minimum needed for support correlation: no prompt
/// or message bodies, no raw provider payloads, no headers, no tokens.
/// Retention: 30 days, purged by lib/maintenance.ts.
model TraceErrorEvidence {
  id                   String   @id @default(cuid())
  /// Trusted per-occurrence identity minted by the server at error time.
  occurrenceId         String   @unique
  traceId              String
  /// One of TRACE_PROVENANCE in lib/errorReportContract.ts; rows are only
  /// written for server_generated traces today.
  traceProvenance      String
  environment          String
  release              String?
  routeClass           String
  phase                String?
  errorCode            String?
  /// One of ERROR_CLASSIFICATION_SOURCE; always "server" for rows written by
  /// the error builders.
  classificationSource String   @default("server")
  httpStatus           Int?
  provider             String?
  modelId              String?
  retryable            Boolean?
  fingerprint          String?
  sentryEventId        String?
  occurredAt           DateTime @default(now())
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  feedback Feedback[]

  @@index([traceId])
  @@index([release, occurredAt])
  @@index([errorCode, occurredAt])
  @@index([occurredAt])
}

/// One immutable record per lifecycle stage of one feedback report.
///
/// The user-facing status email is rendered from this row, not from the
/// mutable Feedback columns, so a retried delivery presents byte-for-byte the
/// payload the first attempt presented -- which the provider's idempotency key
/// requires. Rows are only ever inserted; the unique constraint is what makes
/// "one email per stage" hold under concurrent admin requests.
model FeedbackLifecycleEvent {
  id             String   @id @default(cuid())
  feedbackId     String
  feedback       Feedback @relation(fields: [feedbackId], references: [id], onDelete: Cascade)
  /// received | reviewing | completed
  stage          String
  previousStatus String?
  newStatus      String
  /// Set on the completed stage only -- one of FEEDBACK_CLOSURE_OUTCOMES.
  outcomeCode    String?
  /// Snapshot of the user-facing reply at closure time. Never the admin note.
  userReply      String?
  /// The admin who made the transition; null for the submission itself.
  actorUserId    String?
  createdAt      DateTime @default(now())

  /// One event -- and therefore at most one user email -- per stage.
  @@unique([feedbackId, stage])
  @@index([feedbackId, createdAt])
}

/// An operator notification that still owes a delivery.
///
/// Written in the same transaction as the record it describes, so a submission
/// that reached the database can never lose its notification to a crash, a
/// provider outage or a missing API key. The body is deliberately NOT stored
/// here: `kind` + `referenceId` point at the source row and the mail is
/// re-rendered at send time, so the reporter's words live in exactly one table
/// and one retention policy.
model NotificationDelivery {
  id            String    @id @default(cuid())
  /// Which notification this is; selects the renderer. e.g. "support_feedback".
  kind          String
  /// The source row this notification describes. e.g. Feedback.id
  referenceId   String
  /// pending | delivered | abandoned
  status        String    @default("pending")
  attempts      Int       @default(0)
  nextAttemptAt DateTime  @default(now())
  lastAttemptAt DateTime?
  /// A short classification such as "http_502" -- never a provider response body.
  lastErrorKind String?
  deliveredAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  /// One queue row per source record: re-submitting the same feedback cannot
  /// enqueue a second notification.
  @@unique([kind, referenceId])
  @@index([status, nextAttemptAt])
  @@index([status, createdAt])
}

model RefundRequest {
  id                           String                       @id @default(cuid())
  userId                       String?
  user                         User?                        @relation(fields: [userId], references: [id], onDelete: SetNull)
  email                        String?
  plan                         String?
  stripeCustomerId             String?
  stripeSubscriptionId         String?
  subscriptionStatus           String?
  subscriptionCurrentPeriodEnd DateTime?
  subscriptionBillingInterval  String?
  reason                       String?
  /// pending | processing | approved | rejected
  ///
  /// `processing` is claimed before the Stripe refund is created and released
  /// or completed after it. It is what makes the money side recoverable: a
  /// crash between Stripe and the local commit leaves the row here rather than
  /// back in `pending`, where a retry would issue a second refund.
  status                       String                       @default("pending")
  /// When the row entered `processing`. Reconciliation only looks at rows that
  /// have been there longer than one request could reasonably take.
  processingStartedAt          DateTime?
  adminNote                    String?
  reviewedByUserId             String?
  stripeRefundId               String?
  stripeRefundStatus           String?
  stripeChargeId               String?
  refundAmountCents            Int?
  refundCurrency               String?
  requestedAt                  DateTime                     @default(now())
  reviewedAt                   DateTime?
  updatedAt                    DateTime                     @updatedAt
  timelineEvents               RefundRequestTimelineEvent[]

  @@index([status, processingStartedAt])
  @@index([status, requestedAt])
  @@index([userId, requestedAt])
  @@index([email])
}

model RefundRequestTimelineEvent {
  id              String        @id @default(cuid())
