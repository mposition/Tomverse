// ==========================================
// External conversation import (Release A).
// Contract: docs/policy/external-conversation-import-and-memory.md §4, §5, §20.
// External conversations never live in Conversation/Message — source model
// labels stay provenance-only and must not reach runtime modelId semantics.
// ==========================================

model ExternalImport {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  provider String // "chatgpt" | "claude" — allowlist CHECK lives in the migration
  status   String @default("inspecting") // inspecting | staging | preview_ready | finalizing | completed | failed | cancelled

  /// Client-sent hint for fast duplicate-candidate detection only. Never an
  /// authoritative dedup input — the server recomputes every digest (§4.1).
  clientFingerprint   String?
  importDigest        String? // server-computed, set at finalize
  digestVersion       Int
  parserVersion       String
  sourceFormatVersion String?

  conversationCount Int     @default(0)
  messageCount      Int     @default(0)
  normalizedBytes   BigInt  @default(0)
  truncationCount   Int     @default(0)
  duplicateCount    Int     @default(0)
  failureCode       String?

  /// Staging batch ledger (§5.5). Batches arrive strictly in sequence; only
  /// the most recent one may be idempotently retried, so one (sequence,
  /// digest) pair is enough to tell a retry from a conflicting resend.
  lastBatchSequence Int     @default(-1)
  lastBatchDigest   String?

  /// Set by the first successful finalize. A retry with the same key and the
  /// same import digest returns the stored success; a different key on a
  /// completed import is EXTERNAL_IMPORT_ALREADY_FINALIZED (§5.5).
  finalizeIdempotencyKey String?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  completedAt DateTime?

  conversations ExternalConversation[]

  @@index([userId, status])
  @@index([userId, createdAt])
  // Staging TTL sweep: stale non-terminal rows are found by last activity
  // (24h idle / 72h absolute, EXTERNAL_IMPORT_STORAGE_LIMITS).
  @@index([status, updatedAt])
}

model ExternalConversation {
  id     String         @id @default(cuid())
  userId String
  import ExternalImport @relation(fields: [importId], references: [id], onDelete: Cascade)

  importId String
  provider String

  /// Stable digest of the provider's own conversation ID (never the raw ID).
  /// Groups immutable snapshots of the same source lineage (§4.2).
  externalStableId String

  title             String
  sourceModelLabels Json?
  sourceCreatedAt   DateTime?
  sourceUpdatedAt   DateTime?

  /// Server-computed over ordered message dedup digests (§4.1). Unique per
  /// account: an exact re-import is a skip, a changed export becomes a new
  /// immutable snapshot row — existing rows are never merged into.
  conversationDigest String
  digestVersion      Int

  messageCount Int
  contentBytes BigInt

  finalized  Boolean  @default(false)
  importedAt DateTime @default(now())

  /// Snapshot lock (§7, release B5). NULL means unlocked; otherwise the same
  /// scrypt hash format `Conversation.password` uses, written and verified by
  /// the same `lib/conversationLock.ts` helpers. Locking a snapshot suspends
  /// the memories it is the last reachable evidence for (§7.1).
  password String?

  messages ExternalMessage[]

  @@unique([userId, conversationDigest])
  @@index([userId, externalStableId])
  @@index([userId, finalized])
  @@index([importId])
}

model ExternalMessage {
  id           String               @id @default(cuid())
  userId       String
  conversation ExternalConversation @relation(fields: [externalConversationId], references: [id], onDelete: Cascade)

  externalConversationId String
  externalStableId       String
  role                   String // "user" | "assistant" — allowlist CHECK lives in the migration

  content       String
  contentDigest String

  /// Digest of the pre-truncation normalized content. The unretained part is
  /// never stored — this digest is the only trace of it (§4.1, §5.4).
  originalContentDigest String?
  digestVersion         Int

  sourceModelLabel String?
  sourceTimestamp  DateTime?
  ordinal          Int

  truncated              Boolean @default(false)
  originalCharacterCount Int?
  retainedCharacterCount Int?

  memoryEvidences MemoryEvidence[]

  @@unique([externalConversationId, ordinal])
  @@index([userId])
}

/// Release B (import/memory policy §8, §20). An account-scoped long-term
/// memory: a normalized declarative statement plus lifecycle state. Nothing
/// here is injected anywhere until the B4 retrieval slice exists, the
/// feature flags are on, and the §12 eval gates have passed — the schema is
/// deployable with everything off (§15).
model MemoryItem {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Factual or style kind (§8.2) — allowlist CHECK lives in the migration.
  kind String

  /// Normalized declarative statement ("사용자는 존댓말 답변을 선호한다"),
  /// never the source text and never an instruction (§8.2, §8.4).
  statement String

  /// §8.3 state machine — allowlist CHECK lives in the migration.
  status String @default("candidate")

  /// "standard" | "sensitive". Sensitive items are excluded from bulk
  /// approval and require individual review (§8.4).
  sensitivity String @default("standard")

  confidence Float
  importance Int     @default(0)
  pinned     Boolean @default(false)

  /// Canonical key grouping conflicting statements (§8.3): equal keys with
  /// different values are surfaced to the user, never auto-overwritten.
  conflictKey String?

  /// Lexical retrieval terms (§9, retrieval v1 — no embeddings). The GIN
  /// index is created by raw SQL in the migration. Written by
  /// `memoryRetrievalTerms()` (lib/memoryRetrievalTerms.ts) on every path
  /// that writes a statement; rows predating it are re-indexed by
  /// `npm run maintenance:memory-search-terms`.
  searchTerms      String[] @default([])
  retrievalVersion Int      @default(1)

  revision   Int     @default(1)
  userEdited Boolean @default(false)

  expiresAt       DateTime?
  suspendedReason String?

  /// Provenance of automatic extraction (§12): null for user-authored items.
  extractionModelId String?
  promptVersion     String?

  /// Which extraction chunk produced this item (§11). Provenance, and the
  /// idempotency key the persistence step needs: a chunk that is retried
  /// after its worker died must replace the rows of its previous attempt
  /// rather than add a second copy of every candidate. Null for
  /// user-authored items and for anything predating the write path.
  ///
  /// Deliberately not a relation: a run is operational state that may be
  /// pruned, and an approved memory must outlive the run that proposed it.
  extractionRunId      String?
  extractionChunkIndex Int?

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  approvedAt DateTime?

  evidences MemoryEvidence[]

  @@index([userId, status])
  @@index([userId, conflictKey])
  /// The idempotent replace in the extraction persistence step reads exactly
  /// this pair.
  @@index([extractionRunId, extractionChunkIndex])
  /// §9 retrieval v1 — lexical GIN over the term array. Declared here so the
  /// db-integration drift check sees schema and migration agree; the mapped
  /// name matches the migration's hand-written CREATE INDEX.
  @@index([searchTerms(ops: ArrayOps)], type: Gin, map: "MemoryItem_searchTerms_gin_idx")
}

/// Evidence backing one memory item (§8.5, as settled by the 2026-08-03
/// amendment): the sourceType decides the exact FK pattern, enforced by a
/// CHECK in the migration —
///   external_message → externalMessageId set, manualContent NULL
///   tomverse_message → tomverseMessageId set (schema reserved for later)
///   manual           → both FKs NULL, manualContent is the evidence body.
/// evidenceDigest re-verifies the source content (or the manual text) so a
/// changed source is detectable (§8.4).
model MemoryEvidence {
  id           String     @id @default(cuid())
  memoryItemId String
  memoryItem   MemoryItem @relation(fields: [memoryItemId], references: [id], onDelete: Cascade)
  userId       String

  sourceType String // external_message | tomverse_message | manual

  externalMessageId String?
  /// DB-level cascade keeps Release A's delete paths unblocked; the §13.1
  /// source-delete flow and the reconciliation sweep are responsible for
  /// transitioning memories whose evidence disappeared (delete by default,
  /// suspended_by_source_delete on an explicit keep).
  externalMessage   ExternalMessage? @relation(fields: [externalMessageId], references: [id], onDelete: Cascade)

  /// Reserved (§8.5): no relation until a release actually uses it.
  tomverseMessageId String?

  /// Manual evidence body (sourceType=manual only): the user-entered grounds
  /// text. Subject to the same validator and length rules as statements.
  manualContent String?

  evidenceDigest String
  createdAt      DateTime @default(now())

  @@index([memoryItemId])
  @@index([externalMessageId])
  @@index([userId])
}

/// One background extraction run (§3, §11). Layered as background
/// concurrency — never an interactive chat lease — with at most one active
/// run per user, enforced transactionally by the B2 slice's service.
model MemoryExtractionRun {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// pending | running | completed | failed | cancelled — allowlist CHECK
  /// lives in the migration.
  status String @default("pending")

  extractionModelId String
  promptVersion     String

  /// Selected ExternalConversation IDs (owner-verified at run creation).
  sourceSelection Json

  chunkTotal     Int
  /// Derived from the chunk rows on every write — never incremented on its
  /// own, so it cannot drift from the chunks it summarizes.
  chunkCompleted Int       @default(0)
  leaseExpiresAt DateTime?
  pricingVersion String?

  /// Fencing token (§11 durability). Every successful claim increments it,
  /// and every write a worker makes is conditioned on the generation it
  /// claimed with. A worker that was superseded — because its lease expired
  /// and the maintenance dispatcher took over — therefore cannot heartbeat,
  /// finish a chunk or settle after waking up late. A lease deadline alone
  /// cannot do this: two claimants can both pass a deadline check.
  leaseGeneration Int     @default(0)
  /// Opaque worker identity, for observability only. Never a security check:
  /// exclusivity comes from leaseGeneration, not from this string.
  leaseOwner      String?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  completedAt DateTime?

  chunks MemoryExtractionChunk[]

  @@index([userId, status])
  /// Orphan reconciliation (§11): expired leases are found by status +
  /// lease deadline, mirroring the chat lease sweep.
  @@index([status, leaseExpiresAt])
}

/// The credit reservation for one extraction run (§11).
///
/// One row per run, not per chunk, because one run is what the user confirmed:
/// §11 shows the chunk plan and its credit total before the run starts and
/// refuses a stale confirmation. Reserving per chunk instead would let a run
/// the user agreed to pay N credits for stop halfway because the balance moved
/// underneath it, which is a worse promise than the one they were shown.
///
/// Provider budget is re-checked per chunk regardless. That is the operational
/// guardrail layer and it is deliberately not this: entitlement is reserved
/// once, up front, from what the user actually holds.
///
/// Plain strings, never foreign keys, for everything it describes: this
/// financial record has to survive deletion of the run, the model catalogue
/// entry and the conversations the run read.
model MemoryExtractionCreditReservation {
  id     String  @id // caller-supplied: memory-extraction-credit-reservation:{runId}:v1
  userId String?
  runId  String  @unique

  /// reserved | settling | settled -- allowlist CHECK in the migration. The
  /// intermediate state is what makes settlement idempotent under a retry: a
  /// second settle finds no `reserved` row to claim and does nothing.
  status  String  @default("reserved")
  /// completed | failed | cancelled
  outcome String?

  provider          String
  extractionModelId String
  promptVersion     String

  chunkTotal    Int
  /// Chunks that actually reached `completed`. What the run is charged for:
  /// a run that failed or was cancelled after two of five chunks keeps two.
  chunksCharged Int @default(0)

  reservedCredits           Int
  planReservedCredits       Int
  addOnReservedCredits      Int
  reservedCostMicroUsd      BigInt
  settledCredits            Int    @default(0)
  settledCostMicroUsd       BigInt @default(0)
  settledFundedCostMicroUsd BigInt @default(0)

  /// Frozen at reservation: a later price change must never re-settle an
  /// existing reservation at the new rate.
  pricingVersion     String
  costSource         String
  pricingSnapshot    Json
  /// AddOnCreditReservationEntry[] -- the per-lot credits and funded cost
  /// reserved by reserveAddOnCredits, kept so a sweep after a crash can refund
  /// lot by lot without the in-memory entries.
  reservationPayload Json

  refundedAt DateTime?
  settledAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([userId, createdAt])
}

/// One extraction model call (§11). Durable per-chunk state, created with the
/// run so progress, retry budget and failure survive any executor dying.
///
/// `conversationIds` is stored rather than re-derived: chunk planning is a
/// pure function of the selection *and its order*, so a re-plan under a
/// different row order could hand a worker a different chunk than the one the
/// user was quoted for. Storing the plan removes that class of drift.
model MemoryExtractionChunk {
  id    String              @id @default(cuid())
  runId String
  run   MemoryExtractionRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  chunkIndex Int

  /// pending | running | completed | failed — allowlist CHECK in the migration.
  status String @default("pending")

  /// ExternalConversation IDs this call covers, in plan order.
  conversationIds Json

  /// Bounded retry (§11). Incremented on claim, so a chunk that keeps killing
  /// its worker cannot be retried forever.
  attemptCount Int @default(0)

  /// The run lease generation that last claimed this chunk. Writes are fenced
  /// on it, so a superseded worker cannot report a result for a chunk that has
  /// since been re-claimed.
  leaseGeneration Int?

  failureCode String?
  startedAt   DateTime?
  completedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  providerCalls MemoryExtractionProviderCall[]

  @@unique([runId, chunkIndex])
  @@index([runId, status])
}

/// Operational provider-cost accounting for one extraction attempt (§3, §11).
///
/// A DIFFERENT layer from the run's user-credit reservation. User credits are
/// reserved per run and settled at a terminal state, charging only completed
/// chunks — a failed chunk is refunded, because the user did not get it. But a
/// request that was actually issued may have been billed by the provider, and
/// erasing that from the provider budget would let a run that keeps failing
/// consume an unbounded share of a budget that reads as untouched.
model MemoryExtractionProviderCall {
  id      String                @id @default(cuid())
  chunkId String
  chunk   MemoryExtractionChunk @relation(fields: [chunkId], references: [id], onDelete: Cascade)

  /// With the chunk's (runId, chunkIndex), this is the §11 attempt identity.
  attemptCount Int

  provider String
  modelId  String

  /// Written BEFORE the request leaves, so a crash mid-flight is recoverable
  /// as "may have cost something" rather than as "nothing happened".
  callIssued           Boolean @default(false)
  /// Consumed from the provider and extraction sub-budget buckets at
  /// admission. Released in full only when no call went out.
  reservedCostMicroUsd BigInt  @default(0)
  /// What the call actually cost. NULL while unknown, which is why the
  /// reservation stands as the conservative charge until then.
  settledCostMicroUsd  BigInt?
  /// False when the provider reported no usage: the reservation stands rather
  /// than the call being recorded as free.
  usageConfirmed       Boolean @default(false)
  inputTokens          Int?
  outputTokens         Int?
  /// Provider-side response id, for reconciling a charge we cannot confirm.
  responseId           String?
  failureCode          String?

  startedAt DateTime?
  settledAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([chunkId, attemptCount])
  @@index([callIssued, settledAt])
}

/// Account-level memory controls (§8.1). The master toggle is not an
/// operational kill switch (§15) — the AppSetting flags stay authoritative
/// above it, and no conversation mode can override a disabled master.
model UserMemorySettings {
  userId String @id
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Approved memories are used unless the owner turns this off. Approval
  /// itself is always explicit and per-item (§8.3), so a default-on master
  /// exposes nothing the user has not individually reviewed.
  masterEnabled Boolean @default(true)

  /// Style memories (§8.2) are separately deactivatable.
  styleEnabled Boolean @default(true)

  /// What "inherit" resolves to: "on" | "off" — CHECK in the migration.
  defaultConversationMode String @default("on")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// One consumed §10 context bundle, per (bundle, model).
///
/// The nonce contract cannot be held in memory: a replayed bundle has to be
/// refused by whichever instance sees it second, and there is no shared
/// process. The unique key IS the enforcement — an insert that violates it is
/// the "already consumed" answer, so the check and the claim are one
/// statement and two concurrent requests cannot both win.
///
/// Per (bundle, model) rather than per bundle, because a comparison's three
/// requests legitimately present the same bundle
/// (`bundleConsumptionKey()`, policy §10).
model ChatContextBundleConsumption {
  id String @id @default(cuid())

  /// `bundleId:modelId`. Unique — this is the concurrency control.
  consumptionKey String @unique

  bundleId String
  modelId  String
  userId   String

  /// The bundle's own expiry, carried so cleanup never has to decode a
  /// token. Rows are only useful until the bundle they name expires.
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([expiresAt])
  @@index([userId, createdAt])
}

/// One logical assistant response, as the Router saw it
/// (docs/policy/tomverse-chat-routing.md §5).
///
/// `mode` is the discriminator rather than a second table. Today every row is
/// `shadow`: the rules ran, the decision was recorded, and the user's own
/// model selection is what actually executed. When routing becomes
/// authoritative the same row grows attempts and a settlement outcome, and the
/// mode says which kind of record it is -- a partially filled row that looked
/// like a complete one is the failure this column prevents.
///
/// Content-free by construction (§2: raw effective prompts are not copied into
/// routing telemetry). Every column is a version, an identifier, a count or a
/// label; there is no message text, no memory content and no message id.
model RoutingRun {
  id         String   @id @default(cuid())
  createdAt  DateTime @default(now())
  /// `shadow` while the user's selection stays authoritative.
  mode       String   @default("shadow")
  traceId    String
  /// Set for a signed-in account; a guest run carries only its subject key.
  ///
  /// Cascades. `subjectKey` and `traceId` would still name the person after a
  /// SetNull, so keeping the row would be a half-anonymisation the privacy
  /// registry has to carry as a gap. A brand-new telemetry table has no claim
  /// on surviving its subject: shadow evaluation is an aggregate, and losing
  /// the rows of accounts that delete is a sampling effect rather than a hole.
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  subjectKey String
  plan       String

  /// The versions a decision must be attributable to.
  taskProfileVersion     String
  candidateFilterVersion String
  selectionVersion       String
  estimatorVersion       String

  /// The task profile, as labels and booleans.
  profileKind             String
  profileConfidence       String
  needsCurrentInformation Boolean
  hasImageInput           Boolean
  hasDocumentInput        Boolean
  expectedOutputLength    String

  /// What the turn was sized at. `reservedInputTokens` includes tool
  /// overhead, and `requestOutputCapTokens` is the cap *before* it is fitted to
  /// any one model's window -- the filters fit it per candidate, so storing an
  /// already-fitted figure would record the user's model's answer to a question
  /// asked of every candidate.
  estimatedInputTokens   Int
  reservedInputTokens    Int
  requestOutputCapTokens Int

  /// The candidate set, as counts. `rejectedByReason` maps a fixed rejection
  /// identifier to how many models it refused -- never which request it was.
  eligibleCount    Int
  rejectedByReason Json

  /// What the Router would have chosen, and why. Null when nothing was
  /// eligible, which is a result rather than a missing value.
  selectedModelId String?
  selectionReason String
  selectionMargin Int

  /// What actually ran. The comparison between this and `selectedModelId` is
  /// the whole point of a shadow run, and it is derived at read time rather
  /// than stored so the two can never disagree.
  userSelectedModelId String

  /// How long the decision itself took, in microseconds.
  decisionMicros Int

  @@index([createdAt])
  @@index([mode, createdAt])
  @@index([userId, createdAt])
}

/// One dual-estimate observation for prompt-token estimator calibration (G1 in
/// docs/policy/tomverse-chat-model-capability-inventory.md).
///
/// Shadow only. The candidate estimate is recorded and compared; it never
/// reaches credit reservation, request rejection, routing or a provider call.
/// No prompt text is stored either -- only derived counts and a cohort label,
/// so a sample can be analysed without the conversation it came from.
///
/// `inputUsageSource` is deliberately its own field rather than reused from the
/// settlement snapshot: that one is decided by whether the provider reported
/// *output* tokens, while the input figure independently falls back to the
/// reserved value. Calibrating on a fallback sample compares an estimate with a
/// copy of itself and reports an error near zero.
model TokenEstimateShadowSample {
  id String @id @default(cuid())

  /// The provider attempt this observation belongs to. Unique so the
  /// reservation-time insert and the settlement-time update address one row,
  /// and so a retry is a separate sample rather than an overwrite.
  attemptId  String @unique
  modelId    String
  providerId String

  /// The estimate that actually drove reservation and limits.
  controlEstimatorVersion        String
  controlRawEstimatedInputTokens Int

  /// The estimate under evaluation. Recorded only.
  candidateEstimatorVersion        String
  candidateRawEstimatedInputTokens Int

  /// What was really reserved, control-derived, including tool overhead.
  reservedInputTokens Int

  tokenizerFamily   String
  contentCohort     String
  hangulCharacters  Int
  hanKanaCharacters Int
  nonCjkBytes       Int
  /// Symbol density of the non-CJK part. Stored because a cohort label bakes in
  /// today's threshold; the ratio lets it be re-derived without the text.
  nonCjkSymbolRatio Float  @default(0)

  /// Null unless the provider itself reported input tokens. Never filled from a
  /// reservation fallback.
  providerReportedInputTokens Int?
  /// `provider_reported` | `fallback_estimator` | `missing`.
  inputUsageSource            String @default("missing")

  /// `completed` | `failed` | `cancelled`.
  outcome           String  @default("failed")
  isPartial         Boolean @default(false)
  isCancelled       Boolean @default(false)
  isFallbackAttempt Boolean @default(false)

  createdAt DateTime  @default(now())
  settledAt DateTime?

  /// The calibration query's own filter: eligible samples are provider-reported
  /// and completed.
  @@index([inputUsageSource, outcome, createdAt])
  /// Family and cohort are how the harness segments its report.
  @@index([tokenizerFamily, contentCohort, createdAt])
  @@index([modelId, createdAt])
}

/// One row per account-data-export download request: the single-use ticket and
/// the audit record are the same object.
///
/// Keeping them together is deliberate. A ticket table without an audit trail
/// answers "can this link still be used" and nothing about who used it; an
/// audit table separate from the ticket has to be written by a second call that
/// a future edit can forget. One row, written at issue and claimed at
/// redemption, cannot drift apart from itself.
///
/// The token is never stored -- only its HMAC -- so a copy of this table does
/// not yield a working download link.
model AccountDataExportRequest {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// HMAC-SHA256 of the single-use token, keyed by NEXTAUTH_SECRET.
  tokenHash String @unique

  /// issued | downloaded | refused
  status String @default("issued")

  expiresAt  DateTime
  consumedAt DateTime?

  /// Hashed request context. Enough to notice a download from somewhere the
  /// account has never been; never enough to reconstruct where someone was.
  issuedIpHash          String
  issuedUserAgentHash   String
  consumedIpHash        String?
  consumedUserAgentHash String?

  /// Why a redemption was refused: unknown_token | wrong_user | expired |
  /// already_used. Recorded here and never told to the caller, who learns only
  /// that the link is unusable.
  refusalReason String?

  /// What the download actually contained, so the audit answers "what did they
  /// get" and not only "did they download". Never the data itself.
  exportSchemaVersion Int?
  includedDomainCount Int?
  filteredDomainCount Int?
  byteLength          Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, createdAt])
  @@index([expiresAt])
  @@index([status, createdAt])
}
