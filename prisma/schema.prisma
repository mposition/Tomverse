// Admin-triggered provider checks. Two kinds share this table (see `kind`):
//
//   "configuration"    -- the original readiness check. Reads environment
//                         configuration only and never calls the provider.
//   "live_verification" -- STG-R002. Sends one minimal, non-billed request to
//                         the provider's cheapest simple model and records the
//                         sanitized outcome. This row *is* the recovery
//                         evidence: clearing a provider's blocking failure
//                         counter requires a successful row of this kind that
//                         has not already been consumed (recoveryApplied).
//
// Public-safe by contract: no API key, no Authorization header, no raw
// provider response body, no prompt content -- only a sanitized diagnostic
// code and a redacted message.
model ProviderHealthCheck {
  id             String   @id @default(cuid())
  provider       String
  modelId        String?
  kind           String   @default("configuration")
  status         String
  latencyMs      Int?
  errorCode      String?
  /// Sanitized code in the shape providerDiagnosticCode() produces, e.g.
  /// "PROVIDER_VERIFICATION_FAILED.HTTP_400".
  diagnosticCode String?
  message        String?
  traceId        String?
  /// Set once, when this check has been consumed to clear a provider's
  /// blocking consecutiveFailures counter. Guards double-submits: a check can
  /// authorise exactly one recovery.
  recoveryApplied Boolean @default(false)
  recoveryAppliedAt DateTime?
  /// consecutiveFailures immediately before the recovery this check
  /// authorised, so the audit record states what was actually cleared.
  previousConsecutiveFailures Int?
  createdById    String?
  createdByEmail String?
  createdAt      DateTime @default(now())

  @@index([provider, createdAt])
  @@index([status, createdAt])
  @@index([provider, kind, createdAt])
}

