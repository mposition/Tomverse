// ==========================================
// External conversation import (Release A).
// Contract: docs/policy/external-conversation-import-and-memory.md §4, §5, §20.
// External conversations never live in Conversation/Message — source model
// labels stay provenance-only and must not reach runtime modelId semantics.
// ==========================================

model ExternalImport {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  provider String // lib/externalImportProviders.ts — allowlist CHECK lives in the migration
  status   String @default("inspecting") // inspecting | staging | preview_ready | finalizing | completed | failed | cancelled

  /// Client-sent hint for fast duplicate-candidate detection only. Never an
  /// authoritative dedup input — the server recomputes every digest (§4.1).
  clientFingerprint   String?
  importDigest        String? // server-computed, set at finalize
  digestVersion       Int
  parserVersion       String
  sourceFormatVersion String?

  conversationCount Int     @default(0)
  messageCount      Int     @default(0)
  normalizedBytes   BigInt  @default(0)
  truncationCount   Int     @default(0)
  duplicateCount    Int     @default(0)
  failureCode       String?

  /// Staging batch ledger (§5.5). Batches arrive strictly in sequence; only
  /// the most recent one may be idempotently retried, so one (sequence,
  /// digest) pair is enough to tell a retry from a conflicting resend.
  lastBatchSequence Int     @default(-1)
  lastBatchDigest   String?

  /// Set by the first successful finalize. A retry with the same key and the
  /// same import digest returns the stored success; a different key on a
  /// completed import is EXTERNAL_IMPORT_ALREADY_FINALIZED (§5.5).
  finalizeIdempotencyKey String?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  completedAt DateTime?

  conversations ExternalConversation[]

  @@index([userId, status])
  @@index([userId, createdAt])
  // Staging TTL sweep: stale non-terminal rows are found by last activity
  // (24h idle / 72h absolute, EXTERNAL_IMPORT_STORAGE_LIMITS).
  @@index([status, updatedAt])
}

model ExternalConversation {
  id     String         @id @default(cuid())
  userId String
  import ExternalImport @relation(fields: [importId], references: [id], onDelete: Cascade)

  importId String
  provider String

  /// Stable digest of the provider's own conversation ID (never the raw ID).
  /// Groups immutable snapshots of the same source lineage (§4.2).
  externalStableId String

  title             String
  sourceModelLabels Json?
  sourceCreatedAt   DateTime?
  sourceUpdatedAt   DateTime?

  /// Server-computed over ordered message dedup digests (§4.1). Unique per
  /// account: an exact re-import is a skip, a changed export becomes a new
  /// immutable snapshot row — existing rows are never merged into.
  conversationDigest String
  digestVersion      Int

  messageCount Int
  contentBytes BigInt

  finalized  Boolean  @default(false)
  importedAt DateTime @default(now())

  /// Snapshot lock (§7, release B5). NULL means unlocked; otherwise the same
  /// scrypt hash format `Conversation.password` uses, written and verified by
  /// the same `lib/conversationLock.ts` helpers. Locking a snapshot suspends
  /// the memories it is the last reachable evidence for (§7.1).
  password String?

  messages            ExternalMessage[]
  continuationBridges ConversationContinuationBridge[]

  @@unique([userId, conversationDigest])
  @@index([userId, externalStableId])
  @@index([userId, finalized])
  @@index([importId])
}

model ExternalMessage {
  id           String               @id @default(cuid())
  userId       String
  conversation ExternalConversation @relation(fields: [externalConversationId], references: [id], onDelete: Cascade)

  externalConversationId String
  externalStableId       String
  role                   String // "user" | "assistant" — allowlist CHECK lives in the migration

  content       String
  contentDigest String

  /// Digest of the pre-truncation normalized content. The unretained part is
  /// never stored — this digest is the only trace of it (§4.1, §5.4).
  originalContentDigest String?
  digestVersion         Int

  sourceModelLabel String?
  sourceTimestamp  DateTime?
  ordinal          Int

  truncated              Boolean @default(false)
  originalCharacterCount Int?
  retainedCharacterCount Int?

  memoryEvidences MemoryEvidence[]

  @@unique([externalConversationId, ordinal])
  @@index([userId])
}

/// Release B (import/memory policy §8, §20). An account-scoped long-term
/// memory: a normalized declarative statement plus lifecycle state. Nothing
/// here is injected anywhere until the B4 retrieval slice exists, the
/// feature flags are on, and the §12 eval gates have passed — the schema is
/// deployable with everything off (§15).
model MemoryItem {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Factual or style kind (§8.2) — allowlist CHECK lives in the migration.
  kind String

  /// Normalized declarative statement ("사용자는 존댓말 답변을 선호한다"),
  /// never the source text and never an instruction (§8.2, §8.4).
  statement String

  /// §8.3 state machine — allowlist CHECK lives in the migration.
  status String @default("candidate")

  /// "standard" | "sensitive". Sensitive items are excluded from bulk
  /// approval and require individual review (§8.4).
  sensitivity String @default("standard")

  confidence Float
  importance Int     @default(0)
  pinned     Boolean @default(false)

  /// Canonical key grouping conflicting statements (§8.3): equal keys with
  /// different values are surfaced to the user, never auto-overwritten.
  conflictKey String?

  /// Lexical retrieval terms (§9, retrieval v1 — no embeddings). The GIN
  /// index is created by raw SQL in the migration. Written by
  /// `memoryRetrievalTerms()` (lib/memoryRetrievalTerms.ts) on every path
  /// that writes a statement; rows predating it are re-indexed by
  /// `npm run maintenance:memory-search-terms`.
  searchTerms      String[] @default([])
  retrievalVersion Int      @default(1)

  revision   Int     @default(1)
  userEdited Boolean @default(false)

  expiresAt       DateTime?
  suspendedReason String?

  /// Provenance of automatic extraction (§12): null for user-authored items.
  extractionModelId String?
  promptVersion     String?

  /// Which extraction chunk produced this item (§11). Provenance, and the
  /// idempotency key the persistence step needs: a chunk that is retried
  /// after its worker died must replace the rows of its previous attempt
  /// rather than add a second copy of every candidate. Null for
  /// user-authored items and for anything predating the write path.
  ///
  /// Deliberately not a relation: a run is operational state that may be
  /// pruned, and an approved memory must outlive the run that proposed it.
  extractionRunId      String?
  extractionChunkIndex Int?

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  approvedAt DateTime?

  evidences MemoryEvidence[]

  @@index([userId, status])
  @@index([userId, conflictKey])
  /// The idempotent replace in the extraction persistence step reads exactly
  /// this pair.
  @@index([extractionRunId, extractionChunkIndex])
  /// §9 retrieval v1 — lexical GIN over the term array. Declared here so the
  /// db-integration drift check sees schema and migration agree; the mapped
  /// name matches the migration's hand-written CREATE INDEX.
  @@index([searchTerms(ops: ArrayOps)], type: Gin, map: "MemoryItem_searchTerms_gin_idx")
}

/// Evidence backing one memory item (§8.5, as settled by the 2026-08-03
/// amendment): the sourceType decides the exact FK pattern, enforced by a
/// CHECK in the migration —
///   external_message → externalMessageId set, manualContent NULL
///   tomverse_message → tomverseMessageId set (schema reserved for later)
///   manual           → both FKs NULL, manualContent is the evidence body.
/// evidenceDigest re-verifies the source content (or the manual text) so a
/// changed source is detectable (§8.4).
model MemoryEvidence {
  id           String     @id @default(cuid())
  memoryItemId String
  memoryItem   MemoryItem @relation(fields: [memoryItemId], references: [id], onDelete: Cascade)
  userId       String

  sourceType String // external_message | tomverse_message | manual

  externalMessageId String?
  /// DB-level cascade keeps Release A's delete paths unblocked; the §13.1
  /// source-delete flow and the reconciliation sweep are responsible for
  /// transitioning memories whose evidence disappeared (delete by default,
  /// suspended_by_source_delete on an explicit keep).
  externalMessage   ExternalMessage? @relation(fields: [externalMessageId], references: [id], onDelete: Cascade)

  /// Reserved (§8.5): no relation until a release actually uses it.
  tomverseMessageId String?

  /// Manual evidence body (sourceType=manual only): the user-entered grounds
  /// text. Subject to the same validator and length rules as statements.
  manualContent String?

  evidenceDigest String
  createdAt      DateTime @default(now())

  @@index([memoryItemId])
  @@index([externalMessageId])
  @@index([userId])
}

/// One background extraction run (§3, §11). Layered as background
/// concurrency — never an interactive chat lease — with at most one active
/// run per user, enforced transactionally by the B2 slice's service.
model MemoryExtractionRun {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// pending | running | completed | failed | cancelled — allowlist CHECK
  /// lives in the migration.
  status String @default("pending")

  extractionModelId String
  promptVersion     String

  /// Selected ExternalConversation IDs (owner-verified at run creation).
  sourceSelection Json

  chunkTotal     Int
  /// Derived from the chunk rows on every write — never incremented on its
  /// own, so it cannot drift from the chunks it summarizes.
  chunkCompleted Int       @default(0)
  leaseExpiresAt DateTime?
  pricingVersion String?

  /// Fencing token (§11 durability). Every successful claim increments it,
  /// and every write a worker makes is conditioned on the generation it
  /// claimed with. A worker that was superseded — because its lease expired
  /// and the maintenance dispatcher took over — therefore cannot heartbeat,
  /// finish a chunk or settle after waking up late. A lease deadline alone
  /// cannot do this: two claimants can both pass a deadline check.
  leaseGeneration Int     @default(0)
  /// Opaque worker identity, for observability only. Never a security check:
  /// exclusivity comes from leaseGeneration, not from this string.
  leaseOwner      String?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  completedAt DateTime?

  chunks MemoryExtractionChunk[]

  @@index([userId, status])
  /// Orphan reconciliation (§11): expired leases are found by status +
  /// lease deadline, mirroring the chat lease sweep.
  @@index([status, leaseExpiresAt])
}

/// The credit reservation for one extraction run (§11).
///
/// One row per run, not per chunk, because one run is what the user confirmed:
/// §11 shows the chunk plan and its credit total before the run starts and
/// refuses a stale confirmation. Reserving per chunk instead would let a run
/// the user agreed to pay N credits for stop halfway because the balance moved
/// underneath it, which is a worse promise than the one they were shown.
///
/// Provider budget is re-checked per chunk regardless. That is the operational
/// guardrail layer and it is deliberately not this: entitlement is reserved
/// once, up front, from what the user actually holds.
///
/// Plain strings, never foreign keys, for everything it describes: this
/// financial record has to survive deletion of the run, the model catalogue
/// entry and the conversations the run read.
model MemoryExtractionCreditReservation {
  id     String  @id // caller-supplied: memory-extraction-credit-reservation:{runId}:v1
  userId String?
  runId  String  @unique

  /// reserved | settling | settled -- allowlist CHECK in the migration. The
  /// intermediate state is what makes settlement idempotent under a retry: a
  /// second settle finds no `reserved` row to claim and does nothing.
  status  String  @default("reserved")
  /// completed | failed | cancelled
  outcome String?

  provider          String
  extractionModelId String
  promptVersion     String

  chunkTotal    Int
  /// Chunks that actually reached `completed`. What the run is charged for:
  /// a run that failed or was cancelled after two of five chunks keeps two.
  chunksCharged Int @default(0)

  reservedCredits           Int
  planReservedCredits       Int
  addOnReservedCredits      Int
  reservedCostMicroUsd      BigInt
  settledCredits            Int    @default(0)
  settledCostMicroUsd       BigInt @default(0)
  settledFundedCostMicroUsd BigInt @default(0)

  /// Frozen at reservation: a later price change must never re-settle an
  /// existing reservation at the new rate.
  pricingVersion     String
  costSource         String
  pricingSnapshot    Json
  /// AddOnCreditReservationEntry[] -- the per-lot credits and funded cost
  /// reserved by reserveAddOnCredits, kept so a sweep after a crash can refund
  /// lot by lot without the in-memory entries.
  reservationPayload Json

  refundedAt DateTime?
  settledAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([userId, createdAt])
}

/// One extraction model call (§11). Durable per-chunk state, created with the
/// run so progress, retry budget and failure survive any executor dying.
///
/// `conversationIds` is stored rather than re-derived: chunk planning is a
/// pure function of the selection *and its order*, so a re-plan under a
/// different row order could hand a worker a different chunk than the one the
/// user was quoted for. Storing the plan removes that class of drift.
model MemoryExtractionChunk {
  id    String              @id @default(cuid())
  runId String
  run   MemoryExtractionRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  chunkIndex Int

  /// pending | running | completed | skipped | failed — allowlist CHECK in the
  /// migration. `skipped` finished without calling the provider (its sources
  /// were all gone), so it counts as processed but is never charged.
  status String @default("pending")

  /// ExternalConversation IDs this call covers, in plan order.
  conversationIds Json

  /// Bounded retry (§11). Incremented on claim, so a chunk that keeps killing
  /// its worker cannot be retried forever.
  attemptCount Int @default(0)

  /// The run lease generation that last claimed this chunk. Writes are fenced
  /// on it, so a superseded worker cannot report a result for a chunk that has
  /// since been re-claimed.
  leaseGeneration Int?

  failureCode String?
  startedAt   DateTime?
  completedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  providerCalls MemoryExtractionProviderCall[]

  @@unique([runId, chunkIndex])
  @@index([runId, status])
}

/// Operational provider-cost accounting for one extraction attempt (§3, §11).
///
/// A DIFFERENT layer from the run's user-credit reservation. User credits are
/// reserved per run and settled at a terminal state, charging only completed
/// chunks — a failed chunk is refunded, because the user did not get it. But a
/// request that was actually issued may have been billed by the provider, and
/// erasing that from the provider budget would let a run that keeps failing
/// consume an unbounded share of a budget that reads as untouched.
model MemoryExtractionProviderCall {
  id      String                @id @default(cuid())
  chunkId String
  chunk   MemoryExtractionChunk @relation(fields: [chunkId], references: [id], onDelete: Cascade)

  /// With the chunk's (runId, chunkIndex), this is the §11 attempt identity.
  attemptCount Int

  provider String
  modelId  String

  /// Written BEFORE the request leaves, so a crash mid-flight is recoverable
  /// as "may have cost something" rather than as "nothing happened".
  callIssued           Boolean @default(false)
  /// Consumed from the provider and extraction sub-budget buckets at
  /// admission. Released in full only when no call went out.
  reservedCostMicroUsd BigInt  @default(0)
  /// What the call actually cost. NULL while unknown, which is why the
  /// reservation stands as the conservative charge until then.
  settledCostMicroUsd  BigInt?
  /// False when the provider reported no usage: the reservation stands rather
  /// than the call being recorded as free.
  usageConfirmed       Boolean @default(false)
  inputTokens          Int?
  outputTokens         Int?
  /// Provider-side response id, for reconciling a charge we cannot confirm.
  responseId           String?
  failureCode          String?

  startedAt DateTime?
  settledAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([chunkId, attemptCount])
  @@index([callIssued, settledAt])
}

/// Account-level memory controls (§8.1). The master toggle is not an
/// operational kill switch (§15) — the AppSetting flags stay authoritative
/// above it, and no conversation mode can override a disabled master.
model UserMemorySettings {
  userId String @id
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Approved memories are used unless the owner turns this off. Approval
  /// itself is always explicit and per-item (§8.3), so a default-on master
  /// exposes nothing the user has not individually reviewed.
  masterEnabled Boolean @default(true)

  /// Style memories (§8.2) are separately deactivatable.
  styleEnabled Boolean @default(true)

  /// What "inherit" resolves to: "on" | "off" — CHECK in the migration.
  defaultConversationMode String @default("on")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Policy: docs/policy/external-conversation-import-and-memory.md.
/// A private assistant profile (release C, policy §14, §20 릴리스 C).
///
/// Identity only. Everything that decides how the assistant behaves lives on
/// AssistantProfileVersion, because §14 pins a conversation to the version it
/// started on and a field kept here would be read at request time instead --
/// which is exactly the retroactive application §14 forbids.
///
/// Private by construction: there is no share token, no visibility column and
/// no public listing. §14's non-goals (marketplace, sharing, selling) are held
/// by the absence of a column to set, not by a check somebody can forget.
model AssistantProfile {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  name String

  /// An emoji or a short token the UI renders; never a URL, so a profile list
  /// cannot become a request to an attacker-chosen host.
  icon String?

  /// Policy: docs/policy/external-conversation-import-and-memory.md.
  /// Presentation, not behaviour -- so it is not part of the version snapshot
  /// (§14 lists what a version records, and this is not in it).
  description String?

  /// The version a new conversation pins to. Nullable because a profile row
  /// exists before its first version is published, and a profile with no
  /// published version is a draft that cannot start a conversation.
  currentVersionId String? @unique

  currentVersion AssistantProfileVersion? @relation("AssistantProfileCurrentVersion", fields: [currentVersionId], references: [id], onDelete: SetNull)

  versions       AssistantProfileVersion[] @relation("AssistantProfileVersions")
  knowledgeFiles AssistantKnowledgeFile[]  @relation("AssistantProfileKnowledge")
  imports        AssistantProfileImport[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, updatedAt])
}

/// Policy: docs/policy/external-conversation-import-and-memory.md.
/// One immutable published snapshot of a profile (§14).
///
/// Nothing here is ever updated after insert. Editing a profile publishes a
/// new revision; the row a conversation pinned keeps saying what that
/// conversation actually ran under. There is no `updatedAt` on purpose -- a
/// column that can change is an invitation to change it.
///
/// `knowledgeManifest` is audit metadata and NOT a retrieval source (§14).
/// It can prove a file was listed at publish time; it cannot resurrect a
/// deleted one, and retrieval only ever reads chunks that currently exist and
/// are accessible. `lib/assistantProfileVersioning.ts` resolves a manifest
/// against what exists today and marks the rest unavailable.
model AssistantProfileVersion {
  id        String           @id @default(cuid())
  profileId String
  profile   AssistantProfile @relation("AssistantProfileVersions", fields: [profileId], references: [id], onDelete: Cascade)

  /// Policy: docs/policy/external-conversation-import-and-memory.md.
  /// The account that owns this snapshot, and -- today -- the account that
  /// published it, which is what §14's "created by" asks for. Carried here as
  /// well as on the profile so ownership is a column rather than a join: the
  /// account export scopes by it, the deletion cascade reaches it directly,
  /// and the data-domain registry can see that this table holds user data.
  /// A profile only its owner may edit makes the two readings identical; if
  /// that ever changes, the publisher becomes a second column with its own
  /// migration rather than a quiet reinterpretation of this one.
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// 1-based, per profile. Monotonic: a revision is never reused, so a stale
  /// editor's `ASSISTANT_PROFILE_VERSION_STALE` (§18) is decided by comparing
  /// numbers rather than timestamps.
  revision Int

  instructions String

  /// Policy: docs/policy/external-conversation-import-and-memory.md.
  /// Model selection, tool policy, memory policy and conversation starters,
  /// each a JSON snapshot of what the user chose. Snapshots rather than
  /// foreign keys: a model that is later retired must not silently change what
  /// a past conversation is recorded as having run under. §14 refuses the
  /// version at runtime instead (`ASSISTANT_PROFILE_MODEL_UNAVAILABLE`), and
  /// never substitutes a different model.
  models       Json
  toolPolicy   Json
  memoryPolicy Json
  starters     Json

  /// The files listed at publish time. Audit metadata -- see the model comment.
  knowledgeManifest Json

  /// Policy: docs/policy/external-conversation-import-and-memory.md.
  /// Which retrieval algorithm and prompt shape this snapshot was built for,
  /// so a version published under an older one is refused rather than
  /// reinterpreted (§14).
  retrievalVersion    Int
  promptFormatVersion String

  createdAt DateTime @default(now())

  /// Back-relation for AssistantProfile.currentVersionId. Never read as a
  /// list -- at most one profile points at a given version.
  currentFor AssistantProfile[] @relation("AssistantProfileCurrentVersion")

  conversations Conversation[]

  /// The imports that published this snapshot. At most one today; a list
  /// because Prisma requires the back side of an optional relation to be one,
  /// and because `SetNull` means the import outlives the version it names.
  imports AssistantProfileImport[]

  @@unique([profileId, revision])
  @@index([profileId, createdAt])
  @@index([userId, createdAt])
}

/// Policy: docs/policy/external-conversation-import-and-memory.md.
/// One durable knowledge file attached to a profile (release C, policy §14,
/// §14.1, §14.2, §20 릴리스 C).
///
/// Deliberately separate from a chat attachment. An attachment is transient
/// -- it belongs to one turn and is swept -- while this is storage the owner
/// manages, counts against a quota, and expects to still be there next month.
/// Sharing the attachment tables would have made "delete the conversation"
/// and "delete the knowledge file" the same operation, which they are not.
///
/// No embeddings and no vector column: retrieval v1 is lexical over
/// `AssistantKnowledgeChunk.searchTerms` (§14). Adding one later is a separate
/// policy, privacy, cost and eval decision, not a migration.
model AssistantKnowledgeFile {
  id        String           @id @default(cuid())
  profileId String
  profile   AssistantProfile @relation("AssistantProfileKnowledge", fields: [profileId], references: [id], onDelete: Cascade)

  /// Ownership as a column rather than a join, for the same reason
  /// AssistantProfileVersion carries one: the account export and the deletion
  /// sweep both scope by it, and a row whose owner has to be derived is a row
  /// the obvious query misses.
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// The name the owner sees. Normalised, never used to build a path.
  name String

  mime  String
  bytes Int

  /// SHA-256 of the stored object. This is what a version's knowledge
  /// manifest records, and what `resolveKnowledgeManifest()` compares against
  /// to decide whether the file a past version listed is still the same file.
  /// NOT unique per profile: re-uploading the same bytes is a new file with a
  /// new id, and §14 is explicit that it does not reconnect to a past version.
  digest String

  /// Private object key. Never leaves the server -- reads go through a
  /// short-lived signed URL behind the ownership check, as image assets do.
  r2Key String @unique

  /// "pending" | "processing" | "ready" | "failed" -- allowlist CHECK in the
  /// migration. Only "ready" has chunks, and only "ready" is retrievable.
  processingStatus String @default("pending")

  /// Why processing failed, from the §18 릴리스 C code set. Null while the
  /// file is pending, processing, or ready.
  failureCode String?

  /// What the extractor produced, before chunking. Recorded so a file that
  /// yielded nothing is distinguishable from one nobody has processed.
  extractedCharacters Int?

  /// Policy: docs/policy/assistant-package-import.md §10.
  /// The same text measured in UTF-8 bytes, which is the unit the account
  /// ceiling is written in. The extractor already computed this to decide
  /// whether to accept the file; until now it threw the number away and the
  /// running total was summed from `extractedCharacters` instead, so a
  /// Korean document counted about a third of what it costs. NULL on every
  /// row written before this column existed -- those keep being counted the
  /// old way rather than being re-extracted, which is a decision recorded in
  /// the policy rather than a gap.
  extractedBytes Int?

  chunkCount Int @default(0)

  /// Which chunking and tokenising algorithm produced this file's chunks.
  retrievalVersion Int @default(1)

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  processedAt DateTime?

  /// Policy: docs/policy/assistant-package-import.md §5.
  /// The import holding this file as staging. NULL is an ordinary file.
  ///
  /// Publishing an import sets this to NULL, and that is what "promotion"
  /// means: until it happens the ordinary knowledge list, the ordinary
  /// manifest resolver and therefore the ordinary publish path cannot see the
  /// file at all. Without it, a file uploaded for an import under review is a
  /// file another tab can publish.
  ///
  /// `Cascade` rather than `Restrict`: `User` cascades into both
  /// `AssistantProfileImport` and this table with no ordering between them, so
  /// a restricting edge would abort account deletion. R2 tombstones are the
  /// application's job on the cancel and expiry paths; this cascade is the
  /// backstop for the rows.
  importId String?
  import   AssistantProfileImport? @relation(fields: [importId], references: [id], onDelete: Cascade)

  chunks AssistantKnowledgeChunk[]

  @@index([profileId, createdAt])
  @@index([userId, createdAt])
  /// The processing worker's claim query reads exactly this pair.
  @@index([processingStatus, createdAt])
  /// Cancellation and expiry find this import's files by this column rather
  /// than by a list somebody remembered to keep.
  @@index([importId])
}

/// Policy: docs/policy/external-conversation-import-and-memory.md.
/// One retrievable piece of a knowledge file (§14).
///
/// Chunks are derived, not authored: deleting and re-processing a file
/// replaces them wholesale, and nothing outside this table references a chunk
/// id. `ordinal` is the chunk's position in the file, which is what lets a
/// citation say where in the document an answer came from.
model AssistantKnowledgeChunk {
  id     String                 @id @default(cuid())
  fileId String
  file   AssistantKnowledgeFile @relation(fields: [fileId], references: [id], onDelete: Cascade)

  /// Denormalised owner, as on the file. Retrieval filters by it before it
  /// filters by anything else.
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// 0-based position in the file.
  ordinal Int

  content String

  /// Policy: docs/policy/external-conversation-import-and-memory.md.
  /// Lexical retrieval terms (§9, retrieval v1 -- no embeddings). The GIN
  /// index is created by raw SQL in the migration, mirroring MemoryItem.
  searchTerms      String[] @default([])
  retrievalVersion Int      @default(1)

  /// Where in the document this chunk came from -- character offsets, and the
  /// page for a PDF. Metadata for a citation, never content.
  sourceMetadata Json?

  createdAt DateTime @default(now())

  @@unique([fileId, ordinal])
  @@index([userId])
  @@index([searchTerms(ops: ArrayOps)], type: Gin, map: "AssistantKnowledgeChunk_searchTerms_gin_idx")
}

/// Policy: docs/policy/assistant-package-import.md §5, §6.
/// One attempt to turn an external assistant package into a profile.
///
/// The row exists from the moment files start being stored -- step 7 of the
/// wizard -- and outlives the import itself, because a published profile has
/// to be able to say where it came from. Everything before step 7 happens in
/// the browser and leaves nothing here.
///
/// Two modes with two different staging holders (§5.2). `create` owns a draft
/// `AssistantProfile` whose `currentVersionId` is NULL, which the existing
/// runtime already refuses to start a conversation with; `merge` has no row of
/// its own and stages into the target profile, which is possible only because
/// a version's manifest is resolved against the files that profile holds --
/// so a staged file that no manifest names can sit there without reaching any
/// answer. `mode` is therefore not a display field: it is the branch the
/// cancellation and expiry sweeps take, and getting it wrong deletes a profile
/// somebody else built. Hence the CHECK, and hence the fail-closed
/// preconditions the sweep re-tests before it deletes anything.
model AssistantProfileImport {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// "create" | "merge" -- allowlist CHECK in the migration.
  mode String

  /// The profile this import writes to: the draft it created, or the target it
  /// merges into. One column because neither mode ever moves a file between
  /// profiles -- the manifest resolver scopes by profile id, so cross-profile
  /// staging is not expressible.
  profileId String
  profile   AssistantProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  /// merge only. The target's revision when the import started, passed to
  /// `planProfileVersionPublish()` as `expectedRevision` so a profile edited
  /// in another tab meanwhile is a stale publish rather than a silent
  /// overwrite. NULL for create.
  expectedTargetRevision Int?

  /// merge only. A digest of the target's name, icon and description at the
  /// same moment. Identity is not part of a version snapshot, so it does not
  /// consume a revision and the number above cannot see it change.
  expectedTargetIdentityDigest String?

  /// "staging" | "published" -- allowlist CHECK in the migration.
  status String @default("staging")

  /// What the owner assembled in the wizard: instructions, starters, models,
  /// policies and which documents to bring. Stored because the container is
  /// not kept, so resuming an interrupted import has nothing else to read.
  ///
  /// Stored is not approved. While `userApprovedAt` is NULL these
  /// instructions are not the owner's words and reach no prompt.
  stagingManifest Json?

  /// The digest of `stagingManifest` as it stands, and the digest of what the
  /// owner actually confirmed. They are two columns because the point is to be
  /// able to prove afterwards that what was stored is what was shown; the
  /// waived credential findings bind to the approved one.
  candidateDigest String?
  approvedDigest  String?
  digestVersion   Int?

  /// When a person pressed confirm. Distinct from `serverReceivedAt` on
  /// purpose: fold them together and "a human approved this" becomes a side
  /// effect of a server write.
  userApprovedAt DateTime?

  /**
   * ---------- provenance: what is observed, and what is claimed ----------
   */

  /// The server's own clock and the server's own reading of what it did.
  serverReceivedAt DateTime @default(now())
  validatorVersion String
  ingestPath       String

  /// Everything below is the client's or the owner's claim. Nothing decides
  /// anything from these, and nothing fetches the URL.
  declaredSourceKind         String?
  declaredSourceName         String?
  declaredSourceUrl          String?
  declaredPreviousProvenance Json?

  /// The revision this import published. NULL while staging.
  ///
  /// `SetNull` rather than `Cascade`: if the version disappears by any route,
  /// the fact that an import happened still has to be true. Cascading would
  /// delete the provenance along with the thing it explains.
  versionId String?
  version   AssistantProfileVersion? @relation(fields: [versionId], references: [id], onDelete: SetNull)

  stagedFiles        AssistantKnowledgeFile[]
  uploadReservations AssistantKnowledgeUploadReservation[]

  /// The expiry clocks are columns rather than arithmetic over `updatedAt`.
  /// `@updatedAt` moves on every write, including the background extractor's
  /// and a failed publish's, so an idle timer read from it would be extended
  /// by exactly the events that mean nobody is here.
  createdAt          DateTime @default(now())
  /// Moved by the owner doing something, and by nothing else.
  lastUserActivityAt DateTime @default(now())
  idleExpiresAt      DateTime
  absoluteExpiresAt  DateTime
  /// Diagnostics. Never read to decide an expiry.
  updatedAt          DateTime @updatedAt

  @@index([userId, createdAt])
  @@index([profileId, createdAt])
  /// The two expiry sweeps read exactly these pairs.
  @@index([status, idleExpiresAt])
  @@index([status, absoluteExpiresAt])
}

/// Policy: docs/policy/assistant-package-import.md §5.
/// Proof that the server issued an upload key, and what it issued it for.
///
/// `knowledgeKey()` is a random UUID, so a key alone says nothing about who
/// asked for it. Without this row, finalize would have to decide from the
/// client's own claim whether a stored object is safe to delete -- and the
/// ordinary finalize path would happily turn an import's key into an ordinary
/// file, which is the isolation `AssistantKnowledgeFile.importId` exists to
/// provide, bypassed in one request.
///
/// The row's life is short by design: prepare creates it, a successful
/// finalize deletes it in the same transaction, publish deletes whatever was
/// never used, and cancellation or account deletion cascades it away. It is
/// never the lifetime of the stored object -- an object nobody claimed is the
/// abandoned-upload sweep's, because a key we did not issue must not be
/// deleted on the strength of a request that names it.
model AssistantKnowledgeUploadReservation {
  r2Key String @id

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Required. The only issuer today is the import path, and a nullable column
  /// would allow a row no cascade reaches. Widening this to ordinary uploads
  /// is a migration, not an omission.
  importId String
  import   AssistantProfileImport @relation(fields: [importId], references: [id], onDelete: Cascade)

  /// Diagnostics. Ownership is decided by `userId` and the import row.
  profileId String

  /// "pending" | "finalizing" -- allowlist CHECK in the migration.
  state String @default("pending")

  /// The current claimant's token, NULL while pending. Every state change
  /// compares against it, so a request that comes back after its claim was
  /// reclaimed changes nothing.
  claimToken String?

  /// When the claim was taken. The stale-claim sweep reads only this.
  finalizingStartedAt DateTime?

  createdAt DateTime @default(now())

  @@index([importId])
  @@index([userId, createdAt])
  /// The stale-claim sweep reads exactly this pair.
  @@index([state, finalizingStartedAt])
}

/// A stored object whose row is gone and whose bytes still have to go (§14.2).
///
/// The same DB-first shape ImageAssetCleanup uses, and for the same reason: R2
/// is never deleted ahead of the database, so a partial failure retries from
/// the tombstone instead of leaving rows that point at missing objects. §14.2
/// settles that this is an application sweep rather than a bucket lifecycle
/// rule -- a bucket rule cannot see the database, does not retry, and leaves
/// no audit trail.
model AssistantKnowledgeCleanup {
  id          String    @id @default(cuid())
  r2Key       String    @unique
  /// file_deleted | profile_deleted | account_deleted | upload_abandoned
  reason      String
  attempts    Int       @default(0)
  lastError   String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  completedAt DateTime?

  @@index([completedAt, createdAt])
}

/// One consumed §10 context bundle, per (bundle, model).
///
/// The nonce contract cannot be held in memory: a replayed bundle has to be
/// refused by whichever instance sees it second, and there is no shared
/// process. The unique key IS the enforcement — an insert that violates it is
/// the "already consumed" answer, so the check and the claim are one
/// statement and two concurrent requests cannot both win.
///
/// Per (bundle, model) rather than per bundle, because a comparison's three
/// requests legitimately present the same bundle
/// (`bundleConsumptionKey()`, policy §10).
model ChatContextBundleConsumption {
  id String @id @default(cuid())

  /// `bundleId:modelId`. Unique — this is the concurrency control.
  consumptionKey String @unique

  bundleId String
  modelId  String
  userId   String

  /// The bundle's own expiry, carried so cleanup never has to decode a
  /// token. Rows are only useful until the bundle they name expires.
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([expiresAt])
  @@index([userId, createdAt])
}

/// One logical assistant response, as the Router saw it
/// (docs/policy/tomverse-chat-routing.md §5).
///
/// `mode` is the discriminator rather than a second table. Today every row is
/// `shadow`: the rules ran, the decision was recorded, and the user's own
/// model selection is what actually executed. When routing becomes
/// authoritative the same row grows attempts and a settlement outcome, and the
/// mode says which kind of record it is -- a partially filled row that looked
/// like a complete one is the failure this column prevents.
///
/// Content-free by construction (§2: raw effective prompts are not copied into
/// routing telemetry). Every column is a version, an identifier, a count or a
/// label; there is no message text, no memory content and no message id.
model RoutingRun {
  id         String   @id @default(cuid())
  createdAt  DateTime @default(now())
  /// `shadow` while the user's selection stays authoritative.
  mode       String   @default("shadow")
  traceId    String
  /// Set for a signed-in account; a guest run carries only its subject key.
  ///
  /// Cascades. `subjectKey` and `traceId` would still name the person after a
  /// SetNull, so keeping the row would be a half-anonymisation the privacy
  /// registry has to carry as a gap. A brand-new telemetry table has no claim
  /// on surviving its subject: shadow evaluation is an aggregate, and losing
  /// the rows of accounts that delete is a sampling effect rather than a hole.
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  subjectKey String
  plan       String

  /// The versions a decision must be attributable to.
  taskProfileVersion     String
  candidateFilterVersion String
  selectionVersion       String
  estimatorVersion       String

  allocationMode      String?
  allocationSeedGrain String?

  controlPlaneVersion  String?
  accountPolicyVersion String?
  requestDeadlineMs    Int?
  precommitBufferMs    Int?

  /// The scoring policy the selection ran under: quality bands, tie-break
  /// order, switch margin, hysteresis and the cost/latency thresholds, all
  /// versioned together in lib/routerScorePolicy.ts.
  ///
  /// Separate from `selectionVersion` because the rule and the numbers it
  /// applies move independently -- a band changing is not the comparator
  /// changing -- and a run recorded with only one of the two can be attributed
  /// to neither. Nullable because rows written before the policy existed
  /// genuinely had none; an invented default would claim they ran under a
  /// policy that had not been decided.
  selectionPolicyVersion String?

  /// The task profile, as labels and booleans.
  profileKind             String
  profileConfidence       String
  needsCurrentInformation Boolean
  hasImageInput           Boolean
  hasDocumentInput        Boolean
  expectedOutputLength    String

  /// What the turn was sized at. `reservedInputTokens` includes tool
  /// overhead, and `requestOutputCapTokens` is the cap *before* it is fitted to
  /// any one model's window -- the filters fit it per candidate, so storing an
  /// already-fitted figure would record the user's model's answer to a question
  /// asked of every candidate.
  estimatedInputTokens   Int
  reservedInputTokens    Int
  requestOutputCapTokens Int

  /// The candidate set, as counts. `rejectedByReason` maps a fixed rejection
  /// identifier to how many models it refused -- never which request it was.
  eligibleCount    Int
  rejectedByReason Json

  /// What the Router would have chosen, and why. Null when nothing was
  /// eligible, which is a result rather than a missing value.
  selectedModelId String?
  selectionReason String
  selectionMargin Int

  /// What actually ran. The comparison between this and `selectedModelId` is
  /// the whole point of a shadow run, and it is derived at read time rather
  /// than stored so the two can never disagree.
  userSelectedModelId String

  /// How long the decision itself took, in microseconds.
  decisionMicros Int

  /// --- aggregate state (§5) ------------------------------------------------
  ///
  /// Aggregate only. Anything that differs between attempts belongs on
  /// RoutingAttempt, where the next attempt cannot overwrite it.

  /// The model the first attempt used, and the one that finally answered.
  /// Equal on the common path, different exactly when a fallback was taken --
  /// which is what makes the pair worth storing rather than deriving.
  initialModelId String?
  finalModelId   String?
  /// The attempt that produced the answer, so the manifest behind the visible
  /// response is one join away. Unique: two runs cannot claim one attempt.
  finalAttemptId String?         @unique
  finalAttempt   RoutingAttempt? @relation("RunFinalAttempt", fields: [finalAttemptId], references: [id], onDelete: SetNull)

  rerouteCount    Int     @default(0)
  /// none | fallback_used | exhausted
  fallbackState   String  @default("none")
  /// §6: at most once per logical response, whichever attempt uses it.
  passThroughUsed Boolean @default(false)

  /// §8. Why this run left the model it started on, when it did.
  /// "temporary_hard_fallback" is the only value that earns the next turn's
  /// hysteresis bypass; anything else is an ordinary switch.
  switchReason String?

  /// §8. The model a hard fallback displaced, kept so the conversation can be
  /// restored to it. Without this, stickiness would defend the substitute
  /// forever and a provider blip would become a permanent model change.
  recoveryCandidateModelId String?

  /// The failure layer that caused the displacement, which is what the
  /// confirm-healthy check on the next turn is about.
  fallbackHealthEvidence String?

  /// The assistant Message this run produced, so regeneration, model switch,
  /// cost and quality can be compared by Router version (delivery plan §5).
  assistantMessageId String?

  totalLatencyMs    Int?
  firstTokenMs      Int?
  reservationId     String?
  settlementOutcome String?

  /// --- product attribution (decision record v1.2 §5) ----------------------

  /// Which product this run executed for, snapshotted at execution time.
  ///
  /// A snapshot rather than a join, because the join can be broken: a user
  /// deleting one conversation would otherwise take that turn's product out of
  /// the evaluation segment with it. ROUTE-01's sample and ROUTE-07's
  /// denominator would then shrink with user behaviour rather than with
  /// anything about routing.
  ///
  /// Nullable because rows written before this column existed genuinely had no
  /// product recorded, and a guessed value would claim an attribution nobody
  /// made. Runs after the cutover must carry one -- how that is enforced is
  /// decided in docs/policy/adr/2026-08-22-routing-run-product-attribution.md.
  productKey String?

  /// Which conversation this run belongs to.
  ///
  /// `beginInstrumentedDispatch` already received this and dropped it, so a
  /// failed run -- which never gets an `assistantMessageId` -- had no way at
  /// all of naming its conversation, and operational lookup was traceId only.
  ///
  /// SetNull, not Cascade: today these rows survive a conversation deletion
  /// because there is no FK at all, and adding a cascade would delete
  /// evaluation data every time a user tidies up. The same pattern as
  /// ChatCreditReservation.userId. Deleting the *account* still takes the runs
  /// with it -- userId -> User stays Cascade, which the data-domain policy
  /// decided and this does not change.
  conversationId String?
  conversation   Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)

  routingAttempts          RoutingAttempt[]          @relation("RunAttempts")
  updatedAt                DateTime                  @default(now()) @updatedAt
  routingCandidateVerdicts RoutingCandidateVerdict[]

  @@index([createdAt])
  @@index([mode, createdAt])
  @@index([userId, createdAt])
  @@index([finalModelId, createdAt])
  @@index([productKey, createdAt])
  /// Not optional. PostgreSQL does not index a referencing column for you, and
  /// ON DELETE SET NULL has to find the referencing rows -- without this,
  /// deleting one conversation scans every RoutingRun.
  @@index([conversationId])
}

/// One dual-estimate observation for prompt-token estimator calibration (G1 in
/// docs/policy/tomverse-chat-model-capability-inventory.md).
///
/// Shadow only. The candidate estimate is recorded and compared; it never
/// reaches credit reservation, request rejection, routing or a provider call.
/// No prompt text is stored either -- only derived counts and a cohort label,
/// so a sample can be analysed without the conversation it came from.
///
/// `inputUsageSource` is deliberately its own field rather than reused from the
/// settlement snapshot: that one is decided by whether the provider reported
/// *output* tokens, while the input figure independently falls back to the
/// reserved value. Calibrating on a fallback sample compares an estimate with a
/// copy of itself and reports an error near zero.
model TokenEstimateShadowSample {
  id String @id @default(cuid())

  /// The provider attempt this observation belongs to. Unique so the
  /// reservation-time insert and the settlement-time update address one row,
  /// and so a retry is a separate sample rather than an overwrite.
  attemptId  String @unique
  modelId    String
  providerId String

  /// The estimate that actually drove reservation and limits.
  controlEstimatorVersion        String
  controlRawEstimatedInputTokens Int

  /// The estimate under evaluation. Recorded only.
  candidateEstimatorVersion        String
  candidateRawEstimatedInputTokens Int

  /// What was really reserved, control-derived, including tool overhead.
  reservedInputTokens Int

  tokenizerFamily   String
  contentCohort     String
  hangulCharacters  Int
  hanKanaCharacters Int
  nonCjkBytes       Int
  /// Symbol density of the non-CJK part. Stored because a cohort label bakes in
  /// today's threshold; the ratio lets it be re-derived without the text.
  nonCjkSymbolRatio Float  @default(0)

  /// Null unless the provider itself reported input tokens. Never filled from a
  /// reservation fallback.
  providerReportedInputTokens Int?
  /// `provider_reported` | `fallback_estimator` | `missing`.
  inputUsageSource            String @default("missing")

  /// `completed` | `failed` | `cancelled`.
  outcome           String  @default("failed")
  isPartial         Boolean @default(false)
  isCancelled       Boolean @default(false)
  isFallbackAttempt Boolean @default(false)

  createdAt DateTime  @default(now())
  settledAt DateTime?

  /// The calibration query's own filter: eligible samples are provider-reported
  /// and completed.
  @@index([inputUsageSource, outcome, createdAt])
  /// Family and cohort are how the harness segments its report.
  @@index([tokenizerFamily, contentCohort, createdAt])
  @@index([modelId, createdAt])
}

/// One row per account-data-export download request: the single-use ticket and
/// the audit record are the same object.
///
/// Keeping them together is deliberate. A ticket table without an audit trail
/// answers "can this link still be used" and nothing about who used it; an
/// audit table separate from the ticket has to be written by a second call that
/// a future edit can forget. One row, written at issue and claimed at
/// redemption, cannot drift apart from itself.
///
/// The token is never stored -- only its HMAC -- so a copy of this table does
/// not yield a working download link.
model AccountDataExportRequest {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// HMAC-SHA256 of the single-use token, keyed by NEXTAUTH_SECRET.
  tokenHash String @unique

  /// issued | downloaded | refused
  status String @default("issued")

  expiresAt  DateTime
  consumedAt DateTime?

  /// Hashed request context. Enough to notice a download from somewhere the
  /// account has never been; never enough to reconstruct where someone was.
  issuedIpHash          String
  issuedUserAgentHash   String
  consumedIpHash        String?
  consumedUserAgentHash String?

  /// Why a redemption was refused: unknown_token | wrong_user | expired |
  /// already_used. Recorded here and never told to the caller, who learns only
  /// that the link is unusable.
  refusalReason String?

  /// What the download actually contained, so the audit answers "what did they
  /// get" and not only "did they download". Never the data itself.
  exportSchemaVersion Int?
  includedDomainCount Int?
  filteredDomainCount Int?
  byteLength          Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, createdAt])
  @@index([expiresAt])
  @@index([status, createdAt])
}

/// One preparation-or-dispatch attempt inside a RoutingRun
/// (docs/policy/tomverse-chat-routing.md §5).
///
/// A separate table rather than columns on RoutingRun, because one logical
/// response can produce several attempts and each has its own model,
/// tokenizer, Planner mode, effective request and manifest:
///
///   Attempt 1  primary, provider failure before any visible token
///   Attempt 2  fallback, Planner failure, never dispatched
///   Attempt 3  fallback, pass-through, succeeded
///
/// Flattening that onto the run would overwrite the earlier attempts or bury
/// them in a JSON array, and an array cannot carry the constraints below.
/// RoutingRun keeps the aggregate; per-attempt facts live here.
model RoutingAttempt {
  id         String      @id @default(cuid())
  runId      String
  run        RoutingRun  @relation("RunAttempts", fields: [runId], references: [id], onDelete: Cascade)
  /// Back-relation for RoutingRun.finalAttempt. The pair is what lets the
  /// manifest behind the visible answer be reached in one join.
  finalOfRun RoutingRun? @relation("RunFinalAttempt")
  /// Denormalised from the run so this is a data domain in its own right: the
  /// registry derives what it grades from a user column, and a child table
  /// with none is a table nothing grades.
  userId     String?

  attemptIndex Int
  modelId      String
  provider     String

  /// planned | pass_through
  plannerMode  String @default("planned")
  /// pending | not_dispatched | failed_pre_token | failed_post_token |
  /// cancelled | succeeded | unknown_after_dispatch
  ///
  /// `pending` is deliberately not one of `docs/policy/tomverse-chat-routing.md`
  /// §5's outcomes: that section enumerates how an attempt ended, and one in
  /// flight has not ended. Starting life as `not_dispatched` would leave every
  /// dispatched attempt labelled as one that never reached a provider --
  /// erasing the distinction that section draws to keep such an attempt out of
  /// provider billing.
  ///
  /// `unknown_after_dispatch` is the stale-attempt sweep's, and only its: a
  /// dispatch was recorded and the turn never came back to say how it ended.
  /// Not `failed_pre_token`, which would be a claim about a provider call
  /// nobody observed.
  outcome      String @default("pending")
  /// planner | adapter | manifest | billing | process | provider | stream | none
  ///
  /// `process` is this process stopping, which is not a provider failure --
  /// filing a host restart under `provider` would move conversations off a
  /// model that did nothing wrong.
  failureLayer String @default("none")

  /// Copied from the manifest at finalization, in the same transaction.
  ///
  /// Denormalised on purpose: "a dispatched attempt has a finalized manifest,
  /// finalized before dispatch" is then a single-row CHECK instead of a
  /// cross-table assertion nothing enforces. ROUTE-06 grades exactly this.
  manifestFinalizedAt DateTime?

  dispatchedAt        DateTime?
  providerRequestId   String?
  firstVisibleTokenAt DateTime?
  actualInputTokens   Int?
  actualOutputTokens  Int?
  /// A fixed classification, never provider error text.
  errorClass          String?

  manifest  ContextManifest?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  identityManifestId     String?
  identityManifestDigest String?

  identityManifest RoutingIdentityManifest? @relation(fields: [identityManifestId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  providerEndpointId String?
  modelDeploymentId  String?

  dispatchedEndpoint   ProviderEndpoint? @relation(fields: [providerEndpointId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  dispatchedDeployment ModelDeployment?  @relation(fields: [modelDeploymentId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([runId, attemptIndex])
  @@index([outcome, createdAt])
  @@index([modelId, createdAt])
  @@index([userId, createdAt])
}

/// The immutable record of what one attempt actually sent
/// (`docs/policy/tomverse-chat-routing.md` §5, manifest lifecycle).
///
/// One per attempt, and never shared: a fallback model may receive different
/// context, different tokenization and a different effective request, so a
/// manifest that two attempts both pointed at would describe neither.
/// `attemptId` is unique, which is that rule rather than a comment about it.
///
/// Source references and hashes only. `docs/policy/tomverse-chat-routing.md`
/// §5 and the delivery plan both say the
/// raw prompt is not duplicated here -- the manifest exists to prove what was
/// sent, and a copy of the prompt would make the proof a second copy of the
/// thing being proved.
///
/// Finalization is one-way and total: once `finalizedAt` is set, a trigger
/// refuses every further update. That is what makes the effective-request hash
/// evidence rather than a field. The same trigger pins `attemptId` from
/// creation, because a manifest's tokenizer and window were chosen for one
/// attempt's model and moving even a draft would mis-size the next one.
model ContextManifest {
  id        String         @id @default(cuid())
  attemptId String         @unique
  attempt   RoutingAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  userId    String?

  /// draft | finalized | not_dispatched
  state String @default("draft")

  /// Authorized source references: ids, versions and hashes. Never content.
  sourceRefs       Json
  summaryVersion   String?
  /// Which slice of the conversation was included, as indices or ids.
  inclusionRange   Json?
  /// Where content was cut, so a truncation can be explained afterwards.
  truncationPoints Json?

  /// The tokenizer that produced tokenCount, and the window it was checked
  /// against. Both live here rather than on the attempt because they are
  /// per-attempt facts that must agree with each other, and agreeing is a
  /// single-row CHECK only if they share a row.
  tokenizerVersion    String
  tokenCount          Int
  contextWindowTokens Int

  /// Added immediately before dispatch, in the same transaction that finalizes.
  plannerVersion        String?
  templateVersion       String?
  adapterVersion        String?
  structuredOptionsHash String?
  effectiveRequestHash  String?

  finalizedAt         DateTime?
  /// Why a draft was abandoned. Required when the state says it was.
  notDispatchedReason String?

  /// How the surviving hash can be checked later. The scheme version and the
  /// algorithm because both change; the key *id* because the key itself must
  /// never be stored, and a commitment nobody can name the key for is a
  /// commitment nobody can verify after a rotation.
  contentHashVersion String?
  hashAlgorithm      String?
  hashKeyId          String?

  /// MANIFEST-02. When the per-part detail was dropped and only the aggregate
  /// kept. A marker rather than an inference: without it a compacted manifest
  /// would read as a dispatch that described no sources at all, which is the
  /// misrepresentation `docs/policy/tomverse-chat-routing.md` §5 forbids.
  compactedAt DateTime?

  /// Why the detail went: "aged" for the retention sweep, or a privacy
  /// transition that outranks it. Account deletion is absent on purpose —
  /// it removes the row rather than compacting it, so it has no reason to
  /// record. Allowlist CHECK lives in the migration.
  compactionReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([state, createdAt])
  @@index([userId, createdAt])
}

// ==========================================
// Email notification system (MVP).
// Contract: docs/policy/email-notifications.md
//
// Three rules this schema exists to make structural rather than conventional:
//
//  - A message's classification decides whether it carries an unsubscribe
//    link, and that decision is a CHECK constraint, not a code path someone
//    can invert later (D-note 8.5).
//  - Nothing that identifies a delivery may be nullable. PostgreSQL treats
//    NULLs as distinct, so a unique index over a nullable column is not a
//    unique index at all -- see EmailDelivery.recipientKey and
//    SuppressionEntry.purposeKey.
//  - The credential lane stores no credential. Enforced here by CHECKs in the
//    migration, because "we agreed not to" is not a guarantee (§9.4a-3).
// ==========================================

/// One approved snapshot of every jurisdiction rule at a point in time.
///
/// Profiles are never edited in place: a change means a new version, which is
/// what lets "what were the rules the day we sent this" be answered at all. A
/// delivery pins the version it resolved against, so activating a new one
/// cannot change what an in-flight send renders (§12.5).
model EmailPolicyVersion {
  id      String @id @default(cuid())
  version String @unique

  /// draft | active | superseded. Exactly one row may be active; the partial
  /// unique index that enforces it lives in the migration.
  status          String    @default("draft")
  activatedAt     DateTime?
  supersededAt    DateTime?
  changeSummary   String
  approvedById    String?
  approvedByEmail String?
  approvedAt      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  profiles       JurisdictionProfile[]
  countryMap     JurisdictionCountryMap[]
  consentRecords ConsentRecord[]
  deliveries     EmailDelivery[]

  @@index([status, activatedAt])
}

/// The rules for one jurisdiction profile, as data rather than code.
///
/// Keyed by profile, not by country: the EEA is thirty countries and one
/// profile, and a member state that later needs its own rules becomes a new
/// profile plus a remapped row rather than a deploy (§10.2).
///
/// Deliberately holds values, never expressions. A profile that could express
/// conditions would be a program stored in a table, and changing it would be
/// riskier than shipping code rather than safer (§8.7).
model JurisdictionProfile {
  id         String @id @default(cuid())
  profileKey String

  policyVersionId String
  policyVersion   EmailPolicyVersion @relation(fields: [policyVersionId], references: [id], onDelete: Cascade)

  /// What the jurisdiction itself requires: opt_in | opt_out. Recorded as the
  /// law states it even though we send opt-in everywhere (C1), because a
  /// profile that lies about its jurisdiction is useless as evidence.
  marketingBasis String

  /// Prefixed to marketing subjects. "(광고)" in KR, "<ADV> " in SG.
  subjectPrefix String?

  /// Ordered footer block identifiers the renderer assembles, e.g.
  /// ["legal_name","postal_address","business_registration"].
  footerBlocks Json

  /// Quoted in copy only. Processing is always immediate everywhere (C3).
  unsubscribeSlaBusinessDays Int

  /// E7. How often consent must be *confirmed to the recipient* -- KR is 24.
  /// This is a notice interval, not an expiry: a recipient who does not answer
  /// keeps their consent (docs/policy/email-notifications.md §5.5). NULL where
  /// no such duty exists.
  consentNoticeIntervalMonths Int?

  /// { start, end, tz }. Held back rather than sent during these hours.
  quietHours Json?

  /// CASL's 2-year/6-month implied consent windows. Present so the profile can
  /// describe the jurisdiction truthfully; unused while C8 holds.
  impliedConsentDays Json?

  /// Source and confirmation date for every value above. An operator editing a
  /// profile has to be able to see what the value is based on.
  notes String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([profileKey, policyVersionId])
  @@index([policyVersionId])
}

/// Which profile a country resolves to, per policy version.
model JurisdictionCountryMap {
  id          String @id @default(cuid())
  countryCode String
  profileKey  String

  policyVersionId String
  policyVersion   EmailPolicyVersion @relation(fields: [policyVersionId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([countryCode, policyVersionId])
  @@index([policyVersionId, profileKey])
}

/// A message we can send, and what kind of message it is.
///
/// `classification` is the field everything else keys off: it decides the
/// recipient set, the footer, whether an unsubscribe link appears, and whether
/// a human has to approve the send. It is chosen once and cannot be edited to
/// something incompatible with the versions already published under it.
/// A user-facing announcement, from draft to sent.
///
/// Contract: .github/audits/model-lifecycle-email-2026-08-22.md §12.2, EM-06.
///
/// The layer above EmailEvent. An event is one fan-out; a campaign is the
/// decision to make one, who approved it, and what they approved. Kept apart
/// from EmailEvent because approval is a property of the campaign and not of
/// the outbox: adding draft and pending_approval to EmailEvent.status would put
/// approval vocabulary in the table that also holds login codes.
model EmailCampaign {
  id String @id @default(cuid())

  /// model_launch | model_upgrade | model_retirement | model_migration
  ///  | model_incident | other
  category String

  /// classification and purpose are derived from this, never stored again.
  templateKey String

  /// draft | pending_approval | approved | running | completed | cancelled
  ///  | halted
  status String @default("draft")

  /// The languages this campaign sends in.
  locales Json

  /// language -> template payload, captured while the campaign is a draft.
  ///
  /// The payload is the copy the approver previews and the outbox later
  /// snapshots for each recipient. It is deliberately separate from
  /// `audienceSpec`: one says what to send and the other says who may receive
  /// it. NULL is kept only for rows created before campaign-authored content
  /// existed; those rows fail closed at approval and send.
  contentByLocale Json?

  /// Handed to each wave's EmailEvent unchanged.
  audienceSpec Json

  /// language -> TemplateVersion.id, pinned when the campaign was approved.
  ///
  /// EM-06. Copy changes mint a new TemplateVersion automatically, so without a
  /// pin an approval would silently come to cover text nobody approved.
  templateVersionIds Json?

  approvalId String?
  approvedAt DateTime?

  /// manual | auto_draft | approved_schedule -- how this campaign's waves are
  /// started. `manual` means an operator runs each one; `approved_schedule`
  /// means the scheduler does, once the campaign is approved.
  triggerMode String @default("manual")

  /// When the first wave is due. The operative times live on the waves; this is
  /// the campaign's own answer to "when does this start", for a list to sort by.
  scheduledAt DateTime?

  /// What this campaign is about, when it is about a model.
  ///
  /// Nullable because a campaign need not be: `category = other` has no model.
  /// Not derived from audienceSpec -- that says who to write to, which is a
  /// different question from what the notice is about.
  workItemId         String?
  targetModelId      String?
  replacementModelId String?

  /// When the automatic transition happens, and the timezone the notice names
  /// it in. Both or neither: a UTC instant with no label reads as a different
  /// day to the reader than to the person who set it.
  effectiveAt   DateTime?
  timezoneLabel String?

  /// Which version of the audience definition produced the estimate below.
  /// Bumped when the cohort rules change, so an old estimate is recognisably
  /// old rather than merely stale.
  audienceVersion     Int  @default(1)
  estimatedRecipients Int?

  /// When the estimate above was measured, and by whom.
  ///
  /// An estimate with no timestamp is a number of unknown age against an
  /// audience that moves daily. Both are NULL until something measures it --
  /// which, before the eighth slice, nothing did.
  estimatedAt      DateTime?
  estimatedByEmail String?

  /// The full AudienceSummary the estimate came from.
  ///
  /// The exclusion breakdown is the part that says the audience query is
  /// wrong, and keeping it only in the computing request's response would mean
  /// the second administrator reviewing this campaign never sees it.
  audienceEstimate Json?

  /// Whether the copy promises Tomverse will change the model automatically.
  ///
  /// A retirement notice can say "please pick another model" without promising
  /// anything, and that sentence is always safe. The promise is not: it is
  /// gated on the twelve conditions of section 13.3
  /// (lib/automaticTransitionClaim.ts), and this flag is what says the campaign
  /// is making it.
  claimsAutomaticTransition Boolean @default(false)

  createdByEmail String

  cancelledAt  DateTime?
  cancelReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  waves        EmailCampaignWave[]
  recipients   EmailCampaignRecipient[]
  attestations EmailCampaignAttestation[]

  @@index([status, createdAt])
  @@index([templateKey])
}

/// One send within a campaign.
///
/// A campaign may notify, remind and then confirm; each is its own fan-out with
/// its own event, cap and dry-run flag, and each has to be resumable on its
/// own.
model EmailCampaignWave {
  id         String        @id @default(cuid())
  campaignId String
  campaign   EmailCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  /// launch | notice | reminder | final_reminder | completion
  kind     String
  sequence Int

  /// The EmailEvent this wave expanded into, once it has one.
  eventId String?

  /// pending | expanding | expanded | sending | done | cancelled | halted
  status String @default("pending")

  /// When this wave is due. NULL means an operator starts it by hand.
  ///
  /// The wave row exists before it runs, which is what makes scheduling
  /// possible at all: a wave that has not been created cannot be found by a
  /// scheduler looking for due work.
  scheduledAt DateTime?

  recipientCap  Int?
  dryRun        Boolean @default(false)
  expandedCount Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  recipients EmailCampaignRecipient[]

  @@unique([campaignId, kind, sequence])
  @@index([status, createdAt])
  @@index([status, scheduledAt])
}

/// The three conditions of section 13.3 that no field holds, recorded as
/// somebody having said them.
///
/// An attestation with nowhere to live is a parameter a caller could pass
/// `true` for. What makes it worth anything is who said it and when, so those
/// are columns rather than a boolean.
///
/// `differences_stated` carries the body digest it was made against and stops
/// counting when the copy moves -- it is a claim about the words, and the words
/// moved. The other two are about the migration, which a copy edit does not
/// undo. See lib/emailCampaignAttestationCore.ts.
model EmailCampaignAttestation {
  id         String        @id @default(cuid())
  campaignId String
  campaign   EmailCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  /// differences_stated | staging_verified | reconciliation_ready
  kind String

  attestedByEmail String
  attestedAt      DateTime @default(now())

  /// What the person wants the next reader to know. Never required: an empty
  /// note is honest, an invented one is not.
  note String?

  /// The body digest at the moment this was made. NULL for kinds that are not
  /// about the body.
  contentDigest String?

  createdAt DateTime @default(now())

  @@unique([campaignId, kind])
}

/// The campaign's record of who was in the audience, including the people it
/// wrote nothing for.
///
/// `EmailDelivery` records what was sent. This answers the opposite question --
/// who was considered and got nothing, and why -- which no other table can,
/// because the reasons somebody is skipped are exactly the reasons no delivery
/// row exists for them
/// (.github/audits/model-lifecycle-email-2026-08-22.md §12.2).
///
/// `malformed` is a column rather than an `excludedReason`: an unreadable
/// stored value means the account cannot be migrated automatically, not that it
/// should be left uninformed. See lib/emailCampaignRecipientCore.ts.
model EmailCampaignRecipient {
  id         String        @id @default(cuid())
  campaignId String
  campaign   EmailCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  waveId String
  wave   EmailCampaignWave @relation(fields: [waveId], references: [id], onDelete: Cascade)

  /// Cascaded, unlike EmailDelivery's SetNull. A delivery row is evidence that
  /// a required notice was delivered and outlives the account for that reason;
  /// this row is the record that one was *not*, which nothing obliges anybody
  /// to keep -- and it holds the address, so keeping it unlinked would be the
  /// worse of the two outcomes rather than the safer one.
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Recorded as it was at expansion, so the ledger still reads correctly after
  /// the account changes address or language.
  emailAddress        String?
  language            String?
  jurisdictionCountry String?

  /// default_model | new_conversation_lead | conversation_selection
  ///  | marketing_consent
  /// The strongest link when several apply; NULL only when the person is no
  /// longer in any cohort, which is what `already_changed` means.
  eligibilityReason String?

  /// no_email | account_inactive | suppressed | no_consent | plan_incompatible
  ///  | already_changed. NULL means a delivery row was written.
  excludedReason String?

  /// Set when this person did receive a row, so the ledger and the outbox can
  /// be reconciled without matching on address.
  deliveryId String? @unique

  /// A stored value the parser could not read. Reported, never rewritten.
  malformed Boolean @default(false)

  createdAt DateTime @default(now())

  @@unique([waveId, userId])
  @@index([campaignId, excludedReason])
}

model EmailTemplate {
  id  String @id @default(cuid())
  key String @unique

  /// transactional | service | legal | marketing
  classification String

  /// Which EmailPreference.purpose gates this. Required for marketing and
  /// service, absent for transactional and legal -- those are not opt-outable.
  purpose String?

  /// Derived from classification, stored anyway so a CHECK can hold the two
  /// together and a static test can read the intent without re-deriving it.
  requiresUnsubscribe Boolean

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  versions TemplateVersion[]
  events   EmailEvent[]

  @@index([classification])
}

/// One immutable published rendering source, per template per language.
///
/// Published versions are never edited. The renderer must be deterministic for
/// a given version, because the provider only suppresses a duplicate when the
/// retried payload is byte-identical (§9.3), and because an audit that
/// re-renders from a changed template proves nothing.
model TemplateVersion {
  id         String        @id @default(cuid())
  templateId String
  template   EmailTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  version  Int
  language String

  subject  String
  bodyHtml String
  bodyText String

  /// Over the three fields above. Detects an edit that bypassed the workflow.
  contentHash String

  /// The send metadata this version was published under. Written once; a
  /// trigger refuses any change, so a template reclassified in code becomes a
  /// new version rather than an edited one. The drain compares these to the
  /// definition it sends under and refuses a mismatch. `EmailTemplate` keeps
  /// its copies for history only -- nothing decides a send from them.
  /// Contract: docs/policy/email-notifications.md §10.2.
  classification      String
  purpose             String?
  requiresUnsubscribe Boolean

  /// draft | published | retired
  status           String    @default("draft")
  publishedAt      DateTime?
  publishedById    String?
  publishedByEmail String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  deliveries EmailDelivery[]

  @@unique([templateId, version, language])
  @@index([templateId, status, language])
  @@index([classification])
}

/// What a user currently receives. Mutable; the history lives in ConsentRecord.
///
/// security and billing rows exist but cannot be disabled -- an attacker who
/// can turn off security mail turns off the warning about themselves, and a
/// receipt is contract performance rather than a preference. They are shown
/// locked rather than hidden, because "there is no setting for it" is a common
/// reason people reach for the spam button instead.
model EmailPreference {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// security | billing | service_status | product_updates | newsletter | promotions
  purpose String
  enabled Boolean

  /// signup | preference_center | unsubscribe_link | admin | system_default
  ///   | privacy_request | provider_complaint
  source String

  /// When the current enabled state began. Not the row's creation.
  grantedAt DateTime?

  /// The double opt-in (docs/policy/email-double-opt-in.md §4.1). confirmedAt
  /// is when the mailbox owner clicked the confirmation link and is the only
  /// thing that makes a consent-based purpose sendable; NULL is refused by the
  /// send gate even when `enabled` is true. confirmationRequestedAt is the
  /// latest request, and a confirmation token is honoured only while it still
  /// names its request id. Both go back to NULL when the purpose is switched off.
  confirmedAt             DateTime?
  confirmationRequestedAt DateTime?
  /// Random id of the latest request; a confirmation token must name it.
  confirmationRequestId   String?

  /// E7. When consent was last confirmed *to* the recipient, and when it is
  /// next due. Passing nextConfirmationNoticeAt does not change `enabled`:
  /// the duty is to notify, not to expire (docs/policy/email-notifications.md
  /// §5.5). Automatic lapse is a
  /// separate business policy behind its own flag, default off.
  lastConfirmationNoticeAt DateTime?
  nextConfirmationNoticeAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, purpose])
  @@index([nextConfirmationNoticeAt])
  @@index([purpose, enabled])
}

/// Append-only consent history. Never updated, never deleted with the account.
///
/// EmailPreference answers "what now"; this answers "when, on what basis, and
/// under which policy". CASL and the Australian Spam Act both put the burden of
/// proving consent on the sender, and a row that gets overwritten proves
/// nothing. jurisdiction is the value resolved at the time and is never
/// rewritten when the account later moves (§6.4).
model ConsentRecord {
  id     String  @id @default(cuid())
  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  /// The address as it was. Preserved when the account changes address, since
  /// consent attaches to an address rather than to a row
  /// (docs/policy/email-notifications.md §13.4).
  emailAddress String
  purpose      String

  /// granted | withdrawn | reconfirmed | confirmation_notice_sent
  ///   | confirmation_requested | lapsed
  /// confirmation_requested is the double opt-in's request, not a consent: it
  /// records that a confirmation mail was asked for and nothing more.
  action     String
  occurredAt DateTime @default(now())

  jurisdiction       String
  jurisdictionSource String

  policyVersionId String
  policyVersion   EmailPolicyVersion @relation(fields: [policyVersionId], references: [id])

  /// signup_form | preference_center | unsubscribe_page | import | admin
  ///   | provider_complaint
  capturedVia String

  /// Consent wording hash, screen identifier, request metadata. Never the raw
  /// request.
  evidence Json?

  /// Salted hashes. The raw IP is not evidence of anything the hash is not,
  /// and storing it would be collecting more than the purpose needs.
  ipHash        String?
  userAgentHash String?

  createdAt DateTime @default(now())

  @@index([userId, purpose, occurredAt])
  @@index([emailAddress, occurredAt])
  @@index([policyVersionId])
}

/// Addresses we must not send to, and why.
///
/// Keyed by address rather than by user: a spam complaint follows the mailbox,
/// so deleting an account and signing up again must not clear it.
///
/// The provenance columns are gating inputs, not reporting conveniences. A
/// complaint raised against a marketing message and one raised against a login
/// code mean opposite things -- the first is ordinary, the second is either an
/// account takeover in progress or proof we are misclassifying mail
/// (docs/policy/email-notifications.md §13.3).
/// One cause of a suppression, append-only. Written beside SuppressionEntry in
/// the shadow deploy and not yet read by any send decision. Identity and
/// provenance never change; a release is written once. A trigger carries entry
/// writes from a build that does not write causes itself.
/// Contract: docs/policy/email-product-news-redesign-draft.md, section 7.4.
model SuppressionCause {
  id           String @id @default(cuid())
  emailAddress String

  /// global | classification | purpose
  scope      String
  /// "*" for global, the classification name ("marketing") or the purpose.
  purposeKey String

  /// hard_bounce | soft_bounce | complaint | unsubscribe | manual | privacy_request
  reason String
  source String

  /// Stable per writer, so a retried event adds nothing: webhook:<eventId>,
  /// softbounce:<deliveryId>, preference:<transitionId>, admin:<key>,
  /// legacy:suppression:<entryId>, legacy-trigger:<entryId>:<uuid>.
  sourceEventKey String

  sourceStream         String?
  sourceDomain         String?
  sourceClassification String?
  sourceDeliveryId     String?
  sourceMessageId      String?
  sourceRequestId      String?
  providerAccount      String?
  evidence             Json?

  occurredAt DateTime
  expiresAt  DateTime?

  releasedAt      DateTime?
  releaseKind     String?
  releaseEvidence Json?

  createdAt DateTime @default(now())

  @@unique([emailAddress, scope, purposeKey, reason, sourceEventKey], map: "SuppressionCause_selector_reason_event_key")
  @@index([emailAddress, releasedAt])
  @@index([expiresAt])
}

/// Every change to a preference's enabled state, append-only. Gives a withdrawal
/// that records no consent a stable id for the suppression cause it creates.
/// Contract: docs/policy/email-product-news-redesign-draft.md, section 7.4.
model EmailPreferenceTransition {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  purpose         String
  fromEnabled     Boolean
  toEnabled       Boolean
  /// signup | preference_center | unsubscribe_link | admin | system_default
  ///   | consent_confirmation | privacy_request | provider_complaint
  source          String
  consentRecordId String?
  occurredAt      DateTime @default(now())

  @@index([userId, purpose, occurredAt])
}

model SuppressionEntry {
  id           String @id @default(cuid())
  emailAddress String

  /// global | purpose
  scope String

  /// The purpose this suppression covers, or "*" for global. Non-null on
  /// purpose: a nullable column here would let the unique index below admit
  /// unlimited duplicate global suppressions for one address.
  purposeKey String

  /// hard_bounce | soft_bounce | complaint | unsubscribe | manual | privacy_request
  reason String

  /// provider_webhook | unsubscribe_link | preference_center | admin
  source String

  sourceStream         String?
  sourceDomain         String?
  sourceClassification String?
  sourceDeliveryId     String?
  sourceMessageId      String?

  occurredAt DateTime @default(now())

  /// Set only for soft_bounce, which is the one temporary suppression. A hard
  /// bounce or a complaint has no expiry -- the CHECK in the migration says so.
  expiresAt DateTime?

  evidence Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([emailAddress, scope, purposeKey])
  @@index([emailAddress])
  @@index([reason, sourceStream, occurredAt])
  @@index([expiresAt])
}

/// Something happened that people may need to hear about. The outbox row.
///
/// Written in the same transaction as whatever caused it, so a crash anywhere
/// downstream cannot lose the notification. Fan-out is separate and resumable:
/// "the terms changed" is one event and a delivery per account, and expanding
/// that cannot be an operation that has to finish in one pass.
model EmailEvent {
  id   String @id @default(cuid())
  kind String

  templateId String
  template   EmailTemplate @relation(fields: [templateId], references: [id])

  referenceType String?
  referenceId   String?

  /// Only what the template's version actually reads. Never a dump of the
  /// source row, and never a credential (§9.4a-3).
  payload Json

  /// single_user | user_segment | all_users
  audienceKind String
  audienceSpec Json?

  /// pending | expanding | expanded | failed
  status String @default("pending")

  /// Where a partial fan-out stopped, so the next pass resumes rather than
  /// restarts.
  expansionCursor String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  deliveries EmailDelivery[]

  @@index([status, createdAt])
  @@index([templateId, createdAt])
}

/// One message to one recipient, and everything needed to answer for it later.
///
/// Two lanes with different guarantees:
///
///  - standard: at-least-once. A process that dies still delivers, and the
///    provider's idempotency key stops the duplicate.
///  - credential_sync: sent inside the request and not retried afterwards.
///    The row preserves the *record* of the send; it does not promise the send
///    (§9.4a-3). Nothing here can re-render a login code, by design: the
///    plaintext exists only in the request that created it.
model EmailDelivery {
  id      String     @id @default(cuid())
  eventId String
  event   EmailEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  /// "user:<id>" for an account, "addr:<normalized email>" otherwise. Non-null
  /// so the unique index below actually holds: with a nullable userId it did
  /// not, and re-running fan-out piled up duplicate rows for every recipient
  /// without an account.
  recipientKey String

  /// credential_sync | standard
  lane String @default("standard")

  /// The address at send time. Kept even after the account changes address.
  emailAddress String
  language     String

  /// Resolved once, at fan-out. Both are pinned so that activating a new
  /// policy version mid-flight cannot change what this row renders -- which
  /// would silently invalidate its idempotency key.
  jurisdictionCountry    String
  jurisdictionProfileKey String

  policyVersionId String
  policyVersion   EmailPolicyVersion @relation(fields: [policyVersionId], references: [id])

  templateVersionId String
  templateVersion   TemplateVersion @relation(fields: [templateVersionId], references: [id])

  /// hash(eventId, recipientKey, templateVersionId, policyVersionId). Stable
  /// across attempts, which is the whole reason the provider can suppress a
  /// duplicate.
  idempotencyKey String @unique

  /// pending | sent | delivered | bounced | complained | suppressed | skipped
  ///   | failed | abandoned
  ///
  /// failed: finished without retries left to try. The only failure terminus
  ///   on the credential lane, and the terminus for a permanent 4xx elsewhere.
  /// abandoned: retries exhausted. Standard lane only -- the credential lane
  ///   has none to exhaust, and a CHECK keeps it from appearing there.
  status String @default("pending")

  /// Why nothing was sent. Not sending is a decision we have to answer for too.
  /// no_consent | consent_lapsed | suppressed_complaint | hard_bounce
  ///   | quiet_hours | jurisdiction_conflict | jurisdiction_unconfirmed
  ///   | jurisdiction_profile_missing | jurisdiction_footer_incomplete
  ///   | credential_expired | dry_run | marketing_halted | marketing_disabled
  ///   | marketing_country_not_allowed | campaign_cancelled
  skipReason String?

  /// Why a still-pending row waits for nextAttemptAt when the wait is not a
  /// retry. quiet_hours: a night-time window (docs/policy/email-notifications.md
  /// §5.2 E5). Cleared when the row is next attempted; kept apart from
  /// lastErrorKind so waiting is never recorded as an error.
  deferReason String?

  attempts      Int       @default(0)
  nextAttemptAt DateTime?
  lastAttemptAt DateTime?

  /// A short classification such as "http_502". Never a provider response body.
  lastErrorKind String?

  /// Set when one sender claims the row, so the request path and a worker
  /// cannot both send it.
  claimedAt DateTime?
  claimedBy String?

  providerMessageId String?

  /// Audit snapshot. Null until the message is first rendered.
  renderedSubject String?

  /// A keyed HMAC, not a digest. A plain hash of a body containing a six-digit
  /// code is itself the attack: the space is 10^6. Keyed means the key must
  /// outlive the record, so the version that produced it is stored alongside
  /// (§10.3-7).
  renderedHash           String?
  renderedHashKeyVersion String?

  /// The personalisation inputs, minimised and encrypted, so the message can be
  /// reconstructed rather than merely attested to. Always NULL on the
  /// credential lane -- there the inputs *are* the credential, so minimising
  /// leaves nothing (§9.4a-3). A CHECK enforces that.
  renderDataSnapshot Json?
  snapshotPurgedAt   DateTime?

  sentAt      DateTime?
  deliveredAt DateTime?

  /// The last provider event that moved this delivery's status, as its order
  /// key (occurredAt, rank, provider event id). An event whose key is not later
  /// leaves the status alone, so events processed out of order converge. All
  /// three are set together or not at all
  /// (docs/policy/email-product-news-redesign-draft.md, section 7.4).
  providerEventAt   DateTime?
  providerEventRank Int?
  providerEventId   String?
  /// When the latest soft bounce or deferral reported for this delivery
  /// happened. deliveredAt is likewise the latest delivered event's own time.
  softBounceAt      DateTime?

  /// The EMAIL_UNSUBSCRIBE_KEYS version that signed the unsubscribe link in the
  /// message as sent. NULL for mail with no link. Readiness refuses to lose a
  /// version used within the last year
  /// (docs/policy/email-notifications.md §11.4).
  unsubscribeKeyVersion String?

  /// The provider account (transactional | marketing) and the From address and
  /// domain the message actually went out as, fixed at send. A webhook binds to
  /// the delivery of its own account; a suppression cause records the domain
  /// that was used, not what configuration says later.
  providerAccount String?
  sentFrom        String?
  sentDomain      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([eventId, recipientKey])
  @@index([status, lane, nextAttemptAt])
  @@index([eventId, status])
  @@index([userId, createdAt])
  @@index([emailAddress, createdAt])
  @@index([status, snapshotPurgedAt])
  @@index([unsubscribeKeyVersion, sentAt])
  @@index([providerAccount, providerMessageId])
}

/// One inert unsubscribe token per key version, minted with that key the first
/// time it signs a real link. Readiness decrypts each against the live keyring:
/// a version dropped or changed while mail still depends on it is found before
/// a recipient finds it. The token acts on nobody and is never sent to the
/// endpoint. Contract: docs/policy/email-notifications.md §11.4.
model EmailUnsubscribeKeyCanary {
  id         String   @id @default(cuid())
  keyVersion String   @unique
  token      String
  createdAt  DateTime @default(now())
}

/// The one-time adoption of the keyring as the guard for mail sent before key
/// versions were recorded. At most one row (singleton unique + CHECK). Written
/// by the first drain that finds such mail. Contract:
/// docs/policy/email-notifications.md §11.4.
model EmailUnsubscribeKeyAdoption {
  id          String   @id @default(cuid())
  keyVersions String[]
  adoptedAt   DateTime @default(now())
  singleton   Boolean  @unique @default(true)
}

/// Raw provider callbacks, stored before they are acted on.
///
/// The unique key is the provider's own event id (Resend sends `svix-id`),
/// which is what makes a redelivered webhook a no-op rather than a second state
/// change. Same shape as StripeWebhookEventLog, for the same reason.
model ProviderWebhookEvent {
  id       String @id @default(cuid())
  provider String

  providerEventId String
  eventType       String

  receivedAt  DateTime  @default(now())
  processedAt DateTime?

  payload Json

  processingError String?

  /// The claim of the worker applying the event: a random lease id, when it
  /// started, and how many claims there have been. Every outcome a worker
  /// records is fenced on its lease id, so one whose lease expired changes
  /// nothing. Out of attempts after ten, the row is abandoned; processed and
  /// abandoned never both hold
  /// (docs/policy/email-product-news-redesign-draft.md, section 7.4).
  processingLeaseId   String?
  processingStartedAt DateTime?
  processingAttempts  Int       @default(0)
  abandonedAt         DateTime?

  /// transactional | marketing -- the provider account whose endpoint and
  /// signing secret the event came through. Event ids are unique per account,
  /// and a message id is matched only within the account that sent it
  /// (docs/policy/email-product-news-redesign-draft.md, section 7.4, C56).
  /// The default is for the previous build, which does not write the column
  /// and only ever served the transactional account; it goes with the old
  /// unique in a later migration.
  providerAccount String @default("transactional")

  @@unique([provider, providerEventId])
  @@unique([provider, providerAccount, providerEventId], map: "ProviderWebhookEvent_account_event_key")
  @@index([provider, eventType, receivedAt])
  @@index([processedAt])
  @@index([provider, providerAccount, receivedAt], map: "ProviderWebhookEvent_provider_account_receivedAt_idx")
}

/// The one row that says a Tomverse Conversation was started from an imported
/// external conversation.
///
/// Policy: docs/policy/external-conversation-continuation.md.
///
/// ## What it is not
///
/// It is not a copy of the source. No external message text, no title and no
/// provider conversation id lives here: the transcript stays in
/// ExternalMessage, which is immutable, and this row only records *which*
/// snapshot the user chose and what was seeded from it. Copying the title
/// alone would put the source's own words back into a table the deletion of
/// that source does not reach.
///
/// It is also not a lineage pointer. `sourceConversationDigest` names one
/// immutable snapshot
/// (docs/policy/external-conversation-import-and-memory.md §4.2), and the
/// bridge never
/// follows a newer snapshot of the same lineage -- the user chose the version
/// they were reading.
///
/// ## Why the two deletes differ
///
/// `conversationId` cascades: a Tomverse conversation that is deleted takes
/// its bridge with it, because the bridge is a fact about that conversation.
///
/// `externalConversationId` is `SetNull`: deleting the source must never take
/// the user's own new messages with it. The FK going NULL is what makes
/// `sourceDeletedAt` necessary -- a NULL alone reads exactly like a bridge
/// whose source was never set, and the screen owes the owner the difference
/// between "there is no original" and "the original was deleted".
model ConversationContinuationBridge {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// One bridge per conversation. A second bridge on the same conversation
  /// would make "which source is this continuing" a question with two answers.
  conversationId String       @unique
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  externalConversationId String?
  externalConversation   ExternalConversation? @relation(fields: [externalConversationId], references: [id], onDelete: SetNull)

  /// Provenance kept after the source is gone. Allowlist CHECK lives in the
  /// migration; the application copy is lib/externalImportProviders.ts.
  provider String

  /// When the source snapshot was imported -- non-sensitive provenance the
  /// screen states, and the only source timestamp kept here.
  sourceImportedAt DateTime

  /// Which immutable snapshot this bridge points at
  /// (docs/policy/external-conversation-import-and-memory.md §4.1, §4.2). Server
  /// computed, never rendered and never logged: it identifies a snapshot, it
  /// is not an access credential and it is not shown to anyone.
  sourceConversationDigest String
  sourceDigestVersion      Int

  /// What the seed was built from, for the screen's truncation disclosure and
  /// for a later seed-version migration. Counts only -- never content.
  sourceMessageCount        Int
  seedFromOrdinal           Int
  seedToOrdinal             Int
  seedMessageCount          Int
  seedTruncatedMessageCount Int
  seedOmittedMessageCount   Int
  contextSeedVersion        String

  /// Set by the source deletion paths in the same transaction that removes the
  /// source, before the cascade takes the rows the classification needs.
  sourceDeletedAt DateTime?

  /// Request-scoped idempotency
  /// (docs/policy/external-conversation-continuation.md §5). One click that is
  /// retried by the
  /// browser or by a flaky network resolves to the same conversation; a second
  /// deliberate fork carries a new key and is a new conversation.
  idempotencyKey String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, idempotencyKey])
  @@index([userId, createdAt])
  @@index([externalConversationId])
}

model AmuxWorkerRuntime {
  workerName     String   @id
  instanceId     String
  generation     Int      @default(1)
  status         String   @default("starting")
  dispatchReady  Boolean  @default(false)
  heartbeatAt    DateTime
