// ==========================================
// External conversation import (Release A).
// Contract: docs/policy/external-conversation-import-and-memory.md §4, §5, §20.
// External conversations never live in Conversation/Message — source model
// labels stay provenance-only and must not reach runtime modelId semantics.
// ==========================================

model ExternalImport {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  provider String // "chatgpt" | "claude" — allowlist CHECK lives in the migration
  status   String @default("inspecting") // inspecting | staging | preview_ready | finalizing | completed | failed | cancelled

  /// Client-sent hint for fast duplicate-candidate detection only. Never an
  /// authoritative dedup input — the server recomputes every digest (§4.1).
  clientFingerprint   String?
  importDigest        String? // server-computed, set at finalize
  digestVersion       Int
  parserVersion       String
  sourceFormatVersion String?

  conversationCount Int    @default(0)
  messageCount      Int    @default(0)
  normalizedBytes   BigInt @default(0)
  truncationCount   Int    @default(0)
  duplicateCount    Int    @default(0)
  failureCode       String?

  /// Staging batch ledger (§5.5). Batches arrive strictly in sequence; only
  /// the most recent one may be idempotently retried, so one (sequence,
  /// digest) pair is enough to tell a retry from a conflicting resend.
  lastBatchSequence Int     @default(-1)
  lastBatchDigest   String?

  /// Set by the first successful finalize. A retry with the same key and the
  /// same import digest returns the stored success; a different key on a
  /// completed import is EXTERNAL_IMPORT_ALREADY_FINALIZED (§5.5).
  finalizeIdempotencyKey String?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  completedAt DateTime?

  conversations ExternalConversation[]

  @@index([userId, status])
  @@index([userId, createdAt])
  // Staging TTL sweep: stale non-terminal rows are found by last activity
  // (24h idle / 72h absolute, EXTERNAL_IMPORT_STORAGE_LIMITS).
  @@index([status, updatedAt])
}

model ExternalConversation {
  id     String         @id @default(cuid())
  userId String
  import ExternalImport @relation(fields: [importId], references: [id], onDelete: Cascade)

  importId String
  provider String

  /// Stable digest of the provider's own conversation ID (never the raw ID).
  /// Groups immutable snapshots of the same source lineage (§4.2).
  externalStableId String

  title             String
  sourceModelLabels Json?
  sourceCreatedAt   DateTime?
  sourceUpdatedAt   DateTime?

  /// Server-computed over ordered message dedup digests (§4.1). Unique per
  /// account: an exact re-import is a skip, a changed export becomes a new
  /// immutable snapshot row — existing rows are never merged into.
  conversationDigest String
  digestVersion      Int

  messageCount Int
  contentBytes BigInt

  finalized  Boolean  @default(false)
  importedAt DateTime @default(now())

  messages ExternalMessage[]

  @@unique([userId, conversationDigest])
  @@index([userId, externalStableId])
  @@index([userId, finalized])
  @@index([importId])
}

model ExternalMessage {
  id           String               @id @default(cuid())
  userId       String
  conversation ExternalConversation @relation(fields: [externalConversationId], references: [id], onDelete: Cascade)

  externalConversationId String
  externalStableId       String
  role                   String // "user" | "assistant" — allowlist CHECK lives in the migration

  content       String
  contentDigest String

  /// Digest of the pre-truncation normalized content. The unretained part is
  /// never stored — this digest is the only trace of it (§4.1, §5.4).
  originalContentDigest String?
  digestVersion         Int

  sourceModelLabel String?
  sourceTimestamp  DateTime?
  ordinal          Int

  truncated              Boolean @default(false)
  originalCharacterCount Int?
  retainedCharacterCount Int?

  @@unique([externalConversationId, ordinal])
  @@index([userId])
}
