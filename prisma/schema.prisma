model ChatCreditReservation {
  id                           String    @id
  userId                       String?
  user                         User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  subjectKey                   String
  traceId                      String
  source                       String
  provider                     String
  modelId                      String
  status                       String    @default("reserved")
  outcome                      String?
  idempotencyKey               String    @unique
  providerRequestId            String?
  providerResponseId           String?
  providerRequestLinkedAt      DateTime?
  reservationPayload           Json
  reservedCredits              Int
  reservedCostMicroUsd         BigInt
  planReservedCredits          Int
  addOnReservedCredits         Int
  settledCredits               Int       @default(0)
  settledCostMicroUsd          BigInt    @default(0)
  settledInputTokens           Int       @default(0)
  settledCachedInputTokens     Int       @default(0)
  /// Input tokens written into the prompt cache, at 1.25x the base input rate
  /// for the 5-minute TTL this application requests. Its own column beside the
  /// read count because the two move opposite ways -- a read is a discount and
  /// a write is a premium -- and summing them would price one at the other's
  /// rate. 0 on every row written before prompt caching existed, which is what
  /// those turns actually did.
  settledCacheWriteInputTokens Int       @default(0)
  settledOutputTokens          Int       @default(0)
  pricingSnapshot              Json?
  providerUsageSnapshot        Json?
  expiresAt                    DateTime
  settledAt                    DateTime?
  reconciledAt                 DateTime?
  lastError                    String?
  createdAt                    DateTime  @default(now())
  updatedAt                    DateTime  @updatedAt

  /// Which attempt the user's charge was computed from, once one was.
  ///
  /// A pointer rather than a flag on the attempt row, so ChatAttemptUsage
  /// stays completely immutable: the cost of an attempt is written when the
  /// attempt ends, and which attempt the user pays for is not known until
  /// settlement. A flag would have needed an UPDATE on an audit row.
  ///
  /// Structurally "at most one" -- one column, one row. NULL is honest and
  /// reachable: a turn whose process died after dispatching has attempt costs
  /// and no settlement, and saying so beats guessing which one it would have
  /// been. A composite foreign key makes the index it names a real attempt of
  /// this reservation rather than any integer.
  settlementAttemptIndex Int?
  settlementAttempt      ChatAttemptUsage?  @relation("ReservationSettlementAttempt", fields: [id, settlementAttemptIndex], references: [reservationId, attemptIndex], onDelete: NoAction, onUpdate: NoAction, map: "ChatCreditReservation_settlementAttempt_fkey")
  attemptUsage           ChatAttemptUsage[]

  @@index([status, expiresAt])
  @@index([userId, createdAt])
  @@index([traceId])
  @@index([providerRequestId])
  @@index([providerResponseId])
}

// What one dispatched attempt cost, at its own provider's rates.
//
// The reservation above holds one modelId, one provider and one price
// snapshot, which is the whole truth about a turn that dispatched once. A
// fallback dispatches twice, and routing policy §7 keeps two ledgers apart:
// the user's charge is the accepted usage of one attempt, while provider cost
// accounting is every attempt and "must not" be rewritten by a goodwill
// refund. One row per attempt is what lets the second sentence be true --
// with the identifiers on the reservation alone, the primary's request id
// wins and the fallback's is simply lost
// (linkChatReservationProviderRequest only writes into null columns).
//
// Deliberately not user-scoped. It hangs off the reservation, which survives
// account deletion with userId set to NULL because it is a financial record;
// these rows carry model ids, token counts and costs, and nothing about what
// was asked.
model ChatAttemptUsage {
  id                 String                @id @default(cuid())
  reservationId      String
  reservation        ChatCreditReservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  /// 0 for the primary. Matches RoutingAttempt.attemptIndex within the run.
  attemptIndex       Int
  modelId            String
  provider           String
  outcome            String
  providerRequestId  String?
  providerResponseId String?

  /// NULL only on a crash-reconciled row: nobody observed the call, and 0
  /// would be a claim that it used nothing.
  inputTokens           Int?
  cachedInputTokens     Int?
  /// Input tokens this attempt wrote into the prompt cache. NULL under the
  /// same rule as its siblings: nobody observed the call.
  cacheWriteInputTokens Int?
  outputTokens          Int?
  reasoningTokens       Int?
  costMicroUsd          BigInt   @default(0)
  /// How the token counts were arrived at: provider_usage_metadata,
  /// provider_response_cost, fallback_estimator, crash_reconciliation.
  usageSource           String   @default("provider_usage_metadata")
  /// How the cost was: token_estimate, provider_response, or
  /// reserved_upper_bound — an upper bound, not a measurement.
  costSource            String   @default("token_estimate")
  /// The rates this attempt was priced at, and where the figure came from.
  pricingSnapshot       Json?
  /// The ProviderDailyUsage day this row's cost was rolled up on, at midnight
  /// UTC. Stored rather than inferred from createdAt: a correction has to
  /// reach the same rollup row, and the two clocks disagree across midnight.
  rollupDate            DateTime

  createdAt DateTime @default(now())

  /// The reservations that settled against this attempt. At most one, and the
  /// composite foreign key is what makes the pointer name a real attempt of
  /// that reservation rather than any integer.
  settledReservations ChatCreditReservation[]      @relation("ReservationSettlementAttempt")
  adjustments         ChatAttemptUsageAdjustment[]

  @@unique([reservationId, attemptIndex])
  @@index([provider, createdAt])
  @@index([providerRequestId])
}

// A correction to what an attempt cost, appended rather than applied.
//
// A crash-reconciled cost row is an upper bound written because the call
// happened. Real usage can arrive afterwards, and the unique key on the base
// row means a second insert is silently skipped -- silently being the problem,
// because the estimate would stand for ever while the truth was known and
// discarded. The base row stays immutable and the observation lands here with
// the signed difference it makes; resolved cost is base plus adjustments.
model ChatAttemptUsageAdjustment {
  id            String           @id @default(cuid())
  reservationId String
  attemptIndex  Int
  attempt       ChatAttemptUsage @relation(fields: [reservationId, attemptIndex], references: [reservationId, attemptIndex], onDelete: Cascade, map: "ChatAttemptUsageAdjustment_attempt_fkey")
  /// Only `late_provider_actual` today.
  kind          String

  observedInputTokens           Int?
  observedCachedInputTokens     Int?
  observedCacheWriteInputTokens Int?
  observedOutputTokens          Int?
  observedCostMicroUsd          BigInt
  /// Signed: observed minus what the base row already claimed.
  costDeltaMicroUsd             BigInt

  /// Identifies the observation, so the same one twice is one adjustment.
  observationId     String
  providerRequestId String?
  /// Whether the delta has reached ProviderDailyUsage yet.
  appliedAt         DateTime?
  createdAt         DateTime  @default(now())

  @@unique([reservationId, attemptIndex, observationId], map: "ChatAttemptUsageAdjustment_observation_key")
  /// Partial in the database (`WHERE "appliedAt" IS NULL`), which Prisma
  /// cannot express; the name is mapped so the two do not read as drift.
  @@index([createdAt], map: "ChatAttemptUsageAdjustment_unapplied_idx")
}

// One image generation request in the image work mode: the operational
// record (prompt, pinned provider parameters, lifecycle status). Financial
// numbers live in ImageCreditReservation, which deliberately does NOT
// cascade with this row or its conversation -- deleting a chat must not
// delete the audit trail of what was charged.
// Policy: docs/policy/image-generation.md.
model ImageGeneration {
  id             String @id @default(cuid())
  userId         String
  conversationId String
  idempotencyKey String
  prompt         String
  preset         String // draft | standard | final
  provider       String @default("openai")
  modelId        String @default("gpt-image-2")
  size           String // 1024x1024 | 1536x1024 | 1024x1536
  quality        String // low | medium | high

  // What the returned bytes actually are, read from the file's own header
  // (policy §12.1). Not deducible from `size`: each provider translates a
  // resolution tier its own way, and Google's 1K landscape is not 1536x1024.
  // Nullable and never backfilled -- rows written before this existed are
  // history, and a dimension nobody measured is absent rather than inferred.
  outputWidth  Int?
  outputHeight Int?

  // The parameters this attempt actually sent to the provider (policy §12.1).
  // Reconstructing them from `size`/`quality` stopped being possible once each
  // provider started translating a resolution tier its own way, and a price
  // dispute turns on what was sent, not on what the row implies.
  //
  // The prompt is deliberately NOT in here: it is already on this row, and
  // duplicating user content into an audit blob would create a second place
  // every deletion path has to find.
  providerRequestParams Json?
  backgroundMode        String @default("opaque")
  outputFormat          String @default("png")
  moderationMode        String @default("auto")

  // pending -> processing -> settling -> succeeded | failed. `settling` is
  // the exactly-once claim: the worker or the reconciliation sweep moves a
  // row here with a conditional update before touching the credit ledger,
  // so the two can never settle or refund the same generation twice.
  // Transitions are defined in lib/imageGenerationStateCore.ts.
  status              String  @default("pending")
  failurePhase        String? // provider_moderation_rejected | provider_user_error | provider_rate_limited | provider_failed | original_storage_failed | stale_job_reconciled
  publicErrorCode     String?
  internalErrorDetail String?
  providerRequestId   String?
  leaseId             String?

  // v2 (policy §11): every generation is one execution attempt of a target
  // inside a comparison group. groupId is a denormalized copy of the
  // target's group for query paths; the FK chain runs through targetId.
  groupId             String
  targetId            String
  attemptNumber       Int     @default(1)
  retryOfGenerationId String?
  retryIdempotencyKey String?

  createdAt   DateTime  @default(now())
  startedAt   DateTime?
  completedAt DateTime?
  failedAt    DateTime?
  updatedAt   DateTime  @updatedAt

  user            User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversation    Conversation           @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  target          ImageGenerationTarget  @relation("TargetAttempts", fields: [targetId], references: [id], onDelete: Cascade)
  currentOfTarget ImageGenerationTarget? @relation("TargetCurrentAttempt")
  assets          ImageAsset[]

  @@unique([userId, idempotencyKey])
  @@unique([targetId, retryIdempotencyKey])
  @@index([status, updatedAt])
  @@index([conversationId, createdAt])
  @@index([groupId])
}

// One user action: a prompt fanned out to one or more image models
// (policy §11). Group state is never stored -- it derives from each
// target's current attempt (lib/imageGenerationStateCore.ts).
model ImageGenerationGroup {
  id                  String   @id @default(cuid())
  userId              String
  conversationId      String
  groupIdempotencyKey String
  createdAt           DateTime @default(now())

  user         User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversation Conversation            @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  targets      ImageGenerationTarget[]

  @@unique([userId, groupIdempotencyKey])
  @@index([conversationId, createdAt])
}

// A logical model slot inside a group. Retries append attempts under the
// same target; currentGenerationId moves to the newest attempt in the same
// transaction that creates it (policy §11 two-layer idempotency).
model ImageGenerationTarget {
  id                  String   @id @default(cuid())
  groupId             String
  provider            String
  modelId             String
  currentGenerationId String?  @unique
  createdAt           DateTime @default(now())

  group             ImageGenerationGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  generations       ImageGeneration[]    @relation("TargetAttempts")
  currentGeneration ImageGeneration?     @relation("TargetCurrentAttempt", fields: [currentGenerationId], references: [id], onDelete: SetNull)

  @@unique([groupId, modelId])
}

// A stored object derived from one generation: the untouched provider
// original (provenance metadata preserved -- never re-encoded) and the
// thumbnail derived from it. Thumbnail failure never demotes the original:
// the generation stays succeeded and the thumbnail retries in the
// background.
model ImageAsset {
  id                  String  @id @default(cuid())
  generationId        String
  role                String // original | thumbnail
  // ready | pending | failed. Originals are written as ready; thumbnails
  // start pending and repair in the background.
  status              String  @default("pending")
  r2Key               String  @unique
  mimeType            String
  width               Int
  height              Int
  byteSize            Int
  sha256              String
  provenancePreserved Boolean @default(true)
  thumbnailRetryCount Int     @default(0)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  generation ImageGeneration @relation(fields: [generationId], references: [id], onDelete: Cascade)

  @@unique([generationId, role])
  @@index([status, updatedAt])
}

// DB-first deletion tombstone for R2 objects. Deleting a conversation
// enqueues every attached asset key here in the SAME transaction that
// removes the rows, then the fifteen-minute maintenance sweep deletes the
// R2 objects idempotently and marks the row completed. R2 is never deleted
// before the database knows about it, so a partial failure retries from
// this row instead of leaving the database pointing at missing objects.
model ImageAssetCleanup {
  id          String    @id @default(cuid())
  r2Key       String    @unique
  reason      String // conversation_deleted | account_deleted | storage_rollback
  attempts    Int       @default(0)
  lastError   String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  completedAt DateTime?

  @@index([completedAt, createdAt])
}

// The financial record of one image generation, split from ImageGeneration
// on purpose (mirroring ChatCreditReservation): no conversation or
// generation foreign key, so user-initiated deletion never erases the
// pricing snapshot, the lot-level reservation payload needed for crash
// recovery (settleAddOnCredits requires per-lot entries), or the provider
// request id an audit needs. `generationId` is a plain unique string.
// Status: reserved -> settling -> settled, claimed with a conditional
// update for exactly-once settlement.
model ImageCreditReservation {
  id             String  @id // caller-supplied: image-credit-reservation:{generationId}:v1
  userId         String?
  generationId   String  @unique
  conversationId String?

  status  String  @default("reserved") // reserved | settling | settled
  outcome String? // completed | failed | cancelled

  preset  String
  quality String
  size    String

  // v2 identity snapshot (policy §12/§14): plain strings, never FKs -- this
  // financial record must survive deletion of everything it describes.
  // provider/modelId have no schema default on purpose: v2 code writes them
  // explicitly. identitySource distinguishes rows whose identity was
  // inferred by the v1 backfill from rows recorded at reservation time.
  provider       String
  modelId        String
  groupId        String?
  targetId       String?
  identitySource String  @default("recorded")

  reservedCredits            Int
  planReservedCredits        Int
  addOnReservedCredits       Int
  reservedCostMicroUsd       BigInt
  reservedFundedCostMicroUsd BigInt @default(0)
  settledCredits             Int    @default(0)
  settledCostMicroUsd        BigInt @default(0)
  settledFundedCostMicroUsd  BigInt @default(0)

  pricingVersion     String
  costSource         String
  pricingSnapshot    Json
  // AddOnCreditReservationEntry[] -- the per-lot credits and funded cost
  // reserved by reserveAddOnCredits, preserved so a reconciliation sweep
  // after a crash can refund lot by lot without the in-memory entries.
  reservationPayload Json

  providerRequestId String?
  refundedAt        DateTime?
  settledAt         DateTime?
  reconciledAt      DateTime?
  lastError         String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([userId, createdAt])
}

// Tracks a single Perplexity "sonar-deep-research" async job durably, since
// the request can run well past 30 minutes -- long enough to outlive both
// the request that submitted it and a page refresh. See lib/perplexityDeepResearch.ts
// (submit/poll HTTP calls) and app/api/chat/deep-research/status/route.ts
// (the client-polled endpoint that reads and advances this row).
model PerplexityAsyncJob {
  id                 String    @id @default(cuid())
  perplexityJobId    String    @unique
  conversationId     String
  assistantMessageId String    @unique
  modelId            String
  reservationId      String
  traceId            String
  status             String    @default("submitted") // submitted | in_progress | completed | failed
  resultText         String?
  errorMessage       String?
  submittedAt        DateTime  @default(now())
  lastPolledAt       DateTime?
  completedAt        DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([status, lastPolledAt])
  // The retention sweep's clock. `updatedAt` moves on every poll and on
  // finalization, so one column covers a finished job and one abandoned
  // mid-flight -- and without an index the sweep is a sequential scan over a
  // table that grows with every deep research request.
  @@index([updatedAt])
}

model AppSetting {
  key       String   @id
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Feedback {
  id                        String              @id @default(cuid())
  userId                    String?
  email                     String?
  type                      String
  status                    String              @default("open")
  message                   String
  traceId                   String?
  modelId                   String?
  plan                      String?
  hasAttachments            Boolean             @default(false)
  attachmentCount           Int                 @default(0)
  path                      String?
  userAgent                 String?
  /// The submitter's language, captured once at submission and never mutated,
  /// so every lifecycle email for this report renders in the same language.
  /// One of lib/language.ts SUPPORTED_LANGUAGES; "en" when unknown.
  language                  String              @default("en")
  /// Per-report transactional consent to lifecycle status emails. NOT a
  /// marketing preference: it covers only this report's received/reviewing/
  /// completed notifications. Defaults to no consent.
  emailUpdatesConsent       Boolean             @default(false)
  /// How the report was resolved -- one of FEEDBACK_CLOSURE_OUTCOMES in
  /// lib/feedbackLifecycleCore.ts. Current state for the admin console; the
  /// email renders from the immutable completed lifecycle event instead.
  closureOutcome            String?
  /// The short reply written FOR THE SUBMITTER. Never the internal admin note,
  /// and never merged with one.
  userReply                 String?
  /// Outcome of verifying the server-issued errorReportToken -- one of
  /// TOKEN_VERIFICATION_STATUS in lib/errorReportContract.ts. Never the raw
  /// token, which is verified and discarded in the same request.
  errorReportVerification   String?
  /// Where the submitted trace ID came from, as far as it can be proven:
  /// server_generated only when the token verified; otherwise the client's
  /// unauthenticated claim (or null for reports without a trace).
  traceProvenance           String?
  /// Who classified the error code the reporter attached: "server" when it
  /// came from a verified token, "client" for client-side classifications
  /// like EMPTY_RESPONSE. A client classification is never presented as a
  /// server-authenticated fact.
  errorClassificationSource String?
  /// The client-classified error code, kept separate from any server code
  /// inside the verified token payload.
  clientErrorCode           String?
  /// Whether an evidence row exists for a verified report, and if not, why
  /// not -- one of EVIDENCE_AVAILABILITY in lib/errorReportContract.ts.
  evidenceAvailability      String?
  traceEvidenceId           String?
  traceEvidence             TraceErrorEvidence? @relation(fields: [traceEvidenceId], references: [id], onDelete: SetNull)
  createdAt                 DateTime            @default(now())
  updatedAt                 DateTime            @updatedAt

  lifecycleEvents FeedbackLifecycleEvent[]
  autoFixCase     FeedbackAutoFixCase?

  @@index([status, createdAt])
  @@index([type, createdAt])
  @@index([userId, createdAt])
  @@index([traceId])
}

/// One diagnosis-only shadow-mode case per verified bug report (Phase 2 of
/// docs/policy/trace-feedback-automation.md). The case collects evidence,
/// classifies eligibility with the deterministic rules in
/// lib/feedbackAutoFixCore.ts and leaves a bounded diagnostic summary for a
/// human -- it never modifies code, never pushes a branch, never opens a PR.
/// llmConfidence is observational only and stays null in Phase 2.
model FeedbackAutoFixCase {
  id                     String    @id @default(cuid())
  feedbackId             String    @unique
  feedback               Feedback  @relation(fields: [feedbackId], references: [id], onDelete: Cascade)
  traceId                String
  /// Trusted occurrence identity from the verified token, when one existed.
  occurrenceId           String?
  /// errorCode|routeClass|release -- duplicate-spotting only, never identity.
  fingerprint            String?
  sourceRelease          String?
  /// One of AUTOFIX_CASE_STATE; transitions enforced by the core module and
  /// written with compare-and-swap conditional updates.
  state                  String    @default("received")
  /// One of AUTOFIX_CLASSIFICATION once classified.
  classification         String?
  ineligibilityReason    String?
  /// Reserved for a future LLM diagnosis pass; observational, never a gate.
  llmConfidence          Float?
  /// Bounded technical facts only -- no user text, no prompts, no tokens.
  diagnosticSummary      Json?
  attemptCount           Int       @default(0)
  claimedAt              DateTime?
  heartbeatAt            DateTime?
  /// Doubles as the not-before instant while state = evidence_delayed.
  leaseExpiresAt         DateTime?
  terminalReason         String?
  closedAt               DateTime?
  /// --- Phase 3 (null until a fix attempt runs; docs/policy §9) -----------
  /// feedback-autofix/<case-id> -- the case id, never a raw trace ID.
  fixBranch              String?
  /// The running fix attempt's server-minted id. Every heartbeat and result
  /// must present it; a claim replaces it and a reclaim or a terminal result
  /// clears it, so a late callback from an expired run matches nothing.
  fixAttemptId           String?
  fixPrNumber            Int?
  fixPrUrl               String?
  /// Read back from GitHub after the human-approved merge; never inferred
  /// from enabling auto-merge.
  mergeSha               String?
  stagingSha             String?
  /// The validated Red→Green proof payload (lib/feedbackAutoFixPolicy.ts).
  redGreenProof          Json?
  /// --- Review request (docs/policy/trace-feedback-automation.md §9.3) ------
  /// The develop PR head and its change manifest digest, read from GitHub by
  /// the server (lib/feedbackAutoFixChangeManifest.ts).
  fixHeadSha             String?
  fixManifestDigest      String?
  /// The manifest itself: path, base blob and head blob per changed file.
  fixManifest            Json?
  /// Root cause, fix and test summaries from the fix run: bounded, technical,
  /// derived only from the diagnostic summary -- never the report body.
  fixReport              Json?
  /// --- Owner approval, bound to one head and one manifest --------------------
  /// Who approved is recorded in AdminAuditLog (feedback_autofix.approved), not
  /// here: the case keeps no account identifier of its own.
  approvedAt             DateTime?
  approvedHeadSha        String?
  approvedManifestDigest String?
  /// --- Promotion: every value observed by the server itself -----------------
  stagingDeploymentId    String?
  stagingFirstSeenAt     DateTime?
  stagingVerifiedAt      DateTime?
  productionBranch       String?
  productionPrNumber     Int?
  productionPrUrl        String?
  productionPrHeadSha    String?
  productionMergeSha     String?
  productionDeploymentId String?
  productionFirstSeenAt  DateTime?
  productionVerifiedAt   DateTime?
  /// The last observer pass that read this case and why it did not advance:
  /// what the console shows as "observation delayed".
  promotionObservedAt    DateTime?
  promotionObservation   String?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  @@index([state, leaseExpiresAt])
  @@index([createdAt])
  @@index([fingerprint, sourceRelease])
}

/// Server-side evidence for one error *occurrence* on a server-generated
/// trace. The primary key and the occurrenceId are both server-minted:
/// trace IDs can be client-influenced elsewhere (proxy.ts adopts a client
/// x-request-id; preflight adopts X-Client-Request-ID), so the trace ID is
/// deliberately a non-unique index -- never an identity, never an upsert key.
/// The same trace string may own several rows; feedback links to exactly one
/// via the occurrenceId carried inside the signed errorReportToken.
///
/// Stored fields are the minimum needed for support correlation: no prompt
/// or message bodies, no raw provider payloads, no headers, no tokens.
/// Retention: 30 days, purged by lib/maintenance.ts.
model TraceErrorEvidence {
  id                   String   @id @default(cuid())
  /// Trusted per-occurrence identity minted by the server at error time.
  occurrenceId         String   @unique
  traceId              String
  /// One of TRACE_PROVENANCE in lib/errorReportContract.ts; rows are only
  /// written for server_generated traces today.
  traceProvenance      String
  environment          String
  release              String?
  routeClass           String
  phase                String?
  errorCode            String?
  /// One of ERROR_CLASSIFICATION_SOURCE; always "server" for rows written by
  /// the error builders.
  classificationSource String   @default("server")
  httpStatus           Int?
  /// Which layer raised this failure: one of CHAT_FAILURE_LAYERS in
  /// lib/chatFailureLayer.ts. Nullable for rows written before the column
  /// existed; a NULL means "not recorded", never "provider".
  ///
  /// Without it a storage 404 and a provider 404 are the same row, which is
  /// exactly the confusion that made an operator read `AI_REQUEST_FAILED.
  /// NotFound` as two providers being down.
  failureLayer         String?
  /// The status object storage answered with, when the failure was a storage
  /// one. Kept beside `httpStatus` rather than replacing it: the response the
  /// user got (410) and the answer the bucket gave (404) are different
  /// numbers and an operator needs both.
  storageStatus        Int?
  provider             String?
  modelId              String?
  retryable            Boolean?
  fingerprint          String?
  sentryEventId        String?
  occurredAt           DateTime @default(now())
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  feedback Feedback[]

  @@index([traceId])
  @@index([release, occurredAt])
  @@index([errorCode, occurredAt])
  @@index([occurredAt])
}

/// One immutable record per lifecycle stage of one feedback report.
///
/// The user-facing status email is rendered from this row, not from the
/// mutable Feedback columns, so a retried delivery presents byte-for-byte the
/// payload the first attempt presented -- which the provider's idempotency key
/// requires. Rows are only ever inserted; the unique constraint is what makes
/// "one email per stage" hold under concurrent admin requests.
model FeedbackLifecycleEvent {
  id             String   @id @default(cuid())
  feedbackId     String
  feedback       Feedback @relation(fields: [feedbackId], references: [id], onDelete: Cascade)
  /// received | reviewing | completed
  stage          String
  previousStatus String?
  newStatus      String
  /// Set on the completed stage only -- one of FEEDBACK_CLOSURE_OUTCOMES.
  outcomeCode    String?
  /// Snapshot of the user-facing reply at closure time. Never the admin note.
  userReply      String?
  /// The admin who made the transition; null for the submission itself.
  actorUserId    String?
  createdAt      DateTime @default(now())

  /// One event -- and therefore at most one user email -- per stage.
  @@unique([feedbackId, stage])
  @@index([feedbackId, createdAt])
}

/// An operator notification that still owes a delivery.
///
/// Written in the same transaction as the record it describes, so a submission
/// that reached the database can never lose its notification to a crash, a
/// provider outage or a missing API key. The body is deliberately NOT stored
/// here: `kind` + `referenceId` point at the source row and the mail is
/// re-rendered at send time, so the reporter's words live in exactly one table
/// and one retention policy.
model NotificationDelivery {
  id            String    @id @default(cuid())
  /// Which notification this is; selects the renderer. e.g. "support_feedback".
  kind          String
  /// The source row this notification describes. e.g. Feedback.id
  referenceId   String
  /// pending | delivered | abandoned
  status        String    @default("pending")
  attempts      Int       @default(0)
  nextAttemptAt DateTime  @default(now())
  lastAttemptAt DateTime?
  /// A short classification such as "http_502" -- never a provider response body.
  lastErrorKind String?
  deliveredAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  /// One queue row per source record: re-submitting the same feedback cannot
  /// enqueue a second notification.
  @@unique([kind, referenceId])
  @@index([status, nextAttemptAt])
  @@index([status, createdAt])
}

model RefundRequest {
  id                           String                       @id @default(cuid())
  userId                       String?
  user                         User?                        @relation(fields: [userId], references: [id], onDelete: SetNull)
  email                        String?
  plan                         String?
  stripeCustomerId             String?
  stripeSubscriptionId         String?
  subscriptionStatus           String?
  subscriptionCurrentPeriodEnd DateTime?
  subscriptionBillingInterval  String?
  reason                       String?
  /// pending | processing | approved | rejected
  ///
  /// `processing` is claimed before the Stripe refund is created and released
  /// or completed after it. It is what makes the money side recoverable: a
  /// crash between Stripe and the local commit leaves the row here rather than
  /// back in `pending`, where a retry would issue a second refund.
  status                       String                       @default("pending")
  /// When the row entered `processing`. Reconciliation only looks at rows that
  /// have been there longer than one request could reasonably take.
  processingStartedAt          DateTime?
  adminNote                    String?
  reviewedByUserId             String?
  stripeRefundId               String?
  stripeRefundStatus           String?
  stripeChargeId               String?
  refundAmountCents            Int?
  refundCurrency               String?
  requestedAt                  DateTime                     @default(now())
  reviewedAt                   DateTime?
  updatedAt                    DateTime                     @updatedAt
  timelineEvents               RefundRequestTimelineEvent[]

  @@index([status, processingStartedAt])
  @@index([status, requestedAt])
  @@index([userId, requestedAt])
  @@index([email])
}

model RefundRequestTimelineEvent {
  id              String        @id @default(cuid())
  refundRequestId String
  refundRequest   RefundRequest @relation(fields: [refundRequestId], references: [id], onDelete: Cascade)
  actorUserId     String?
  actorEmail      String?
  eventType       String
  message         String
  metadata        Json?
  createdAt       DateTime      @default(now())

  @@index([refundRequestId, createdAt])
  @@index([eventType, createdAt])
}

model AdminAuditLog {
  id           String   @id @default(cuid())
  actorUserId  String?
  actorEmail   String?
  action       String
  targetType   String
  targetId     String?
  summary      String
  metadata     Json?
  ipAddress    String?
  userAgent    String?
  previousHash String?
  entryHash    String?  @unique
  createdAt    DateTime @default(now())

  amuxReviewDecision AmuxReviewDecision?

  /// No actor relation on purpose: see
  /// migrations/20260826070000_admin_audit_actor_not_a_foreign_key.
  /// `actorUserId` is part of this row's HMAC input, so a foreign-key action
  /// rewriting it makes an audit entry indistinguishable from a forged one --
  /// which is what ON DELETE SET NULL did to eight rows on staging. The
  /// column records who acted at the time; it is not a pointer to a row that
  /// still exists.

  @@index([action, createdAt])
  @@index([targetType, targetId])
  @@index([actorUserId, createdAt])
  @@index([createdAt, entryHash])
}

model AdminActionApproval {
  id               String    @id @default(cuid())
  action           String
  targetType       String
  targetId         String?
  status           String    @default("pending")
  reason           String?
  payload          Json?
  payloadHash      String
  requestedById    String?
  requestedByEmail String?
  reviewedById     String?
  reviewedByEmail  String?
  reviewedAt       DateTime?
  expiresAt        DateTime
  consumedAt       DateTime?
  consumedById     String?
  consumedByEmail  String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([status, createdAt])
  @@index([status, expiresAt])
  @@index([payloadHash])
  @@index([action, createdAt])
  @@index([targetType, targetId])
}

model AdminNote {
  id             String   @id @default(cuid())
  targetType     String
  targetId       String
  body           String
  createdById    String?
  createdBy      User?    @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdByEmail String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([targetType, targetId, createdAt])
  @@index([createdById, createdAt])
}

model ModelOverride {
  modelId        String   @id
  status         String
  reason         String?
  visibleNote    String?
  updatedById    String?
  updatedBy      User?    @relation(fields: [updatedById], references: [id], onDelete: SetNull)
  updatedByEmail String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([status])
}

/// Database-backed source of truth for AI models. Rows are retired instead of
/// physically removed so historical conversations can still resolve model IDs.
model ModelRegistryEntry {
  id                         String   @id
  name                       String
  apiModel                   String
  provider                   String
  apiBaseUrl                 String
  apiKeyEnvName              String
  icon                       String   @default("")
  bestFor                    String   @default("")
  minimumPlan                String
  usageClass                 String
  creditWeight               Int
  publiclyListed             Boolean  @default(true)
  enabled                    Boolean  @default(true)
  status                     String   @default("enabled")
  operationalReason          String?
  userVisibleNote            String?
  replacementModelId         String?
  catalogDeleted             Boolean  @default(false)
  reasoning                  String?
  contextWindowTokens        Int?
  supportsImage              Boolean  @default(false)
  supportsNativePdf          Boolean  @default(false)
  maxImages                  Int?
  maxBase64ImagePayloadBytes Int?
  maxOutputTokens            Int?
  reservationOutputTokens    Int?
  inputUsdPerMillionTokens   Float?
  outputUsdPerMillionTokens  Float?
  cachedInputPriceMultiplier Float?
  sortOrder                  Int      @default(0)
  updatedById                String?
  updatedByEmail             String?
  createdAt                  DateTime @default(now())
  updatedAt                  DateTime @updatedAt

  @@index([provider, sortOrder])
  @@index([status, catalogDeleted])
  @@index([publiclyListed, enabled, catalogDeleted])
}

/// Latest model-catalog observation for a provider/model pair. A missing model
/// is never treated as definitively deprecated after a single failed lookup;
/// consecutive successful catalog scans are required.
model ProviderModelCatalogEntry {
  id                 String    @id @default(cuid())
  provider           String
  apiModel           String
  modelRegistryId    String?
  displayName        String?
  status             String    @default("candidate")
  firstSeenAt        DateTime?
  lastSeenAt         DateTime?
  lastCheckedAt      DateTime
  missingSinceAt     DateTime?
  consecutiveSeen    Int       @default(0)
  consecutiveMissing Int       @default(0)
  lifecycle          String?
  metadata           Json?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@unique([provider, apiModel])
  @@index([provider, status, updatedAt])
  @@index([modelRegistryId])
  @@index([status, lastCheckedAt])
}

/// What a provider's own documentation said about one model, read after the
/// daily catalogue scan: evidence for the adoption form, with where it came
/// from. Never a price source -- lib/modelPricing.ts is -- and nothing on the
/// request path reads it. One row per exact (provider, apiModel), overwritten
/// by each read.
model ProviderModelDocEvidence {
  id            String   @id @default(cuid())
  provider      String
  apiModel      String
  /// parsed | not_found | fetch_failed | parse_failed
  status        String
  /// [{ url, digest }] -- every document the parse read, with a SHA-256 of its body.
  sources       Json
  parserVersion String
  fields        Json?
  problems      Json
  fetchedAt     DateTime
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([provider, apiModel])
  @@index([status, fetchedAt])
}

/// Immutable summary of each provider catalog request. This makes daily
/// monitoring auditable and distinguishes provider/API failures from absence.
model ProviderModelCatalogRun {
  id              String    @id @default(cuid())
  provider        String
  status          String
  discoveredCount Int       @default(0)
  mappedCount     Int       @default(0)
  candidateCount  Int       @default(0)
  missingCount    Int       @default(0)
  lifecycleCount  Int       @default(0)
  errorCode       String?
  errorDetail     String?
  startedAt       DateTime  @default(now())
  completedAt     DateTime?
  createdAt       DateTime  @default(now())

  @@index([provider, startedAt])
  @@index([status, startedAt])
}

/// What we decided to do about a model a provider listed, and how far that has
/// got. Separate from ProviderModelCatalogEntry on purpose.
///
/// The catalogue entry is an observation and the monitor overwrites its
/// `status` on every scan, so a decision recorded there is erased by the next
/// run. This is the other half: written by discovery, changed only by a person,
/// and never re-derived from today's scan.
///
/// The unique key is (provider, apiModel, action) rather than the model alone:
/// adding a model and later retiring it are two decisions at two times, but two
/// open "add"s for one model is a duplicate.
model ModelLifecycleWorkItem {
  id       String @id @default(cuid())
  provider String
  apiModel String

  /// The mapped ModelRegistryEntry, once one exists.
  modelId        String?
  /// The observation this came from. Not a foreign key: the catalogue row is
  /// upserted every scan and may be swept, while the decision outlives it.
  catalogEntryId String?

  /// add | upgrade | replace | retire | monitor | no_action
  action   String
  /// The eleven states in lib/modelLifecycleWorkItemCore.ts.
  status   String @default("discovered")
  /// critical | high | normal
  severity String @default("normal")

  predecessorModelId String?
  replacementModelId String?

  /// The automatic suggestion, which a person may overwrite. Never a decision.
  recommendation String?
  /// high | medium | low, for the suggestion above.
  confidence     String?

  /// Observation evidence: lifecycle strings, consecutive-miss counts, run ids.
  evidence           Json?
  /// Facts still needed before this can be decided.
  unknowns           Json?
  /// Named things being waited on, in the sense report-issue-backlog uses:
  /// something the repository cannot answer by itself.
  blockers           Json?
  /// Verifications owed before rollout, e.g. ["pricing","access","staging"].
  /// One list rather than three states because they run in parallel.
  pendingValidations Json?

  reviewerId     String?
  reviewerEmail  String?
  /// approve | reject | defer
  decision       String?
  decisionReason String?
  decidedAt      DateTime?

  ownerEmail    String?
  dueAt         DateTime?
  deferredUntil DateTime?

  linkedIssueUrl     String?
  linkedPrUrl        String?
  linkedDeploymentId String?

  implementationEvidence Json?
  validationEvidence     Json?

  /// Whether users have to be told before this closes. A retirement that moves
  /// somebody's stored model owes a notice; an addition does not.
  communicationRequired Boolean @default(false)

  firstSeenAt DateTime  @default(now())
  completedAt DateTime?
  closedAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  events ModelLifecycleWorkItemEvent[]

  @@unique([provider, apiModel, action])
  @@index([status, severity, firstSeenAt])
  @@index([ownerEmail, dueAt])
  @@index([modelId])
}

/// Append-only history of one work item. Never updated, never deleted.
///
/// The item says what is true now; this says how it got there and who moved it.
/// A queue whose decisions can be edited without a trace cannot answer "why is
/// this model not in the catalogue", which is the question the audit could not
/// answer for seven models.
model ModelLifecycleWorkItemEvent {
  id         String                 @id @default(cuid())
  workItemId String
  workItem   ModelLifecycleWorkItem @relation(fields: [workItemId], references: [id], onDelete: Cascade)

  occurredAt DateTime @default(now())
  /// Null only for the automatic creation event; every other row names a person.
  actorEmail String?
  fromStatus String?
  toStatus   String
  note       String?
  evidence   Json?

  /// adopt | exclude | reopen, on an event that records an operator decision.
  /// Null on the steps between decisions and on the automatic creation event.
  decision         String?
  /// The exclusion reason chosen from WORK_ITEM_EXCLUSION_REASONS. Only on an
  /// exclude, and required there.
  reasonCode       String?
  /// What the operator wrote. Required for a reopen and for reasonCode "other".
  operatorReason   String?
  /// The queue's automatic analysis as the operator saw it at the decision.
  /// Kept apart from operatorReason so a suggestion is never recorded as the
  /// reason a person gave.
  analysisSnapshot String?

  @@index([workItemId, occurredAt])
}

/// What an approved retirement reconciliation actually changed, per user and
/// per field. Append-only.
///
/// Without this a completion notice has no audience. The script reported
/// aggregate counts to stdout and nothing else, so "we changed your default
/// model" could only be sent to everybody or to nobody -- and both are wrong in
/// a way that cannot be taken back once the mail has gone.
///
/// It is also the only thing that can answer a support question afterwards:
/// what did this account hold before, and when did we change it.
model ModelMigrationRecord {
  id     String @id @default(cuid())
  userId String
  /// Cascades: the record exists to address a notice to this person and to
  /// answer what their setting held before. Both questions die with the
  /// account, so keeping the row afterwards would be keeping a user id for no
  /// purpose. The aggregate ("this retirement moved N accounts") belongs to the
  /// campaign, not to a row per person.
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Set when the change was to one conversation rather than to the account.
  conversationId String?

  /// The lifecycle item this ran for, when there is one.
  workItemId String?

  /// user_settings_default_model | new_conversation_model_ids
  ///   | conversation_selected_models | app_setting_guest_default
  field String

  fromModelId String
  toModelId   String

  /// The approval the run carried: the ticket and the person who ran it.
  ticket     String
  actorEmail String

  changedAt DateTime @default(now())

  @@index([userId, changedAt])
  @@index([fromModelId, toModelId, changedAt])
  @@index([workItemId])
}

