/// A Pro <-> Max plan change: the quote we showed, and the reservation it
/// became. lib/planChangeStateMachine.ts owns every transition; this table only
/// remembers them.
///
/// The row exists from the moment a quote is produced, because a confirm must
/// prove it is executing the quote the customer saw -- `fingerprint` is every
/// subscription fact the amount depended on, and a confirm against a moved
/// subscription is refused rather than charged.
model PlanChangeRequest {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  direction       String // "upgrade" | "downgrade"
  execution       String // "immediate_upgrade" | "scheduled_downgrade"
  fromTier        String
  toTier          String
  billingInterval String // "monthly" | "annual"
  currency        String

  stripeSubscriptionId     String
  stripeSubscriptionItemId String
  targetStripePriceId      String

  fingerprint     String
  /// "unaffected" | "cancellation_preserved" | "cancellation_cleared_by_explicit_consent"
  renewalDecision String

  /// What the customer was quoted, in the subscription's currency. Kept so
  /// support can answer "how much was I told this would cost".
  quotedAmountMinor Int?

  /// "previewed" | "pending" | "applied" | "cancelled" | "expired" | "failed"
  status           String    @default("previewed")

  /// Carries `userId` exactly while `status = "pending"`, and null otherwise.
  ///
  /// This is what makes "one change in flight per account" a database
  /// guarantee rather than an application check two racing confirms can both
  /// pass. The natural way to write it is a partial unique index over
  /// (userId) WHERE status = 'pending' -- but `prisma db push` builds a
  /// database from this schema alone and never runs migration SQL, so a
  /// constraint that lives only in a migration is absent from every db-push
  /// environment, including the one the integration tests run against. A
  /// nullable column with a plain unique index says the same thing in a form
  /// both paths create: Postgres does not compare nulls, so any number of
  /// settled rows coexist while at most one pending row can exist per account.
  pendingForUserId String?   @unique
  appliesAt        DateTime?
  stripeScheduleId String?
  confirmedAt      DateTime?
  settledAt        DateTime?
  failureCode      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, status])
  @@index([stripeSubscriptionId, status])
  @@index([status, createdAt])
}

