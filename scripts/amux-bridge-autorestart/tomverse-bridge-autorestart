#!/bin/bash
# Restarts an AMUX execution bridge that halted for a reason known to have
# left nothing behind.
#
# docs/ops/amux/bridge-monitoring.md §5 is the runbook. A systemd timer runs
# this every two minutes. A bridge halts with exit 3 and systemd deliberately
# does not restart it (RestartPreventExitStatus=3): an unknown outcome stops
# and waits for a person. The operator approved a narrow exception on
# 2026-10-14, after a day of halts that waited hours for a restart nobody
# needed to judge:
#
#   cause=worker_runtime_lease_lost      the app had already dropped the
#                                        runtime; a restart registers a new one
#   cause=tick_failed_<class>            only when the same run logged that the
#                                        failed tick had committed 0 results
#
# Every other cause -- dispatch_outcome_unknown, settle_outcome_unknown,
# pending_session_missing, a tick that had committed results, a halt line
# that cannot be read -- stays halted and is reported by the existing alerts.
# There is no restart count limit (operator decision, 2026-10-14).
#
# The final cause alone is not enough. The bridge keeps only the first cause
# (note_halt), and it may go on settling earlier work after halting; an
# outcome that becomes unknown then does not change it, and some such paths
# print nothing else. So the bridge prints every cause it notes
# ("amux wsl bridge halt noted: cause=<cause>"), and a run restarts only when
#
#   - every noted cause is an approved one, and the halt line names the first;
#   - every other line is one this script knows to be harmless.
#
# A bridge binary built before it printed noted causes leaves none, and its
# halts are held: there is no way to tell what else it noted.
#
# A bridge exits 3 only once nothing it dispatched is still pending
# (apps/tomverse-orchestrator/src/wsl_bridge.rs, `halted && pending_count == 0`).
#
# A restart also needs the local AMUX server and the Tomverse app to answer;
# otherwise this run leaves the bridge for the next one.
#
# Runs as its own system account. A polkit rule installed with it lets that
# account restart the bridge units and nothing else; it reads their journal
# through the systemd-journal group the unit grants it.
#
# The bridge units are the loaded tomverse-amux-bridge@ instances (orchestration
# policy version 55: one bridge per worker, started with --worker). The older
# tomverse-bridge.service and tomverse-amux-v22-bridge@ units were removed from
# the host in stage S4 and are neither looked for nor restarted. A --worker
# bridge's own lines about its scope end in "not halted", so they are harmless
# below.
set -euo pipefail

unit_patterns=('tomverse-amux-bridge@*.service')
unit_name='^tomverse-amux-bridge@[A-Za-z0-9_.-]+\.service$'
amux_health=https://127.0.0.1:8824/health
app_health=https://tomverse.app/api/health

log() { echo "tomverse-bridge-autorestart: $*"; }

# The lines a halted run may contain and still be restarted, as
# wsl_bridge.rs prints them. Everything else holds the bridge.
halt_line='^amux wsl bridge halted: no new assignments; cause=([a-z0-9_]+); restart only after checking Tomverse and the local AMUX$'
noted_line='^amux wsl bridge halt noted: cause=([a-z0-9_]+)$'
nothing_committed='^amux wsl bridge warn: tick failed \([a-z0-9_]+\) after 0 result\(s\) already committed this tick; recording them before halting$'
harmless=(
  # A warning the bridge itself declares harmless ends with "not halted".
  '^amux wsl bridge warn: .*[;,] not halted$'
  '^amux wsl bridge warn: worker register answered 503 amux_database_busy; registering again next tick$'
  '^amux v[0-9]+ quota source unavailable for [A-Za-z0-9_.-]+$'
  '^amux v[0-9]+ quota observation recorded for [A-Za-z0-9_.-]+$'
)

approved() {
  [[ "$1" == worker_runtime_lease_lost || "$1" == tick_failed_* ]]
}

# Prints "restart" or "hold <reason>" for one failed run's journal lines.
decide() {
  local lines=$1 cause="" first="" halts=0 noted=0 ticks=0 tick_causes=0 line pattern known
  while IFS= read -r line; do
    [[ -z "$line" ]] && continue
    if [[ "$line" =~ $halt_line ]]; then
      cause=${BASH_REMATCH[1]}
      halts=$((halts + 1))
      continue
    fi
    if [[ "$line" =~ $noted_line ]]; then
      noted=$((noted + 1))
      [[ -z "$first" ]] && first=${BASH_REMATCH[1]}
      if ! approved "${BASH_REMATCH[1]}"; then
        echo "hold cause=${BASH_REMATCH[1]} was noted and is not restarted automatically"
        return
      fi
      [[ "${BASH_REMATCH[1]}" == tick_failed_* ]] && tick_causes=$((tick_causes + 1))
      continue
    fi
    if [[ "$line" =~ $nothing_committed ]]; then
      ticks=$((ticks + 1))
      continue
    fi
    known=no
    for pattern in "${harmless[@]}"; do
      [[ "$line" =~ $pattern ]] && known=yes && break
    done
    if [[ "$known" != yes ]]; then
      echo "hold an unrecognised line in the halted run: ${line:0:160}"
      return
    fi
  done <<<"$lines"
  if ((halts != 1)); then
    echo "hold $halts halt lines in the halted run"
  elif ! approved "$cause"; then
    echo "hold cause=$cause is not restarted automatically"
  elif ((noted == 0)); then
    echo "hold no noted causes (a bridge binary that predates them)"
  elif [[ "$first" != "$cause" ]]; then
    echo "hold the halt line names $cause but the first noted cause is $first"
  elif ((tick_causes > ticks)); then
    echo "hold cause=tick_failed_* without a tick that committed nothing"
  else
    echo restart
  fi
}

answers() {
  curl --silent --show-error --fail --max-time 5 --output /dev/null "$@" 2>/dev/null
}

# A listing that cannot be read leaves the bridge units unknown: this run
# restarts nothing and only logs it.
units=()
if listing=$(systemctl list-units --all --plain --no-legend --type=service "${unit_patterns[@]}" 2>&1); then
  while read -r name _; do
    [[ "$name" =~ $unit_name ]] && units+=("$name")
  done <<<"$listing"
else
  log "the bridge instance list is unreadable (systemctl: ${listing%%$'\n'*}); no restart this run"
  exit 0
fi

halted=()
for unit in "${units[@]}"; do
  state=$(systemctl show -p ActiveState --value "$unit" 2>/dev/null || true)
  status=$(systemctl show -p ExecMainStatus --value "$unit" 2>/dev/null || true)
  [[ "$state" == failed && "$status" == 3 ]] && halted+=("$unit")
done

if ((${#halted[@]} == 0)); then
  exit 0
fi

# The local AMUX server's own certificate is self-signed; the unit's start
# check reads it the same way.
if ! answers --insecure "$amux_health"; then
  log "${#halted[@]} halted; the local AMUX server does not answer, no restart this run"
  exit 0
fi
if ! answers --proto '=https' "$app_health"; then
  log "${#halted[@]} halted; the Tomverse app does not answer, no restart this run"
  exit 0
fi

# The unit's halted run, as one line: "<ActiveState> <ExecMainStatus> <id>".
halted_run() {
  printf '%s %s %s' \
    "$(systemctl show -p ActiveState --value "$1" 2>/dev/null || true)" \
    "$(systemctl show -p ExecMainStatus --value "$1" 2>/dev/null || true)" \
    "$(systemctl show -p InvocationID --value "$1" 2>/dev/null || true)"
}

for unit in "${halted[@]}"; do
  invocation=$(systemctl show -p InvocationID --value "$unit" 2>/dev/null || true)
  if [[ ! "$invocation" =~ ^[0-9a-f]{32}$ ]]; then
    log "$unit halted; its run is unreadable (no invocation id), left halted"
    continue
  fi
  lines=$(journalctl "_SYSTEMD_INVOCATION_ID=$invocation" --no-pager -q -o cat 2>/dev/null || true)
  read -r verdict reason <<<"$(decide "$lines")"
  if [[ "$verdict" != restart ]]; then
    log "$unit halted; $reason, left halted"
    continue
  fi
  cause=$(grep -oE 'cause=[a-z0-9_]+' <<<"$lines" | tail -n 1)
  # Read again right before the restart: if a person restarted or stopped the
  # unit while this run was checking, the run judged above is no longer the
  # unit's, and restarting would interrupt the new one.
  if [[ "$(halted_run "$unit")" != "failed 3 $invocation" ]]; then
    log "$unit changed while it was being checked; left alone"
    continue
  fi
  if systemctl restart --no-block "$unit"; then
    log "$unit halted with $cause; restarted"
  else
    log "$unit halted with $cause; the restart was refused" >&2
  fi
done
