# Both switches must be exactly enabled (the earlier true is read the same).
# The shipped defaults are inert.
TOMVERSE_AMUX_V22_TASK_RECOVERY_ENABLED=disabled
TOMVERSE_AMUX_V22_LEGACY_SAFE_STOP_ENABLED=disabled
TOMVERSE_INTERNAL_URL=https://replace-with-internal-origin.example/
TOMVERSE_AMUX_V22_RECOVERY_CONTROLLER_SECRET=replace-with-dedicated-controller-secret
