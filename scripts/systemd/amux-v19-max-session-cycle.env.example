# Installed disabled. Fill the launcher secret locally only.
# No DATABASE_URL, provider key or app content-encryption key belongs here;
# the Max CLI authenticates with its own OAuth file, never with this file.
TOMVERSE_AMUX_V19_MAX_SESSION_CYCLE=disabled
TOMVERSE_AMUX_V19_TRACKED_CHECKOUT_CLI=disabled
TOMVERSE_AMUX_V19_SESSION_ANALYSIS_APP_ORIGIN=https://staging.tomverse.app/
TOMVERSE_AMUX_V19_TRACKED_REPOSITORY_ROOT=/home/tommy/.local/share/tomverse-amux-v19/mirrors
# TOMVERSE_AMUX_V19_MAX_LAUNCHER_SECRET=
