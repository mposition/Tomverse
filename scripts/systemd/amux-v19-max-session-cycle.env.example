# Installed disabled. Fill the launcher secret locally only.
# No DATABASE_URL, provider key or app content-encryption key belongs here;
# the Max CLI authenticates with its own OAuth file, never with this file.
TOMVERSE_AMUX_V19_MAX_SESSION_CYCLE=disabled
TOMVERSE_AMUX_V19_TRACKED_CHECKOUT_CLI=disabled
TOMVERSE_AMUX_V19_SESSION_ANALYSIS_APP_ORIGIN=https://staging.tomverse.app/
TOMVERSE_AMUX_V19_TRACKED_REPOSITORY_ROOT=/home/tommy/.local/share/tomverse-amux-v19/mirrors
# TOMVERSE_AMUX_V19_MAX_LAUNCHER_SECRET=
# Diagnostic detail, default off. Uncomment to `enabled` only while finding out
# why a real analysis was rejected. When a failed analysis was refused by the
# stream parser or the open trace, the runner writes the names behind the
# refusal (an unknown event subtype and its key names, checkout-relative paths
# outside the read manifest, open flags) to one 0600 file
# ~/.local/state/tomverse-amux-v19-max-analysis/diagnostic-<UTC>.json and keeps
# the newest ten. The file stays on this machine: it is never sent to the app,
# and the status line only gains detail=written or detail=unwritten. It holds
# no event text, model output, prompt, token or credential.
# TOMVERSE_AMUX_V19_DIAGNOSTIC_DETAIL=enabled
