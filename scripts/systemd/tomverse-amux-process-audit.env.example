# ~/.config/tomverse-amux-process-audit/runner.env, mode 600. Fill locally only.
# No DATABASE_URL and no provider key belongs here: the Codex CLI signs in with
# its own login, and the app's figures arrive over the internal route.
AMUX_PROCESS_AUDIT_APP_URL=https://tomverse.app
# The same value as the app's AMUX_PROCESS_AUDIT_SECRET (32+ characters).
AMUX_PROCESS_AUDIT_SECRET=
# The CLI. Its real path's release directory is the only part of the home
# directory the model's commands may read; this file is not.
AMUX_PROCESS_AUDIT_CODEX_BIN=/home/tommy/.local/bin/codex
# Optional: a Codex model id from the box's model cache. Unset: the CLI's default.
# AMUX_PROCESS_AUDIT_MODEL=
