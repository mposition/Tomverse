[Unit]
Description=Tomverse AMUX v19 session analysis (one cycle)
After=network-online.target
Wants=network-online.target
ConditionFileNotEmpty=%h/.local/lib/tomverse-amux-v19/max-session-cycle.mjs

[Service]
Type=oneshot
EnvironmentFile=%h/.config/tomverse-amux-v19/max-session.env
# Bring every tracked mirror up to its remote before any claim. A failed
# fetch stops the unit here, so no budget is claimed for a pin the local
# mirror cannot check out.
ExecStartPre=/bin/bash %h/.local/lib/tomverse-amux-v19/refresh-tracked-mirrors.sh
ExecStart=/usr/bin/node %h/.local/lib/tomverse-amux-v19/max-session-cycle.mjs
WorkingDirectory=%h
# The subscription analysis has no deadline: only the operator's stop ends a
# long call, and an unreachable app is waited for, not a reason to stop.
TimeoutStartSec=infinity
KillMode=control-group
UMask=0077
NoNewPrivileges=true
StandardOutput=journal
StandardError=journal
SyslogIdentifier=amux-v19-max-session-cycle

# An attempt that ends without a result reports its claim's outcome unknown;
# the app closes a subscription claim at zero and queues the idea again after
# a wait. A local marker left by an unconfirmed report names its claim, and
# the next tick reconciles that claim before any new one. Nothing waits for
# the operator.
