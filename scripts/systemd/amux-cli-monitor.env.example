# Dedicated ingest-only secret, independent of the worker and bridge secrets.
# Use the same two values on the Tomverse app. Disabled by default.
TOMVERSE_AMUX_CLI_MONITOR=0
TOMVERSE_AMUX_CLI_MONITOR_SECRET=
TOMVERSE_INTERNAL_URL=https://your-tomverse-host.example
# Collector only: base64 of the public AMUX certificate, provisioned by the operator.
# TLS chain and hostname checks remain enabled. Never put a private key here.
TOMVERSE_AMUX_CLI_MONITOR_SOURCE_CA_B64=
# Collector only: explicit comma-separated resident names. Defaults to codex-impl.
# Expand only after the app release is live. Unknown names and duplicates fail closed.
TOMVERSE_AMUX_CLI_MONITOR_WORKERS=codex-impl
