# ~/.config/tomverse-amux-v22/claude-login-keepalive.env (operator user, mode 0600)
# The installed stage-auth bundle (the same file tomverse-amux-v22-auth-stage.service runs).
AMUX_V22_STAGE_AUTH_SCRIPT=/opt/tomverse-amux-v22/stage-auth-a73e3b135.mjs
# The Claude workers whose copies are restaged right after a refresh.
AMUX_V22_CLAUDE_WORKERS=claude-chore claude-contract claude-impl claude-review
# Optional: the operator's Claude CLI (default ~/.local/bin/claude).
# AMUX_V22_CLAUDE_BIN=
