# Copy to read-only-api@<existing-worker>.env only after separate approval.
# The shipped values are inert and contain no provider credential.
TOMVERSE_AMUX_V22_READ_ONLY_API_EXECUTOR_ENABLED=false
TOMVERSE_AMUX_V22_READ_ONLY_API_OPERATIONAL_GATES=false
TOMVERSE_AMUX_V22_READ_ONLY_API_CREDENTIAL_DEDICATED=false
TOMVERSE_AMUX_V22_READ_ONLY_API_SOURCE_REVISION=replace-with-approved-full-commit
TOMVERSE_AMUX_V22_READ_ONLY_API_ALLOWED_PREFIXES_JSON='["replace-with-approved-prefix"]'
TOMVERSE_AMUX_V22_READ_ONLY_API_EXECUTION_FRAME_JSON='{"replace":"with-server-approved-frame"}'
TOMVERSE_AMUX_V22_READ_ONLY_API_KEY_FILE=/etc/tomverse-amux-v22/read-only-api/replace-with-approved-profile.key
TOMVERSE_AMUX_V22_READ_ONLY_API_CREDENTIAL_PROFILE_FILE=/etc/tomverse-amux-v22/read-only-api/replace-with-approved-profile.profile.json
