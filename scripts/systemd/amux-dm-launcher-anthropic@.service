[Unit]
Description=Tomverse AMUX Decision Maker launcher, decision-maker-anthropic (one request per connection)
ConditionFileNotEmpty=/opt/tomverse-amux-dm/launcher.mjs

[Service]
Type=simple
User=amux-dm-anthropic
Group=amux-dm-anthropic
ExecStart=/usr/bin/node /opt/tomverse-amux-dm/launcher.mjs decision-maker-anthropic
StandardInput=socket
StandardOutput=journal
StandardError=journal
SyslogIdentifier=amux-dm-launcher-anthropic
Restart=no
# docs/policy/amux-decision-maker.md §5 "hard timeout": the launcher kills the
# CLI's process group at two hours; this unit's control group is the
# backstop -- everything in it is stopped at two hours and two minutes, and on
# any exit of the launcher, so no CLI process outlives its request.
KillMode=control-group
RuntimeMaxSec=122min
TimeoutStopSec=10s
UMask=0077
# §5: the vendor account writes only its own home (CLI state, its temporary
# directories, the work directory where the DM runs commands); the request
# directory is read-only to it by mode as well.
ProtectSystem=strict
ReadWritePaths=/home/amux-dm-anthropic
PrivateTmp=true
NoNewPrivileges=true
CapabilityBoundingSet=
ProtectProc=invisible
ProtectControlGroups=true
ProtectKernelModules=true
# No ProtectKernelTunables=: its read-only binds over /proc/sys make the
# kernel refuse the fresh /proc of the DM command jail's own pid namespace
# (lib/amux/decisionMakerWorkCopy.ts), which Next's type generation needs. The
# account is not root and holds no capability, so it cannot write a tunable.
RestrictSUIDSGID=true
LockPersonality=true

# No [Install]: amux-dm-launcher-anthropic.socket starts one per connection.
