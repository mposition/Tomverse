[Unit]
Description=Tomverse AMUX bridge watchdog (dead-man signal)
Documentation=https://github.com/mposition/Tomverse/blob/develop/docs/ops/amux/bridge-monitoring.md
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
# A system account of its own, created by install.sh: no login, no home, no
# group but its own, and not the worker account. The ping URL is a credential
# only this service can read.
#
# Not DynamicUser=: the host's system bus drops a dynamic user's connection, so
# every systemctl call failed with "Transport endpoint is not connected" and
# no state could be read (first install, 2026-10-12).
User=tomverse-bridge-watchdog
Group=tomverse-bridge-watchdog
RemoveIPC=yes
LoadCredential=ping-url:/etc/tomverse-bridge-watchdog/ping-url
ExecStart=/usr/local/libexec/tomverse-bridge-watchdog
TimeoutStartSec=90
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
RestrictRealtime=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native
UMask=0077
