{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./*"],
      // The workspace symlink under node_modules resolves this at runtime;
      // this entry is what makes `tsc` and the editor read the package's
      // TypeScript source rather than a build output it does not have. The
      // package is published to nothing and built by nothing -- consumers
      // compile it themselves (`transpilePackages` in next.config.ts).
      "@tomverse/chat-core": ["./packages/chat-core/src/index.ts"],
      "@tomverse/router-core": ["./packages/router-core/src/index.ts"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts"
  ],
  // apps/mobile compiles against its own tsconfig (a DOM lib, vite/client
  // types, no `@/*` alias reaching into this app). Leaving it in this project
  // would type-check the Capacitor shell with the Next.js app's settings, which
  // is the coupling apps/mobile exists to stay out of.
  // .railway/railway.ts imports the Railway SDK, which lives in its own
  // .railway/node_modules and is installed only by an operator about to plan
  // (npm run railway:iac:install). The data table beside it stays checked.
  "exclude": ["node_modules", "apps", ".railway/railway.ts", ".railway/node_modules"]
}
